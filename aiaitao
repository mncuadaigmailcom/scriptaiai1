    local wall = Instance.new("Part")
    wall.Name = config.Name or "Wall_" .. (#Walls + 1)
    wall.Size = Vector3.new(config.Length or 15, config.Height or 10, config.Thickness or 1)
    wall.CFrame = root.CFrame * CFrame.new(0, (config.Height / 2) - 3, -(config.Thickness / 2 + 4))
    wall.Anchored = true
    wall.CanCollide = config.CanCollide ~= false
    wall.Material = Enum.Material.Glass
    wall.Transparency = config.Transparency or 0.5
    wall.Color = config.Color or Theme.AccentCyan
    wall.Parent = Services.Workspace
    
    table.insert(Walls, wall)
    return wall
end

function WallCreator:RemoveAll()
    for _, wall in ipairs(Walls) do
        wall:Destroy()
    end
    Walls = {}
end

