--- Visual Pillar Logic ---
local function updateHeightVisual()
    if not showHeightVisual then
        clearHeightVisual()
        return
    end

    if not heightVisualPart then
        heightVisualPart = Instance.new("Part")
        heightVisualPart.Name = "FlyHeightPillar"
        heightVisualPart.Shape = Enum.PartType.Cylinder
        heightVisualPart.Material = Enum.Material.SmoothPlastic
        heightVisualPart.Color = Color3.fromRGB(110, 110, 115)
        heightVisualPart.Transparency = 0.35
        heightVisualPart.Anchored = true
        heightVisualPart.CanCollide = false
        heightVisualPart.Parent = workspace
    end

    if heightVisualConn then heightVisualConn:Disconnect() end

    heightVisualConn = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and heightVisualPart then
            local flyHeight = tonumber(HeightBox.Text) or 150
            local hrp = char.HumanoidRootPart
            heightVisualPart.Size = Vector3.new(flyHeight, 2, 2)
            heightVisualPart.CFrame = CFrame.new(hrp.Position + Vector3.new(0, flyHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
        end
    end)
end

HeightVisualBtn.MouseButton1Click:Connect(function()
    showHeightVisual = not showHeightVisual
    if showHeightVisual then
        HeightVisualBtn.Text = "Trụ: ON"
        HeightVisualBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        HeightVisualBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        updateHeightVisual()
    else
        HeightVisualBtn.Text = "Trụ: OFF"
        HeightVisualBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        HeightVisualBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        clearHeightVisual()
    end
end)

HeightBox:GetPropertyChangedSignal("Text"):Connect(function()
    if showHeightVisual then
        updateHeightVisual()
    end
end)

--- Safe Collision & Anti-Stuck System ---
local function resetCharacterPhysics()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local overlapParams = OverlapParams.new()
        overlapParams.FilterDescendantsInstances = {char}
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude

        local stuckParts = workspace:GetPartsInPart(hrp, overlapParams)
        if #stuckParts > 0 then
            for i = 1, 5 do
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                if #workspace:GetPartsInPart(hrp, overlapParams) == 0 then
                    break
                end
            end
        end
    end

    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
                part.CanCollide = true
            end
        end
    end
end

local function setNoclip(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        resetCharacterPhysics()
    end
end

--- Helper Tween Motion with Cancel Support ---
local function tweenToTarget(hrp, targetCFrame, flySpeed)
    if stopRequested then return false end

    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed

    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()

    local finished = false
    local connection
    connection = currentTween.Completed:Connect(function()
        finished = true
    end)

    while not finished do
        if stopRequested then
            if currentTween then currentTween:Cancel() end
            if connection then connection:Disconnect() end
            return false
        end
        task.wait()
    end

    if connection then connection:Disconnect() end
    return true
end

--- Flying Logic ---
local function startFly()
    if isFlying then return end

    if not selectedPlayer or not selectedPlayer.Character or not selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        StatusLabel.Text = "Lỗi: Người chơi không tồn tại!"
        return
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local targetHrp = selectedPlayer.Character.HumanoidRootPart

    local flyHeight = tonumber(HeightBox.Text) or 150
    local flySpeed = tonumber(SpeedBox.Text) or 100

    isFlying = true
    stopRequested = false

    StartBtn.Text = "DỪNG BAY (STOP)"
    StartBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    StartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    setNoclip(true)

    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Phase 1: Fly Up
    StatusLabel.Text = "Đang bay lên..."
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local success1 = tweenToTarget(hrp, CFrame.new(skyPos), flySpeed)

    -- Phase 2: Fly to Target Overhead
    if success1 and not stopRequested then
        StatusLabel.Text = "Đang di chuyển tới..."
        local targetOverhead = targetHrp.Position + Vector3.new(0, flyHeight, 0)
        local success2 = tweenToTarget(hrp, CFrame.new(targetOverhead), flySpeed)

        -- Phase 3: Land on Target
        if success2 and not stopRequested then
            StatusLabel.Text = "Đang hạ cánh..."
            local targetLandPos = targetHrp.Position + Vector3.new(0, 3, 0)
            tweenToTarget(hrp, CFrame.new(targetLandPos), flySpeed)
        end
    end

    -- Khôi phục trạng thái an toàn
    workspace.Gravity = oldGravity
    resetCharacterPhysics()
    isFlying = false

    StartBtn.Text = "BẮT ĐẦU BAY"
    StartBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    StartBtn.TextColor3 = Color3.fromRGB(0, 0, 0)

    if stopRequested then
        StatusLabel.Text = "Đã dừng bay an toàn!"
    else
        StatusLabel.Text = "Đã đến nơi!"
    end
end

-- Xử lý bấm Nút Start / Stop
StartBtn.MouseButton1Click:Connect(function()
    if isFlying then
        stopRequested = true
        if currentTween then
            currentTween:Cancel()
        end
        resetCharacterPhysics()
    else
        startFly()
    end
end)
