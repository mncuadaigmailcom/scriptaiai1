--- [CẬP NHẬT TÍNH NĂNG] Player Listing, Search, Refresh & Water-Blue Highlight ---
local function updatePlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local filterText = string.lower(SearchBox.Text)
    local visibleCount = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local nameMatch = string.find(string.lower(plr.Name), filterText, 1, true)
            local displayMatch = string.find(string.lower(plr.DisplayName), filterText, 1, true)

            if filterText == "" or nameMatch or displayMatch then
                visibleCount = visibleCount + 1
                
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 25)
                Btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
                Btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
                Btn.Font = Enum.Font.SourceSans
                Btn.TextSize = 14
                Btn.Parent = PlayerList

                -- Kiêm tra người chơi đang chọn để giữ màu Xanh Nước khi Tải Lại
                if selectedPlayer == plr then
                    Btn.BackgroundColor3 = WATER_BLUE
                    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    Btn.BackgroundColor3 = DEFAULT_BTN_COLOR
                    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                end

                -- Sự kiện Bấm Chọn Người Chơi -> Hiện màu Xanh Nước
                Btn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    StatusLabel.Text = "Đã chọn: " .. plr.DisplayName

                    -- Re-set tất cả các nút về màu mặc định
                    for _, child in pairs(PlayerList:GetChildren()) do
                        if child:IsA("TextButton") then
                            child.BackgroundColor3 = DEFAULT_BTN_COLOR
                        end
                    end

                    -- Đổi nút được bấm sang MÀU XANH NƯỚC
                    Btn.BackgroundColor3 = WATER_BLUE
                end)
            end
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, visibleCount * 27)
end

-- Sự kiện Tải Lại & Tìm Kiếm (Hoạt động cả khi đang bay)
