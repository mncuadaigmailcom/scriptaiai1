-- HỆ THỐNG ĐỊNH VỊ (ESP / TRACKER CORE)
---------------------------------------------------------
local function createESP(plr)
    if espStorage[plr] then return end

    local bbg = Instance.new("BillboardGui")
    bbg.Name = "ESP_BananaTracker"
    bbg.Size = UDim2.new(0, 220, 0, 50)
    bbg.AlwaysOnTop = true
    bbg.ExtentsOffset = Vector3.new(0, 3, 0)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.TextColor3 = Color3.fromRGB(0, 255, 128)
    txt.Parent = bbg

    espStorage[plr] = {Gui = bbg, Label = txt}
end

local function removeESP(plr)
    if espStorage[plr] then
        if espStorage[plr].Gui then
            espStorage[plr].Gui:Destroy()
        end
        espStorage[plr] = nil
    end
end

local function removeAllESP()
    for plr, data in pairs(espStorage) do
        removeESP(plr)
    end
    downedTimeTracker = {}
end

-- Vòng lặp cập nhật ESP realtime
RunService.RenderStepped:Connect(function()
    if not espAllActive and not espSingleActive then
        if next(espStorage) ~= nil then removeAllESP() end
        return
    end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local shouldTrack = false

            if espAllActive then
                shouldTrack = true
            elseif espSingleActive and selectedPlayer == plr then
                shouldTrack = true
            end

            if shouldTrack and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                createESP(plr)
                local data = espStorage[plr]
                local targetHrp = plr.Character.HumanoidRootPart
                local head = plr.Character:FindFirstChild("Head") or targetHrp
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")

                data.Gui.Adornee = head
                data.Gui.Parent = ScreenGui

                local dist = myHrp and math.floor((targetHrp.Position - myHrp.Position).Magnitude) or 0
                local hp = hum and math.floor(hum.Health) or 0
                local maxHp = hum and math.floor(hum.MaxHealth) or 100

                local isKnocked = isPlayerDeadOrKnocked(plr)

                if isKnocked then
                    -- Bắt đầu tính giờ hạ gục
                    if not downedTimeTracker[plr] then
                        downedTimeTracker[plr] = tick()
                    end

                    local elapsed = math.floor(tick() - downedTimeTracker[plr])
                    data.Label.TextColor3 = COLOR_DEAD -- Đỏ
                    data.Label.Text = string.format("🔴 [%s]\n⚡ BỊ HẠ GỤC (%ds) | HP: %d/%d\n📏 Khoảng cách: %dm", plr.DisplayName, elapsed, hp, maxHp, dist)
                else
                    -- Cứu thành công -> Reset đồng hồ đếm thời gian
                    downedTimeTracker[plr] = nil

                    data.Label.TextColor3 = Color3.fromRGB(0, 255, 128) -- Xanh lá
                    data.Label.Text = string.format("👤 [%s]\n💚 HP: %d/%d\n📏 Khoảng cách: %dm", plr.DisplayName, hp, maxHp, dist)
                end
            else
                removeESP(plr)
                downedTimeTracker[plr] = nil
            end
        else
            removeESP(plr)
        end
    end
end)

