local function updatePlayersLayout()
    local leftRatio = math.clamp(splitRatio, minSplit, maxSplit)
    local rightRatio = 1 - leftRatio - 0.02

    -- Chia tỉ lệ 3 ô phía trên (Tìm kiếm - Tải lại - Định vị)
    SearchBox.Size = UDim2.new(leftRatio * 0.44, 0, 0, 26)
    SearchBox.Position = UDim2.new(0, 0, 0, 0)

    RefreshBtn.Size = UDim2.new(leftRatio * 0.25, 0, 0, 26)
    RefreshBtn.Position = UDim2.new(leftRatio * 0.46, 0, 0, 0)

    TrackPlayersBtn.Size = UDim2.new(leftRatio * 0.27, 0, 0, 26)
    TrackPlayersBtn.Position = UDim2.new(leftRatio * 0.72, 0, 0, 0)

    PlayerList.Size = UDim2.new(leftRatio, 0, 1, -32)
    PlayerList.Position = UDim2.new(0, 0, 0, 32)

    SplitDivider.Size = UDim2.new(0, 8, 1, -32)
    SplitDivider.Position = UDim2.new(leftRatio + 0.003, 0, 0, 32)

    P_RightPanel.Position = UDim2.new(leftRatio + 0.02, 0, 0, 32)
    P_RightPanel.Size = UDim2.new(rightRatio, 0, 1, -32)
end

