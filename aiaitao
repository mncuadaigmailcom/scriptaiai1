        ftpNcConn = RunService.Stepped:Connect(function()
            local c = GetChar(); if c then for _, p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        end)
    else ftpResetPhysics() end
end

local function ftpTweenTo(hrp, targetCFrame, speed)
    if ftpStopReq then return false end
    local dist = (targetCFrame.Position - hrp.Position).Magnitude
    local dur = math.max(dist / speed, 0.05)
    ftpTween = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    ftpTween:Play()
    local fin = false
    local conn; conn = ftpTween.Completed:Connect(function() fin = true end)
    while not fin do
        if ftpStopReq then if ftpTween then ftpTween:Cancel() end; if conn then conn:Disconnect() end; return false end
        task.wait()
    end
    if conn then conn:Disconnect() end
    return true
end

local function startFtpFly()
    if ftpIsFlying then return end
    local tPart = getTargetPart(ftpSelectedPlayer)
    if not ftpSelectedPlayer or not tPart then ftpStatus.Text = "Lỗi: Không tìm thấy mục tiêu!"; return end
    local hrp = Root(); if not hrp then return end

    if S.flying then S.flying = false; StopFly() end -- Tắt bay cũ

    local h = tonumber(ftpHeight.Text) or 150
    local spd = tonumber(ftpSpeed.Text) or 100

    ftpIsFlying = true; ftpStopReq = false
    ftpStartBtn.Text = "🛑 DỪNG BAY KHẨN CẤP"; ftpStartBtn.BackgroundColor3 = C.RED
    ftpSetNoclip(true)

    local oldGrav = workspace.Gravity; workspace.Gravity = 0

    ftpStatus.Text = "🚀 Phase 1: Đang bay lên..."
    local s1 = ftpTweenTo(hrp, CFrame.new(hrp.Position + Vector3.new(0, h, 0)), spd)
    
    if s1 and not ftpStopReq then
        tPart = getTargetPart(ftpSelectedPlayer)
        if tPart then
            ftpStatus.Text = "✈️ Phase 2: Đang bay tới đỉnh mục tiêu..."
            local s2 = ftpTweenTo(hrp, CFrame.new(tPart.Position + Vector3.new(0, h, 0)), spd)
            if s2 and not ftpStopReq then
                tPart = getTargetPart(ftpSelectedPlayer)
                if tPart then
                    ftpStatus.Text = "🛬 Phase 3: Đang hạ cánh..."
                    ftpTweenTo(hrp, CFrame.new(tPart.Position + Vector3.new(0, 3, 0)), spd)
                end
            end
        end
    end

    workspace.Gravity = oldGrav
    ftpResetPhysics()
    ftpIsFlying = false
    ftpStartBtn.Text = "🚀 BẮT ĐẦU BAY TỚI MỤC TIÊU"; ftpStartBtn.BackgroundColor3 = C.BLUE
    ftpStatus.Text = ftpStopReq and "🛑 Đã dừng an toàn!" or "✅ Đã tới mục tiêu!"
end

ftpStartBtn.Activated:Connect(function()
    if ftpIsFlying then
        ftpStopReq = true
        if ftpTween then ftpTween:Cancel() end
        ftpResetPhysics()
    else startFtpFly() end
end)

