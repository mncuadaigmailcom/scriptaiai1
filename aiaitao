local function RebuildScripts()
    for _, c in ipairs(scriptList:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end
    end

    if #scripts == 0 then
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 40),
            Text = "📭 Chưa có script nào được lưu",
            BackgroundTransparency = 1,
            TextColor3 = C.GRAY,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            ZIndex = 7,
        }, scriptList)
        savedCodeTab.CanvasSize = UDim2.new(0, 0, 0, sy + 50)
        return
    end

    local totalHeight = 0
    for i, d in ipairs(scripts) do
        local row = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            Text = d.name,
            BackgroundColor3 = C.BLUE,
            BackgroundTransparency = 0.2,
            TextColor3 = C.WHITE,
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            BorderSizePixel = 0,
            ZIndex = 7,
        }, scriptList)
        Corner(row, UDim.new(0, 5))
        
        local idx = i
        row.Activated:Connect(function()
            local ok, err = pcall(function()
                local fn, loadErr = loadstring(d.code)
                if not fn then error(loadErr) end
                fn()
            end)
            if not ok then warn("Lỗi: " .. tostring(err)) end
        end)
        
        totalHeight = totalHeight + 36
    end
    
    savedCodeTab.CanvasSize = UDim2.new(0, 0, 0, sy + totalHeight + 30)
end

