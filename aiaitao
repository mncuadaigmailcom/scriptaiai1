--- Safe Physics Reset ---
local function resetCharacterPhysics()
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local overlapParams = OverlapParams.new()
        overlapParams.FilterDescendantsInstances = {char}
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude

        if #workspace:GetPartsInPart(hrp, overlapParams) > 0 then
            for i = 1, 5 do
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                if #workspace:GetPartsInPart(hrp, overlapParams) == 0 then break end
            end
        end
    end

    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
                part.CanCollide = true
            end
        end
    end
end

local function setNoclip(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    else
        resetCharacterPhysics()
    end
end

--- Helper Movement Tween ---
local function tweenToTarget(hrp, targetCFrame, flySpeed)
    if stopRequested then return false end

    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed

    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()

    local finished = false
    local connection
    connection = currentTween.Completed:Connect(function() finished = true end)

    while not finished do
        if stopRequested then
            if currentTween then currentTween:Cancel() end
            if connection then connection:Disconnect() end
            return false
        end
        task.wait()
    end

    if connection then connection:Disconnect() end
    return true
end

--- Core Flight Routine (Dùng Chung Cho Cả Player Vẫn Tọa Độ Đã Lưu) ---
local function startFly()
    if isFlying then return end

    -- Xác định vị trí mục tiêu
    local getTargetPosition = nil
    local targetLabel = ""

    if selectedPlayer then
        getTargetPosition = function()
            local p = getTargetPart(selectedPlayer)
            return p and p.Position
        end
        targetLabel = selectedPlayer.DisplayName
    elseif selectedLocation then
        getTargetPosition = function()
            return selectedLocation.pos
        end
        targetLabel = selectedLocation.name
    else
        StatusLabel.Text = "Lỗi: Vui lòng chọn Người chơi hoặc Tọa độ!"
        return
    end

    local initialPos = getTargetPosition()
    if not initialPos then
        StatusLabel.Text = "Lỗi: Không tìm thấy vị trí mục tiêu!"
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local flyHeight = tonumber(HeightBox.Text) or 150
    local flySpeed = tonumber(SpeedBox.Text) or 100

    isFlying = true
    stopRequested = false

    StartBtn.Text = "DỪNG BAY (STOP)"
    StartBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    StartBtn.TextColor3 = TEXT_LIGHT

    setNoclip(true)
    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Phase 1: Bay vút lên trời
    StatusLabel.Text = "Đang bay lên cao..."
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local ok1 = tweenToTarget(hrp, CFrame.new(skyPos), flySpeed)

    -- Phase 2: Di chuyển ngang đến phía trên đỉnh mục tiêu
    if ok1 and not stopRequested then
        StatusLabel.Text = "Đang di chuyển ngang tới " .. targetLabel .. "..."
        local curTargetPos = getTargetPosition()
        if curTargetPos then
            local overheadPos = curTargetPos + Vector3.new(0, flyHeight, 0)
            local ok2 = tweenToTarget(hrp, CFrame.new(overheadPos), flySpeed)

            -- Phase 3: Hạ cánh xuống điểm đến
            if ok2 and not stopRequested then
                StatusLabel.Text = "Đang hạ cánh xuống..."
                curTargetPos = getTargetPosition()
                if curTargetPos then
                    local landPos = curTargetPos + Vector3.new(0, 3, 0)
                    tweenToTarget(hrp, CFrame.new(landPos), flySpeed)
                end
            end
        end
    end

    -- Khôi phục physics
    workspace.Gravity = oldGravity
    resetCharacterPhysics()
    isFlying = false

    StartBtn.Text = "BẮT ĐẦU BAY"
    StartBtn.BackgroundColor3 = Color3.fromRGB(240, 242, 245)
    StartBtn.TextColor3 = TEXT_DARK

    if stopRequested then
        StatusLabel.Text = "Đã dừng bay an toàn!"
    else
        StatusLabel.Text = "Đã đến vị trí thành công!"
    end
end

-- Nut Bắt Đầu / Dừng Bay
StartBtn.MouseButton1Click:Connect(function()
    if isFlying then
        stopRequested = true
        if currentTween then currentTween:Cancel() end
        resetCharacterPhysics()
    else
        startFly()
    end
end)
