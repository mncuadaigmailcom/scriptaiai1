end

local handleTL = CreateHandle("↖", UDim2.new(0, 2, 0, 2))
local handleTR = CreateHandle("↗", UDim2.new(1, -22, 0, 2))
local handleBL = CreateHandle("↙", UDim2.new(0, 2, 1, -22))
local handleBR = CreateHandle("↘", UDim2.new(1, -22, 1, -22))

SetupResizeHandle(handleTL, "TL")
SetupResizeHandle(handleTR, "TR")
SetupResizeHandle(handleBL, "BL")
SetupResizeHandle(handleBR, "BR")

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        activeResizeCorner = nil
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if activeResizeCorner and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local currentMousePos = UserInputService:GetMouseLocation()
        local delta = currentMousePos - resizeStartMousePos
        
        local rawW = resizeStartSize.X
        local rawH = resizeStartSize.Y
        
        if activeResizeCorner == "BR" then
            rawW = resizeStartSize.X + delta.X
            rawH = resizeStartSize.Y + delta.Y
        elseif activeResizeCorner == "BL" then
            rawW = resizeStartSize.X - delta.X
            rawH = resizeStartSize.Y + delta.Y
        elseif activeResizeCorner == "TR" then
            rawW = resizeStartSize.X + delta.X
            rawH = resizeStartSize.Y - delta.Y
        elseif activeResizeCorner == "TL" then
            rawW = resizeStartSize.X - delta.X
            rawH = resizeStartSize.Y - delta.Y
        end
        
        local actualW = math.clamp(rawW, minW, maxW)
        local actualH = math.clamp(rawH, minH, maxH)
        
        local deltaW = actualW - resizeStartSize.X
        local deltaH = actualH - resizeStartSize.Y
        
        local newX = resizeStartPos.X
        local newY = resizeStartPos.Y
        
        if activeResizeCorner == "BL" or activeResizeCorner == "TL" then newX = resizeStartPos.X - deltaW end
        if activeResizeCorner == "TR" or activeResizeCorner == "TL" then newY = resizeStartPos.Y - deltaH end
        
        main.Size = UDim2.new(0, actualW, 0, actualH)
        main.Position = UDim2.new(0, newX, 0, newY)
    end
end)

