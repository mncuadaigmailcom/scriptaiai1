-- ==================== SMART TARGET FINDER & CRUISE PATH FLY ====================
local function getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("Head")
        or char.PrimaryPart
        or char:FindFirstChildOfClass("BasePart")
end

local function isPlayerDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local targetPart = getTargetPart(plr)
    if not targetPart then return true end
    if hum and hum.Health <= 0 then return true end
    if plr.Character:FindFirstChild("Knocked") or plr.Character:FindFirstChild("Downed") or plr.Character:FindFirstChild("Ragdoll") then
        return true
    end
    return false
end

-- Chống kẹt vật lý khi hạ cánh
local function resetCharacterPhysics()
    if not S.targetFlying and not S.noClip then
        if ncConn then ncConn:Disconnect(); ncConn = nil end
    end
    local char = GetChar()
    if not char then return end
    local hrp = Root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        local overlapParams = OverlapParams.new()
        overlapParams.FilterDescendantsInstances = {char}
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        local stuckParts = workspace:GetPartsInPart(hrp, overlapParams)
        if #stuckParts > 0 then
            for i = 1, 6 do
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                if #workspace:GetPartsInPart(hrp, overlapParams) == 0 then break end
            end
        end
    end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
                part.CanCollide = true
            end
        end
    end
end

local function cruiseTween(hrp, targetCFrame, flySpeed)
    if S.targetStopRequested then return false end
    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed
    local currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()
    
    local finished = false
    local conn
    conn = currentTween.Completed:Connect(function() finished = true end)
    while not finished do
        if S.targetStopRequested then
            currentTween:Cancel()
            if conn then conn:Disconnect() end
            return false
        end
        task.wait()
    end
    if conn then conn:Disconnect() end
    return true
end

