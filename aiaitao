        end
    end
end)

--- Player Listing System ---
local function updatePlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, 0, 0, 25)
            Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            Btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
            Btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Font = Enum.Font.SourceSans
            Btn.TextSize = 14
            Btn.Parent = PlayerList

            Btn.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                StatusLabel.Text = "Đã chọn: " .. plr.DisplayName
            end)
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, #PlayerList:GetChildren() * 27)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)
updatePlayerList()

--- Noclip Function ---
local function setNoclip(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

--- Flying Logic ---
local function startFly()
    if isFlying then return end
    if not selectedPlayer or not selectedPlayer.Character or not selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        StatusLabel.Text = "Lỗi: Người chơi không tồn tại!"
        return
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local targetHrp = selectedPlayer.Character.HumanoidRootPart

    local flyHeight = tonumber(HeightBox.Text) or 150
    local flySpeed = tonumber(SpeedBox.Text) or 100

    isFlying = true
    StartBtn.Text = "ĐANG BAY..."
    StartBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    setNoclip(true)

    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Phase 1: Fly Up
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local dist1 = (skyPos - hrp.Position).Magnitude
    local tween1 = TweenService:Create(hrp, TweenInfo.new(dist1 / flySpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(skyPos)})
    tween1:Play()
    tween1.Completed:Wait()

    -- Phase 2: Fly to Target Overhead
    local targetOverhead = targetHrp.Position + Vector3.new(0, flyHeight, 0)
    local dist2 = (targetOverhead - hrp.Position).Magnitude
    local tween2 = TweenService:Create(hrp, TweenInfo.new(dist2 / flySpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetOverhead)})
    tween2:Play()
    tween2.Completed:Wait()

    -- Phase 3: Land on Target
    local targetLandPos = targetHrp.Position + Vector3.new(0, 3, 0)
    local dist3 = (targetLandPos - hrp.Position).Magnitude
    local tween3 = TweenService:Create(hrp, TweenInfo.new(dist3 / flySpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetLandPos)})
    tween3:Play()
    tween3.Completed:Wait()

    -- Reset
    workspace.Gravity = oldGravity
    setNoclip(false)
    isFlying = false
    StartBtn.Text = "BẮT ĐẦU BAY"
    StartBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    StatusLabel.Text = "Đã đến nơi!"
end

StartBtn.MouseButton1Click:Connect(startFly)
