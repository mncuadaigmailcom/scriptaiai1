local function getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head") or char.PrimaryPart or char:FindFirstChildOfClass("BasePart")
end

local function isPlayerDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local tPart = getTargetPart(plr)
    if not tPart or (hum and hum.Health <= 0) then return true end
    if plr.Character:FindFirstChild("Knocked") or plr.Character:FindFirstChild("Downed") or plr.Character:FindFirstChild("Ragdoll") then return true end
    return false
end

local function updateFtpList()
    for _, child in pairs(ftpList:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
