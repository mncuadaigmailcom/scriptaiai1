-- ============================================
-- MODULE: UTILITY FUNCTIONS
-- ============================================
local Util = {}

function Util:Create(className, properties)
    local instance = Instance.new(className)
    for prop, value in pairs(properties or {}) do
        if prop == "Children" then
            for _, child in ipairs(value) do
                child.Parent = instance
            end
        else
            instance[prop] = value
        end
    end
    return instance
end

function Util:Corner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius or UDim.new(0, 8)
    corner.Parent = parent
    return corner
end

function Util:Stroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Theme.BgTertiary
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

function Util:Tween(instance, properties, duration, easing)
    local tweenInfo = TweenInfo.new(
        duration or 0.3,
        easing or Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )
    local tween = Services.Tween:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

function Util:GetCharacter()
    return Player.Character
end

function Util:GetHumanoid()
    local char = Util:GetCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Util:GetRootPart()
    local char = Util:GetCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Util:QuickBind(instance, event, callback)
    instance[event]:Connect(callback)
end

