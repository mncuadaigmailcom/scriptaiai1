local function updateHeightVisual()
    if not showHeightVisual then
        if heightVisualPart then heightVisualPart:Destroy() heightVisualPart = nil end
        if heightVisualConn then heightVisualConn:Disconnect() heightVisualConn = nil end
        return
    end

    if not heightVisualPart then
        heightVisualPart = Instance.new("Part")
        heightVisualPart.Name = "FlyHeightPillar"
        heightVisualPart.Shape = Enum.PartType.Cylinder
        heightVisualPart.Material = Enum.Material.SmoothPlastic
        heightVisualPart.Color = Color3.fromRGB(200, 200, 220)
        heightVisualPart.Transparency = 0.4
        heightVisualPart.Anchored = true
        heightVisualPart.CanCollide = false
        heightVisualPart.Parent = workspace
    end

    if heightVisualConn then heightVisualConn:Disconnect() end

    heightVisualConn = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and heightVisualPart then
            local flyHeight = tonumber(P_HeightBox.Text) or 150
