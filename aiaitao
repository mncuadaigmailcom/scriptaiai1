function ESPSystem:RemovePlayerESP(plr)
    if ESPCache[plr] then
        ESPCache[plr].Billboard:Destroy()
        ESPCache[plr] = nil
    end
end

function ESPSystem:RemoveAllESP()
    for plr, _ in pairs(ESPCache) do
        ESPSystem:RemovePlayerESP(plr)
    end
end

function ESPSystem:Update()
    if not ESPEnabled then
        ESPSystem:RemoveAllESP()
        return
    end
    
    local myRoot = Util:GetRootPart()
    if not myRoot then return end
    
    for _, plr in pairs(Services.Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            local theirRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            local theirHumanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if theirRoot and theirHumanoid then
                ESPSystem:CreatePlayerESP(plr)
                local cache = ESPCache[plr]
                if cache then
                    cache.Billboard.Adornee = plr.Character:FindFirstChild("Head") or theirRoot
                    
                    local distance = math.floor((theirRoot.Position - myRoot.Position).Magnitude)
                    local healthPercent = theirHumanoid.Health / theirHumanoid.MaxHealth
                    
                    cache.HealthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
                    cache.DistanceLabel.Text = string.format("Distance: %dm | HP: %.0f%%", distance, healthPercent * 100)
                    
                    -- Color based on distance
                    if distance < 25 then
                        cache.NameLabel.TextColor3 = Theme.Danger
                    elseif distance < 50 then
                        cache.NameLabel.TextColor3 = Theme.Warning
                    else
                        cache.NameLabel.TextColor3 = Theme.Success
                    end
                end
            end
        end
    end
end

