local FlySystem = {}
local BodyVelocity, BodyGyro, FlyPart, CarpetPart
local FlyConnection, CarpetConnection

function FlySystem:Start()
    local root = Util:GetRootPart()
    local humanoid = Util:GetHumanoid()
    if not root or not humanoid then return end
    
    if not BodyVelocity then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000)
        BodyVelocity.Velocity = Vector3.zero
    end
    
    if not BodyGyro then
        BodyGyro = Instance.new("BodyGyro")
        BodyGyro.MaxTorque = Vector3.new(40000, 40000, 40000)
        BodyGyro.CFrame = root.CFrame
    end
    
    if not FlyPart then
        FlyPart = Instance.new("Part")
        FlyPart.Name = "FlyPlatform"
        FlyPart.Size = Vector3.new(6, 0.2, 6)
        FlyPart.Transparency = 0.7
        FlyPart.Color = Theme.AccentCyan
        FlyPart.Material = Enum.Material.Glass
        FlyPart.Anchored = true
        FlyPart.CanCollide = false
        FlyPart.Parent = Services.Workspace
    end
    
    BodyVelocity.Parent = root
    BodyGyro.Parent = root
    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    
    if FlyConnection then FlyConnection:Disconnect() end
    FlyConnection = Services.RunService.RenderStepped:Connect(function(deltaTime)
        if not State.Flying then return end
        
        local currentRoot = Util:GetRootPart()
        local currentHumanoid = Util:GetHumanoid()
        if not currentRoot or not currentHumanoid then return end
        
        local moveDirection = currentHumanoid.MoveDirection
        local worldDirection = currentRoot.CFrame:VectorToWorldSpace(moveDirection)
        if worldDirection.Magnitude > 0 then
            worldDirection = worldDirection.Unit
        end
        
        local upInput = Services.UserInput:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
        local downInput = Services.UserInput:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or 0
        local verticalVelocity = (upInput - downInput) * State.FlySpeed
        
        BodyVelocity.Velocity = worldDirection * State.FlySpeed + Vector3.new(0, verticalVelocity, 0)
        BodyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + Camera.CFrame.LookVector)
        
        if FlyPart then
            FlyPart.Position = currentRoot.Position - Vector3.new(0, 3.5, 0)
        end
    end)
    
    State.Flying = true
end

function FlySystem:Stop()
    State.Flying = false
    
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
    
    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end
    
    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end
    
    if FlyPart then
        FlyPart:Destroy()
        FlyPart = nil
    end
    
    local humanoid = Util:GetHumanoid()
    if humanoid then
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
    end
end

function FlySystem:StartCarpet()
    local root = Util:GetRootPart()
    if not root then return end
    
    local width = State.CarpetWidth
    local thickness = State.CarpetThickness
    local length = State.CarpetLength
    
    if CarpetPart then CarpetPart:Destroy() end
    
    CarpetPart = Instance.new("Part")
    CarpetPart.Name = "Carpet"
    CarpetPart.Size = Vector3.new(width, thickness, length)
    CarpetPart.Transparency = 0.85
    CarpetPart.Color = Color3.fromRGB(150, 200, 255)
    CarpetPart.Material = Enum.Material.SmoothPlastic
    CarpetPart.Anchored = true
    CarpetPart.CanCollide = true
    CarpetPart.Friction = 1
    CarpetPart.Position = Vector3.new(root.Position.X, root.Position.Y - 3, root.Position.Z)
    CarpetPart.Parent = Services.Workspace
    
    if CarpetConnection then CarpetConnection:Disconnect() end
    CarpetConnection = Services.RunService.RenderStepped:Connect(function()
        local currentRoot = Util:GetRootPart()
        if not currentRoot or not CarpetPart or not State.Carpet then return end
        
        CarpetPart.Position = Vector3.new(currentRoot.Position.X, CarpetPart.Position.Y, currentRoot.Position.Z)
        
        if State.NoClip then
            local standHeight = CarpetPart.Position.Y + (thickness / 2) + 3
            if currentRoot.Position.Y < standHeight then
                currentRoot.CFrame = CFrame.new(currentRoot.Position.X, standHeight, currentRoot.Position.Z)
            end
        end
    end)
    
    State.Carpet = true
end

function FlySystem:StopCarpet()
    State.Carpet = false
    if CarpetConnection then
        CarpetConnection:Disconnect()
        CarpetConnection = nil
    end
    if CarpetPart then
        CarpetPart:Destroy()
        CarpetPart = nil
    end
end

function FlySystem:TeleportTo(targetPos, height, speed)
    local root = Util:GetRootPart()
    if not root then return end
    
    height = height or 150
    speed = speed or 100
    
    local startPos = root.Position
    local skyPos = Vector3.new(startPos.X, startPos.Y + height, startPos.Z)
    local target = targetPos
    
    -- Phase 1: Ascend
    local tween1 = Services.Tween:Create(root, TweenInfo.new(height / speed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(skyPos)
    })
    
    local phase1Complete = false
    tween1.Completed:Connect(function() phase1Complete = true end)
    tween1:Play()
    
    while not phase1Complete do
        if State.Cancelled then
            tween1:Cancel()
            return
        end
        task.wait()
    end
    
    if State.Cancelled then return end
    
    -- Phase 2: Horizontal
    local overheadPos = Vector3.new(target.X, skyPos.Y, target.Z)
    local tween2 = Services.Tween:Create(root, TweenInfo.new(
        (overheadPos - skyPos).Magnitude / speed,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    ), {
        CFrame = CFrame.new(overheadPos)
    })
    
    local phase2Complete = false
    tween2.Completed:Connect(function() phase2Complete = true end)
    tween2:Play()
    
    while not phase2Complete do
        if State.Cancelled then
            tween2:Cancel()
            return
        end
        task.wait()
    end
    
    if State.Cancelled then return end
    
    -- Phase 3: Descend
    local tween3 = Services.Tween:Create(root, TweenInfo.new(
        height / speed,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.In
    ), {
        CFrame = CFrame.new(target)
    })
    
    tween3:Play()
end

