-- ==================== UI HELPER FUNCTIONS ====================
local function New(cls, props, parent)
    local obj = Instance.new(cls)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

local function Corner(p, r)
    return New("UICorner", {CornerRadius = r or UDim.new(0, 8)}, p)
end

local function Stroke(p, c, t)
    return New("UIStroke", {Color = c or Color3.fromRGB(170, 175, 190), Thickness = t or 1.2}, p)
end

local function Tween(o, p, d, e)
    TweenService:Create(o, TweenInfo.new(d or 1.5, e or Enum.EasingStyle.Quad), p):Play()
end

local function TweenL(p)
    Tween(Lighting, p)
end

-- ==================== CHARACTER HELPERS ====================
local function GetChar() return player.Character end
local function Hum() 
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function Root() 
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function UpdChar()
    local h = Hum()
    if h then
        h.WalkSpeed=S.walkSpeed
        h.JumpPower=S.jumpPower
    end
end

local function getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("Head")
        or char.PrimaryPart
        or char:FindFirstChildOfClass("BasePart")
end

local function isPlayerDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local targetPart = getTargetPart(plr)
    if not targetPart then return true end
    if hum and hum.Health <= 0 then return true end
    if plr.Character:FindFirstChild("Knocked") or plr.Character:FindFirstChild("Downed") or plr.Character:FindFirstChild("Ragdoll") or plr.Character:FindFirstChild("Dead") then
        return true
    end
    if plr:FindFirstChild("DataFolder") and plr.DataFolder:FindFirstChild("Information") and plr.DataFolder.Information:FindFirstChild("IsKnocked") then
        if plr.DataFolder.Information.IsKnocked.Value == true then return true end
    end
    return false
end

