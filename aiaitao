    local toggleFrame = Util:Create("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        Position = config.Position or UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Theme.BgSecondary,
        BackgroundTransparency = 0.5,
        Children = {
            Util:Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
            Util:Create("UIStroke", { Color = Theme.BgTertiary, Thickness = 1 }),
        }
    }, parent)
    
    local label = Util:Create("TextLabel", {
        Size = UDim2.new(0.7, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        Text = config.Text or "Toggle",
        TextColor3 = Theme.TextPrimary,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
    }, toggleFrame)
    
    local indicator = Util:Create("Frame", {
        Size = UDim2.new(0, 44, 0, 24),
        Position = UDim2.new(1, -54, 0.5, -12),
        BackgroundColor3 = state and Theme.Success or Theme.BgTertiary,
        Children = {
            Util:Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            Util:Create("Frame", {
                Size = UDim2.new(0, 20, 0, 20),
                Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10),
                BackgroundColor3 = Theme.White,
                Children = {
                    Util:Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
                }
            })
        }
    }, toggleFrame)
    
    toggleFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            state = not state
            local knob = indicator:FindFirstChildOfClass("Frame")
            if knob then
                Animation:Play(knob, {
                    Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
                }, 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            end
            Animation:Play(indicator, {
                BackgroundColor3 = state and Theme.Success or Theme.BgTertiary
            }, 0.2)
            if config.OnToggle then config.OnToggle(state) end
        end
    end)
    
    return toggleFrame, function() return state end
end

