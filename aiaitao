--- Render Danh Sách Người Chơi (Sọc Xen Kẽ Trắng Xám Transparent) ---
local function updatePlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end

    local filterText = string.lower(SearchBox.Text)
    local count = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local nameMatch = string.find(string.lower(plr.Name), filterText, 1, true)
            local displayMatch = string.find(string.lower(plr.DisplayName), filterText, 1, true)

            if filterText == "" or nameMatch or displayMatch then
                count = count + 1
                local isEven = (count % 2 == 0)
                local isDead = isPlayerDeadOrKnocked(plr)

                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 24)
                Btn.BorderSizePixel = 0
                Btn.Font = Enum.Font.SourceSans
                Btn.TextSize = 13
                Btn.Parent = PlayerList

                if isDead then
                    Btn.Text = "🔴 [GỤC/CHẾT] " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
                    Btn.TextColor3 = COLOR_DEAD
                else
                    Btn.Text = "  " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
                    Btn.TextColor3 = TEXT_DARK
                    Btn.TextXAlignment = Enum.TextXAlignment.Left
                end

                -- Áp dụng phong cách SỌC TRẮNG XÁM
                if selectedPlayer == plr then
                    Btn.BackgroundColor3 = WATER_BLUE
                    Btn.BackgroundTransparency = 0.2
                    Btn.TextColor3 = TEXT_LIGHT
                else
                    Btn.BackgroundColor3 = isEven and COLOR_STRIPE_EVEN or COLOR_STRIPE_ODD
                    Btn.BackgroundTransparency = 0.35
                end

                Btn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    selectedLocation = nil -- Reset chọn tọa độ
                    StatusLabel.Text = "Đã chọn Player: " .. plr.DisplayName .. (isDead and " (GỤC/CHẾT)" or "")
                    updatePlayerList()
                end)
            end
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, count * 24)
end

