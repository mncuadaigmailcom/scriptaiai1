local function StopCarpet() if cp then cp:Destroy(); cp=nil end; RunService:UnbindFromRenderStep("Carpet"); S.carpetY=nil end
local function CreateCarpet(y)
    local r = Root()
    if not r then return end
    if cp then cp:Destroy() end
    local w, t, l = S.carpetWidth, S.carpetThickness, S.carpetLength
    S.carpetY = y or (r.Position.Y - 3.0 - (t / 2))
    cp = New("Part", {Name="Carpet", Size=Vector3.new(w, t, l), Transparency=0.9, Color=Color3.fromRGB(200,230,255), Material=Enum.Material.SmoothPlastic, Anchored=true, CanCollide=true, Friction=1, Position=Vector3.new(r.Position.X, S.carpetY, r.Position.Z)}, workspace)
    RunService:BindToRenderStep("Carpet", Enum.RenderPriority.Camera.Value - 1, function()
        local curR = Root()
        if not S.carpet or not cp or not curR then return end
        local curW, curT, curL = S.carpetWidth, S.carpetThickness, S.carpetLength
        if cp.Size.X ~= curW or cp.Size.Y ~= curT or cp.Size.Z ~= curL then cp.Size = Vector3.new(curW, curT, curL) end
        cp.CFrame = CFrame.new(curR.Position.X, S.carpetY, curR.Position.Z)
        if S.noClip then
            local standingY = S.carpetY + (curT / 2) + 3.0
            if curR.Position.Y < standingY then
                curR.CFrame = CFrame.new(curR.Position.X, standingY, curR.Position.Z)
                if curR.AssemblyLinearVelocity.Y < 0 then curR.AssemblyLinearVelocity = Vector3.new(curR.AssemblyLinearVelocity.X, 0, curR.AssemblyLinearVelocity.Z) end
            end
        end
    end)
end

local function TogFly()
    local r, h = Root(), Hum()
    if not r then return end
    if S.flying then
        if S.carpet then StopCarpet(); S.carpet=false end
        if S.flyRun and StopFlyRun then StopFlyRun() end
        bv=New("BodyVelocity",{MaxForce=Vector3.new(4000,4000,4000)},r)
