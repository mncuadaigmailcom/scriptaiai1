        DeleteBtn.Position = UDim2.new(0.74, 0, 0.1, 0)
        DeleteBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        DeleteBtn.BackgroundTransparency = 0.2
        DeleteBtn.Text = "Xóa"
        DeleteBtn.TextColor3 = TEXT_LIGHT
        DeleteBtn.Font = Enum.Font.SourceSansBold
        DeleteBtn.TextSize = 11
        DeleteBtn.Parent = Container

        SelectBtn.MouseButton1Click:Connect(function()
            selectedLocation = item
            selectedPlayer = nil -- Reset chọn người chơi
            StatusLabel.Text = "Đã chọn Tọa độ: " .. item.name
