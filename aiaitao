-- CƠ CHẾ ĐỊNH VỊ TỌA ĐỘ (LOCATION MARKERS)
---------------------------------------------------------
local function clearLocationMarkers()
    if locationTrackRenderConn then
        locationTrackRenderConn:Disconnect()
        locationTrackRenderConn = nil
    end
    for _, child in pairs(workspace:GetChildren()) do
        if child.Name == "BananaFlyLocationMarkers" then
            child:Destroy()
        end
    end
end

local function refreshLocationMarkers()
    clearLocationMarkers()

    if not isTrackingAllLocations and not singleTrackedLocation then
        TrackAllBtn.Text = "📡 Định Vị: OFF"
        TrackAllBtn.BackgroundColor3 = Color3.fromRGB(220, 225, 235)
        TrackAllBtn.TextColor3 = TEXT_DARK
        return
    end

    if isTrackingAllLocations then
        TrackAllBtn.Text = "📡 Định Vị: ON"
        TrackAllBtn.BackgroundColor3 = WATER_BLUE
        TrackAllBtn.TextColor3 = TEXT_LIGHT
    else
        TrackAllBtn.Text = "📡 Định Vị: LẺ"
        TrackAllBtn.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
        TrackAllBtn.TextColor3 = TEXT_LIGHT
    end

    local folder = Instance.new("Folder")
    folder.Name = "BananaFlyLocationMarkers"
    folder.Parent = workspace

    local activeItems = {}
    if isTrackingAllLocations then
        activeItems = savedLocations
    elseif singleTrackedLocation then
        activeItems = {singleTrackedLocation}
    end

    local createdMarkers = {}

    for _, item in ipairs(activeItems) do
        local part = Instance.new("Part")
        part.Name = "Marker_" .. item.name
        part.Size = Vector3.new(1, 1, 1)
        part.Transparency = 1
