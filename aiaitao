-- Helper functions
local function getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("Head")
        or char.PrimaryPart
        or char:FindFirstChildOfClass("BasePart")
end

local function isPlayerDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local targetPart = getTargetPart(plr)
    if not targetPart then return true end
    if hum and hum.Health <= 0 then return true end
    if plr.Character:FindFirstChild("Knocked") or plr.Character:FindFirstChild("Downed") or plr.Character:FindFirstChild("Ragdoll") then
        return true
    end
    return false
end

local function updatePlayerListFlyTo()
    for _, child in pairs(ftPlayerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local filterText = string.lower(ftSearchBox.Text)
    local visibleCount = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local nameMatch = string.find(string.lower(plr.Name), filterText, 1, true)
            local displayMatch = string.find(string.lower(plr.DisplayName), filterText, 1, true)

            if filterText == "" or nameMatch or displayMatch then
                visibleCount = visibleCount + 1
                
                local isDead = isPlayerDeadOrKnocked(plr)
                local Btn = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BorderColor3 = Color3.fromRGB(50, 50, 50),
                    Font = Enum.Font.SourceSans,
