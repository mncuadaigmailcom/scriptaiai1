local function TogFly()
    local r=Root()
    local h=Hum()
    if not r then return end
    if S.flying then
        if S.carpet then StopCarpet(); S.carpet=false end
        bv=New("BodyVelocity",{MaxForce=Vector3.new(4000,4000,4000)},r)
        bg=New("BodyGyro",{MaxTorque=Vector3.new(4000,4000,4000)},r)
        if h then h.AutoRotate=false; h.PlatformStand=true end
        if not fp then
            fp=New("Part",{
                Name="Floor", Size=Vector3.new(6,0.2,6), Transparency=0.7,
                Color=Color3.fromRGB(200,230,255), Material=Enum.Material.Glass,
                Anchored=true, CanCollide=false,
            }, workspace)
        end
        RunService:BindToRenderStep("Fly",1,function()
            local curR = Root()
            local curH = Hum()
            if not S.flying or not curR or not bv then return end
            local d=curH and curH.MoveDirection or Vector3.zero
            local t=curR.CFrame:VectorToWorldSpace(d)
            if t.Magnitude>0 then t=t.Unit end
            local u,dn = UserInputService:IsKeyDown(Enum.KeyCode.Space), UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            local vv=(u and 1 or 0)-(dn and 1 or 0)
            bv.Velocity=(t+Vector3.new(0,vv,0))*S.flySpeed
            bg.CFrame=CFrame.new(curR.Position,curR.Position+workspace.CurrentCamera.CFrame.LookVector)
            fp.Position=curR.Position-Vector3.new(0,3.5,0)
        end)
    else
        StopFly()
    end
end

local function TogCarpet()
    local r=Root()
    if not r then return end
    if S.carpet then
        if S.flying then S.flying=false; StopFly() end
        CreateCarpet(r.Position.Y - 3.0 - ((S.carpetThickness or 0.2) / 2))
    else
        StopCarpet()
    end
end

-- ==================== FLY TO TARGET SYSTEM ====================
local function tweenToTarget(hrp, targetCFrame, flySpeed)
    if stopRequested then return false end
    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = math.max(distance / flySpeed, 0.1)
    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()
    local finished = false
    local connection
    connection = currentTween.Completed:Connect(function() finished = true end)
    while not finished do
        if stopRequested then
            if currentTween then currentTween:Cancel() end
            if connection then connection:Disconnect() end
            return false
        end
        task.wait()
    end
    if connection then connection:Disconnect() end
    return true
end

local function stopFlyToTarget()
    stopRequested = true
    if currentTween then currentTween:Cancel() end
    isFlying = false
    S.flyToPlayerActive = false
    workspace.Gravity = 196.2
    updateNoclipState()
end

local function startFlyToTarget(mode, targetObj)
    if isFlying then return end
    if S.followPlayerActive then stopFollow() end
    
    local getTargetCFrame = nil
    if mode == "Player" then
        if not targetObj then return end
        selectedPlayer = targetObj
        getTargetCFrame = function()
            local p = getTargetPart(targetObj)
            return p and p.CFrame
        end
    elseif mode == "Location" then
        if not targetObj then return end
        selectedLocation = targetObj
        getTargetCFrame = function()
            return CFrame.new(targetObj.pos)
        end
    elseif mode == "Wall" then
        if not targetObj or not targetObj.part or not targetObj.part.Parent then return end
        selectedWall = targetObj
        getTargetCFrame = function()
            if targetObj and targetObj.part and targetObj.part.Parent then
                local wallPart = targetObj.part
                local topPos = wallPart.Position + Vector3.new(0, (wallPart.Size.Y / 2) + 2.5, 0)
                return CFrame.new(topPos)
            end
            return nil
        end
    end
    
    local initialTargetCFrame = getTargetCFrame and getTargetCFrame()
    if not initialTargetCFrame then return end
    
    local char = GetChar()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local flyHeight = tonumber(P_HeightBox.Text) or 150
    local flySpeed = tonumber(P_SpeedBox.Text) or 100
    
    isFlying = true
    S.flyToPlayerActive = true
    stopRequested = false
    
    updateNoclipState()
    local oldGravity = workspace.Gravity
    workspace.Gravity = 0
    
    local currentLook = hrp.CFrame.LookVector
    
    -- Step 1: Fly straight up
    local startPos = hrp.Position
    local skyPos = Vector3.new(startPos.X, startPos.Y + flyHeight, startPos.Z)
    local ok1 = tweenToTarget(hrp, CFrame.new(skyPos, skyPos + currentLook), flySpeed)
    
    -- Step 2: Fly horizontally to above target
    if ok1 and not stopRequested then
        local liveCFrame = getTargetCFrame()
        if liveCFrame then
            local destPos = liveCFrame.Position
            local overheadPos = Vector3.new(destPos.X, skyPos.Y, destPos.Z)
            local horizontalLook = (overheadPos - skyPos).Magnitude > 0.1 and (overheadPos - skyPos).Unit or currentLook
            local ok2 = tweenToTarget(hrp, CFrame.new(overheadPos, overheadPos + horizontalLook), flySpeed)
            
            -- Step 3: Descend to target
            if ok2 and not stopRequested then
                liveCFrame = getTargetCFrame()
                if liveCFrame then
                    local targetFinalCFrame
                    if mode == "Player" then
                        targetFinalCFrame = liveCFrame * CFrame.new(0, 0, 2)
                    else
                        targetFinalCFrame = liveCFrame
                    end
                    tweenToTarget(hrp, targetFinalCFrame, flySpeed)
                end
            end
        end
    end
    
    workspace.Gravity = oldGravity
    isFlying = false
    S.flyToPlayerActive = false
    updateNoclipState()
end

-- ==================== FOLLOW PLAYER SYSTEM ====================
local function stopFollow()
    S.followPlayerActive = false
    stopRequested = true
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
    workspace.Gravity = 196.2
    updateNoclipState()
end

local function startFollow()
    if not selectedPlayer or not selectedPlayer.Character then
        stopFollow()
        return
    end
    if isFlying then stopFlyToTarget() end
    
    S.followPlayerActive = true
    stopRequested = false
    
    updateNoclipState()
    
    task.spawn(function()
        local oldGravity = workspace.Gravity
        workspace.Gravity = 0
        local hasArrived = false
        
        while S.followPlayerActive and not stopRequested and selectedPlayer and selectedPlayer.Character do
            local myChar = GetChar()
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local targetHrp = getTargetPart(selectedPlayer)
            
            if not myHrp or not targetHrp then break end
            
            local flyHeight = tonumber(P_HeightBox.Text) or 150
            local flySpeed = tonumber(P_SpeedBox.Text) or 100
            local targetCFrame = targetHrp.CFrame * CFrame.new(0, 0, 2)
            
            if not hasArrived then
                local startPos = myHrp.Position
                local skyPos = Vector3.new(startPos.X, startPos.Y + flyHeight, startPos.Z)
                local currentLook = myHrp.CFrame.LookVector
                
                local ok1 = tweenToTarget(myHrp, CFrame.new(skyPos, skyPos + currentLook), flySpeed)
                if not ok1 or not S.followPlayerActive or stopRequested then break end
                
                targetHrp = getTargetPart(selectedPlayer)
                if not targetHrp then break end
                local destPos = targetHrp.Position
                local overheadPos = Vector3.new(destPos.X, skyPos.Y, destPos.Z)
                local ok2 = tweenToTarget(myHrp, CFrame.new(overheadPos, overheadPos + (destPos - startPos).Unit), flySpeed)
                if not ok2 or not S.followPlayerActive or stopRequested then break end
                
                targetHrp = getTargetPart(selectedPlayer)
                if not targetHrp then break end
                local ok3 = tweenToTarget(myHrp, targetHrp.CFrame * CFrame.new(0, 0, 2), flySpeed)
                if not ok3 or not S.followPlayerActive or stopRequested then break end
                
                hasArrived = true
            else
                local dist = (myHrp.Position - targetCFrame.Position).Magnitude
                if dist > 1.5 then
                    local ok = tweenToTarget(myHrp, targetCFrame, flySpeed)
                    if not ok or not S.followPlayerActive or stopRequested then break end
                end
            end
            
            task.wait(0.05)
        end
        
        workspace.Gravity = oldGravity
        if S.followPlayerActive then stopFollow() end
    end)
end

