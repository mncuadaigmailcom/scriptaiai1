    local h=Hum()
    if h then h.AutoRotate=true; h.WalkSpeed=S.walkSpeed; h.JumpPower=S.jumpPower end
    fcHUD.Visible=false
end

local function EnFC()
    local cam=workspace.CurrentCamera
    if not cam then return end
    local r=Root()
    local h=Hum()
    if r then fcPos=r.Position+Vector3.new(0,5,0); r.Anchored=true end
    if h then h.AutoRotate=false; h.WalkSpeed=0; h.JumpPower=0 end
    cam.CameraType=Enum.CameraType.Scriptable
    cam.FieldOfView=90
    fcYaw=0; fcPitch=0
    UserInputService.MouseBehavior=Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled=false
    fcHUD.Visible=true
    RunService:BindToRenderStep("FC", Enum.RenderPriority.Camera.Value, function(dt)
        if not S.freeCam then return end
        local d=UserInputService:GetMouseDelta()
        fcYaw=(fcYaw - d.X * 0.3)%360
        fcPitch=math.clamp(fcPitch - d.Y * 0.3,-89,89)
        local cf=CFrame.new(fcPos) * CFrame.Angles(0,math.rad(fcYaw),0) * CFrame.Angles(math.rad(fcPitch),0,0)
        local sp=S.freeCamSpeed * dt
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then sp=sp * 3 end
        local m=Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then m+=cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then m-=cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then m-=cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then m+=cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then m+=Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then m-=Vector3.new(0,1,0) end
        fcPos+=m*sp
        cam.CFrame=CFrame.new(fcPos) * CFrame.Angles(0,math.rad(fcYaw),0) * CFrame.Angles(math.rad(fcPitch),0,0)
    end)
end

local function TogFC()
    if S.customCam then S.customCam=false; DisCC() end
    if S.freeCam then EnFC() else DisFC() end
end

UserInputService.InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.KeyCode==Enum.KeyCode.F and S.freeCam then S.freeCam=false; TogFC() end
    if i.UserInputType==Enum.UserInputType.MouseButton2 then
        rMouse=true
        if S.customCam then UserInputService.MouseBehavior=Enum.MouseBehavior.LockCurrentPosition end
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton2 then
        rMouse=false
        if S.customCam then UserInputService.MouseBehavior=Enum.MouseBehavior.Default end
    end
end)

-- ==================== CODE EXECUTION SYSTEM ====================
local function ExecOnce(code, name)
    if #name>0 then print("👤 Chạy bởi:", name) end
    return pcall(function()
        local fn, err = loadstring(code)
        if not fn then error(err) end
        fn()
    end)
end

local function Cancel()
    cancelled=true
    if curThread then task.cancel(curThread); curThread=nil end
    if curIndicator then curIndicator.BackgroundColor3=C.BLUE; curIndicator=nil end
end

local function RunCode(code, name, ind, times, delay)
    Cancel()
    if #code==0 then return false, "⚠️ Vui lòng nhập code!" end
    cancelled=false
    if ind then curIndicator=ind; ind.BackgroundColor3=C.RED end
    local okC, failC = 0, 0
    curThread=task.spawn(function()
        for i=1,times do
            if cancelled then break end
            if i>1 and delay>0 then
                local e=0
                while e<delay do
                    if cancelled then break end
                    task.wait(0.1); e+=0.1
                end
                if cancelled then break end
            end
            local ok, err = ExecOnce(code, name)
            if ok then okC+=1 else failC+=1; warn("❌ Lần",i,err) end
        end
        totalRuns+=okC+failC
        if ind then ind.BackgroundColor3=C.GREEN; if curIndicator==ind then curIndicator=nil end end
        curThread=nil
    end)
    return true, nil
end

