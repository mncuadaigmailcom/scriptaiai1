-- ==================== RESIZE HANDLES (4 CORNERS) ====================
local minW, minH = 440, 260
local maxW, maxH = 950, 650
local activeResizeCorner = nil
local resizeStartMousePos, resizeStartSize, resizeStartPos

local function SetupResizeHandle(btn, cornerType)
    btn.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and activeResizeCorner == nil then
            activeResizeCorner = cornerType
            resizeStartMousePos = UserInputService:GetMouseLocation()
            resizeStartSize = main.AbsoluteSize
            resizeStartPos = main.AbsolutePosition
        end
    end)
end

local function CreateHandle(icon, pos)
