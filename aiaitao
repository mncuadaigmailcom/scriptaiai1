        local bp2=h and h.Position or r.Position
        local cf=CFrame.new(bp2) * CFrame.Angles(0,math.rad(ccX),0) * CFrame.Angles(math.rad(ccY),0,0)
        local off=cf.RightVector * S.camOffX + cf.UpVector * S.camOffY
        local cp2=bp2 + cf.LookVector*(-8) + off + Vector3.new(0,1.5,0)
        cam.CFrame=CFrame.new(cp2, bp2 + Vector3.new(0,1.5,0))
        cam.FieldOfView=S.fov
    end)
