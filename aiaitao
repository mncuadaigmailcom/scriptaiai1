        customName = "Tường kính #" .. wallCounter
    end
    
    local wall = New("Part", {
        Name="BananaTransparentWall_"..wallCounter,
        Size=Vector3.new(sizeX, sizeY, sizeZ),
        CFrame=hrp.CFrame * CFrame.new(0, (sizeY/2)-3, -(sizeZ/2+4)),
        Anchored=true,
        CanCollide=wallCanCollide,
        Material=Enum.Material.SmoothPlastic,
        Transparency=trans,
        Color=Color3.fromRGB(0,170,255),
    }, workspace)
    
    local wallData = {id=wallCounter, name=customName, part=wall}
    table.insert(spawnedWalls, wallData)
    WallNameBox.Text = ""
end)

