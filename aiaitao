-- Smart Target Finder
local function flyTarget_getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head") or char.PrimaryPart or char:FindFirstChildOfClass("BasePart")
end

-- Check if player is dead/knocked
local function flyTarget_isPlayerDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not flyTarget_getTargetPart(plr) then return true end
    if hum and hum.Health <= 0 then return true end
    if plr.Character:FindFirstChild("Knocked") or plr.Character:FindFirstChild("Downed") or plr.Character:FindFirstChild("Ragdoll") then return true end
    return false
end

-- Visual Pillar Logic
local function flyTarget_clearHeightVisual()
    if flyTarget_heightVisualPart then flyTarget_heightVisualPart:Destroy(); flyTarget_heightVisualPart=nil end
    if flyTarget_heightVisualConn then flyTarget_heightVisualConn:Disconnect(); flyTarget_heightVisualConn=nil end
end
local function flyTarget_updateHeightVisual()
    if not flyTarget_showHeightVisual then flyTarget_clearHeightVisual(); return end
    if not flyTarget_heightVisualPart then
        flyTarget_heightVisualPart = New("Part", {Name="FlyHeightPillar", Shape=Enum.PartType.Cylinder, Material=Enum.Material.SmoothPlastic, Color=C.GRAY, Transparency=0.35, Anchored=true, CanCollide=false}, workspace)
    end
    if flyTarget_heightVisualConn then flyTarget_heightVisualConn:Disconnect() end
    flyTarget_heightVisualConn = RunService.RenderStepped:Connect(function()
        local r = Root()
        local heightBox = targetPlayerTab:FindFirstChild("HeightBox", true)
        if r and flyTarget_heightVisualPart and heightBox then
            local flyHeight = tonumber(heightBox.Text) or 150
            flyTarget_heightVisualPart.Size = Vector3.new(flyHeight, 2, 2)
            flyTarget_heightVisualPart.CFrame = CFrame.new(r.Position + Vector3.new(0, flyHeight/2, 0)) * CFrame.Angles(0, 0, math.rad(90))
        end
    end)
end

-- Safe Collision & Anti-Stuck System
local function flyTarget_resetCharacterPhysics()
    if flyTarget_noclipConnection then flyTarget_noclipConnection:Disconnect(); flyTarget_noclipConnection=nil end
    local char=GetChar()
    if not char then return end
    local hrp=Root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero
        local overlapParams=OverlapParams.new()
        overlapParams.FilterDescendantsInstances={char}; overlapParams.FilterType=Enum.RaycastFilterType.Exclude
        if #workspace:GetPartsInPart(hrp, overlapParams)>0 then for i=1,5 do hrp.CFrame=hrp.CFrame+Vector3.new(0,2,0) if #workspace:GetPartsInPart(hrp, overlapParams)==0 then break end end end
    end
    for _,part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then if part.Name=="HumanoidRootPart" or part.Name=="UpperTorso" or part.Name=="LowerTorso" or part.Name=="Torso" then part.CanCollide=true end end end
end

local function flyTarget_setNoclip(state)
    if state then
        flyTarget_noclipConnection = RunService.Stepped:Connect(function() if GetChar() then for _, part in pairs(GetChar():GetDescendants()) do if part:IsA("BasePart") then part.CanCollide=false end end end end)
    else
        flyTarget_resetCharacterPhysics()
    end
end

-- Helper Tween Motion
local function flyTarget_tweenToTarget(hrp, targetCFrame, flySpeed)
    if flyTarget_stopRequested then return false end
    local distance = (targetCFrame.Position-hrp.Position).Magnitude
    local duration = distance / flySpeed
    flyTarget_currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame=targetCFrame})
    flyTarget_currentTween:Play()
    local finished=false
    local connection = flyTarget_currentTween.Completed:Connect(function() finished=true end)
    while not finished do if flyTarget_stopRequested then if flyTarget_currentTween then flyTarget_currentTween:Cancel() end if connection then connection:Disconnect() end return false end task.wait() end
    if connection then connection:Disconnect() end
    return true
end

-- Flying Logic
local function flyTarget_startFly(statusLabel, startBtn, heightBox, speedBox)
    if flyTarget_isFlying then return end
    local targetPart = flyTarget_getTargetPart(flyTarget_selectedPlayer)
    if not flyTarget_selectedPlayer or not targetPart then statusLabel.Text = "Lỗi: Không tìm thấy người chơi hoặc xác!"; return end
    if not GetChar() or not Root() then return end
    local hrp = Root()
    local flyHeight = tonumber(heightBox.Text) or 150
    local flySpeed = tonumber(speedBox.Text) or 100
    flyTarget_isFlying=true; flyTarget_stopRequested=false
    startBtn.Text="DỪNG BAY (STOP)"; startBtn.BackgroundColor3=C.RED; startBtn.TextColor3=C.WHITE
    flyTarget_setNoclip(true)
    local oldGravity=workspace.Gravity; workspace.Gravity=0
    statusLabel.Text="Đang bay lên..."; local skyPos=hrp.Position+Vector3.new(0,flyHeight,0)
    local success1=flyTarget_tweenToTarget(hrp, CFrame.new(skyPos), flySpeed)
    if success1 and not flyTarget_stopRequested then
        targetPart = flyTarget_getTargetPart(flyTarget_selectedPlayer)
        if targetPart then
            statusLabel.Text="Đang di chuyển tới vị trí..."; local targetOverhead=targetPart.Position+Vector3.new(0,flyHeight,0)
            local success2=flyTarget_tweenToTarget(hrp, CFrame.new(targetOverhead), flySpeed)
            if success2 and not flyTarget_stopRequested then
                targetPart = flyTarget_getTargetPart(flyTarget_selectedPlayer)
                if targetPart then statusLabel.Text="Đang hạ cánh xuống..."; local targetLandPos=targetPart.Position+Vector3.new(0,3,0); flyTarget_tweenToTarget(hrp, CFrame.new(targetLandPos), flySpeed) end
            end
        end
    end
    workspace.Gravity=oldGravity; flyTarget_resetCharacterPhysics(); flyTarget_isFlying=false
    startBtn.Text="BẮT ĐẦU BAY"; startBtn.BackgroundColor3=C.WHITE; startBtn.TextColor3=C.DARK
    if flyTarget_stopRequested then statusLabel.Text="Đã dừng bay an toàn!" else statusLabel.Text="Đã đến vị trí mục tiêu!" end
end
