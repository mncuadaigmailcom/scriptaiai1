local function ftpResetPhysics()
    if ftpNcConn then ftpNcConn:Disconnect(); ftpNcConn = nil end
    local hrp = Root()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        local op = OverlapParams.new(); op.FilterDescendantsInstances = {GetChar()}; op.FilterType = Enum.RaycastFilterType.Exclude
        if #workspace:GetPartsInPart(hrp, op) > 0 then
            for i = 1, 5 do hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0); if #workspace:GetPartsInPart(hrp, op) == 0 then break end end
        end
    end
    local c = GetChar()
    if c then for _, p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end end
    if S.noClip then EnNC() end -- Bật lại noclip mặc định nếu đang bật ở tab di chuyển
end

