-- Update Functions
function updatePlayerList()
    for _, child in pairs(FlyPlayerList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end
    
    local filterText = string.lower(FlySearchBox.Text)
    local count = 0
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            local nameMatch = string.find(string.lower(plr.Name), filterText, 1, true)
            local displayMatch = string.find(string.lower(plr.DisplayName), filterText, 1, true)
            
            if filterText == "" or nameMatch or displayMatch then
                count = count + 1
                local isEven = (count % 2 == 0)
                local isDead = isPlayerDeadOrKnocked(plr)
                local isSelected = (selectedPlayer == plr)
                
                local ItemContainer = New("Frame", {
                    Size=UDim2.new(1,0,0,28),
                    BackgroundColor3=isSelected and WATER_BLUE or (isEven and COLOR_STRIPE_EVEN or COLOR_STRIPE_ODD),
                    BackgroundTransparency=isSelected and 0.25 or 0.45,
                    BorderSizePixel=0,
                }, FlyPlayerList)
                
                local NameBtn = New("TextButton", {
                    Size=isSelected and UDim2.new(0.62,0,1,0) or UDim2.new(1,0,1,0),
                    BackgroundTransparency=1,
                    Font=Enum.Font.SourceSansBold,
                    TextSize=12,
                    TextXAlignment=Enum.TextXAlignment.Left,
                }, ItemContainer)
                
                if isDead then
                    NameBtn.Text = "  🔴 [GỤC/CỨU] " .. plr.DisplayName
                    NameBtn.TextColor3 = isSelected and TEXT_LIGHT or COLOR_DEAD
                else
                    NameBtn.Text = "  👤 " .. plr.DisplayName
                    NameBtn.TextColor3 = isSelected and TEXT_LIGHT or TEXT_DARK
                end
                
                NameBtn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    if S.followPlayerActive then startFollow() end
                    updatePlayerList()
                end)
                
                if isSelected then
                    local FlyBtn = New("TextButton", {
                        Size=UDim2.new(0.35,-4,0.8,0),
                        Position=UDim2.new(0.64,0,0.1,0),
                        Font=Enum.Font.SourceSansBold,
                        TextSize=11,
                        TextColor3=TEXT_LIGHT,
                    }, ItemContainer)
                    Corner(FlyBtn, UDim.new(0,4))
                    
                    if isFlying and selectedPlayer == plr then
                        FlyBtn.Text = "🛑 Dừng Bay"
                        FlyBtn.BackgroundColor3 = Color3.fromRGB(220,50,50)
                    else
                        FlyBtn.Text = "🚀 Bay Tới"
                        FlyBtn.BackgroundColor3 = COLOR_GREEN
                    end
                    
                    FlyBtn.MouseButton1Click:Connect(function()
                        if isFlying then
                            stopFlyToTarget()
                        else
                            startFlyToTarget("Player", plr)
                        end
                    end)
                end
            end
        end
    end
    FlyPlayerList.CanvasSize = UDim2.new(0,0,0,count*28)
end

function updateSavedList()
    for _, child in pairs(FlySavedList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end
    
    for idx, item in ipairs(savedLocations) do
        local isEven = (idx % 2 == 0)
        local isSelected = (selectedLocation == item)
        
        local Container = New("Frame", {
            Size=UDim2.new(1,0,0,28),
            BackgroundColor3=isSelected and COLOR_GREEN or (isEven and COLOR_STRIPE_EVEN or COLOR_STRIPE_ODD),
            BackgroundTransparency=isSelected and 0.25 or 0.45,
            BorderSizePixel=0,
        }, FlySavedList)
        
        local SelectBtn = New("TextButton", {
            Size=UDim2.new(0.55,0,1,0),
            BackgroundTransparency=1,
            Text=string.format(" 📍 %s", item.name),
            TextColor3=isSelected and TEXT_LIGHT or TEXT_DARK,
            Font=Enum.Font.SourceSansBold,
            TextSize=12,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, Container)
        
        local FlyDirectBtn = New("TextButton", {
            Size=UDim2.new(0.25,0,0.8,0),
            Position=UDim2.new(0.56,0,0.1,0),
            Font=Enum.Font.SourceSansBold,
            TextSize=11,
            TextColor3=TEXT_LIGHT,
        }, Container)
        Corner(FlyDirectBtn, UDim.new(0,4))
        
        if isFlying and selectedLocation == item then
            FlyDirectBtn.Text = "🛑 Dừng"
            FlyDirectBtn.BackgroundColor3 = Color3.fromRGB(220,50,50)
        else
            FlyDirectBtn.Text = "🚀 Bay"
            FlyDirectBtn.BackgroundColor3 = COLOR_GREEN
        end
        
        local DeleteBtn = New("TextButton", {
            Size=UDim2.new(0.16,-4,0.8,0),
            Position=UDim2.new(0.82,0,0.1,0),
            BackgroundColor3=Color3.fromRGB(220,60,60),
            BackgroundTransparency=0.2,
            Text="Xóa",
            TextColor3=TEXT_LIGHT,
            Font=Enum.Font.SourceSansBold,
            TextSize=11,
        }, Container)
        Corner(DeleteBtn, UDim.new(0,4))
        
        SelectBtn.MouseButton1Click:Connect(function()
            selectedLocation = item
            updateSavedList()
        end)
        
        FlyDirectBtn.MouseButton1Click:Connect(function()
            selectedLocation = item
            if isFlying then
                stopFlyToTarget()
            else
                startFlyToTarget("Location", item)
            end
        end)
        
        DeleteBtn.MouseButton1Click:Connect(function()
            if selectedLocation == item then selectedLocation = nil end
            removeLocESP(item)
            table.remove(savedLocations, idx)
            updateSavedList()
        end)
    end
    FlySavedList.CanvasSize = UDim2.new(0,0,0,#savedLocations*28)
end

