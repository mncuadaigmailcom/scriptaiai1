-- Xử lý Logic Bay Săn Mục Tiêu
local function runFlyToPlayer()
    if S.targetFlying then return end
    local targetPart = getTargetPart(S.targetPlayer)
    if not S.targetPlayer or not targetPart then
        flyTargetStatus.Text = "❌ Lỗi: Chưa chọn mục tiêu hợp lệ!"
        return
    end

    local char = GetChar()
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local flyHeight = tonumber(heightBox.Text) or 150
    local flySpeed = tonumber(speedBox.Text) or 120

    S.targetHeight = flyHeight
    S.targetSpeed = flySpeed
    S.targetFlying = true
    S.targetStopRequested = false

    flyTargetMasterBtn.Text = "🛑 DỪNG BAY SĂN"
    flyTargetMasterBtn.BackgroundColor3 = C.RED
    EnNC()

    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Phase 1: Bốc đầu cất cánh thẳng đứng
    flyTargetStatus.Text = "🛫 Pha 1: Đang bốc đầu cất cánh..."
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local p1 = cruiseTween(hrp, CFrame.new(skyPos), flySpeed)

    -- Phase 2: Glide ngang đến tọa độ đầu mục tiêu
    if p1 and not S.targetStopRequested then
        targetPart = getTargetPart(S.targetPlayer)
        if targetPart then
            flyTargetStatus.Text = "✈️ Pha 2: Đang bay hành trình..."
            local cruisePos = targetPart.Position + Vector3.new(0, flyHeight, 0)
            local p2 = cruiseTween(hrp, CFrame.new(cruisePos), flySpeed)

            -- Phase 3: Hạ cánh thẳng đứng xuống mục tiêu
            if p2 and not S.targetStopRequested then
                targetPart = getTargetPart(S.targetPlayer)
                if targetPart then
                    flyTargetStatus.Text = "🛬 Pha 3: Đang hạ cánh thẳng đứng..."
                    local landPos = targetPart.Position + Vector3.new(0, 3, 0)
                    cruiseTween(hrp, CFrame.new(landPos), flySpeed)
                end
            end
        end
    end

    workspace.Gravity = oldGravity
    resetCharacterPhysics()
    S.targetFlying = false
    
    flyTargetMasterBtn.Text = "BẮT ĐẦU BAY"
    flyTargetMasterBtn.BackgroundColor3 = C.GREEN
    
    if S.targetStopRequested then
        flyTargetStatus.Text = "⏹️ Đã dừng bay khẩn cấp & chống kẹt!"
    else
        flyTargetStatus.Text = "✅ Đã hạ cánh an toàn xuống mục tiêu!"
    end
end

flyTargetMasterBtn.Activated:Connect(function()
    if S.targetFlying then
        S.targetStopRequested = true
        resetCharacterPhysics()
    else
