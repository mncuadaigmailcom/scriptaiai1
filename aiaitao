-- Fly to player logic
local function startFlyToPlayer()
    if F.isFlying then return end

    local targetPart = getTargetPart(F.selectedPlayer)
    if not F.selectedPlayer or not targetPart then
        ftStatusLabel.Text = "⚠️ Chưa chọn người chơi!"
        return
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local flyHeight = tonumber(ftHeightBox.Text) or 150
    local flySpeed = tonumber(ftSpeedBox.Text) or 100

    F.isFlying = true
    F.stopRequested = false
    ftStartBtn.Text = "⏹ DỪNG BAY"
    ftStartBtn.BackgroundColor3 = C.RED

    -- Enable noclip
    F.noclipConnection = RunService.Stepped:Connect(function()
        if player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Phase 1: Fly up
    ftStatusLabel.Text = "⏫ Đang bay lên..."
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local dist1 = (skyPos - hrp.Position).Magnitude
    local tween1 = TweenService:Create(hrp, TweenInfo.new(dist1 / flySpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(skyPos)})
    tween1:Play()
    tween1.Completed:Wait()
    
    if F.stopRequested then
        workspace.Gravity = oldGravity
        if F.noclipConnection then F.noclipConnection:Disconnect(); F.noclipConnection = nil end
        F.isFlying = false
        ftStartBtn.Text = "▶ BẮT ĐẦU BAY"
        ftStartBtn.BackgroundColor3 = C.GREEN
        return
    end

    -- Phase 2: Fly to target
    targetPart = getTargetPart(F.selectedPlayer)
    if targetPart and not F.stopRequested then
        ftStatusLabel.Text = "➡️ Đang di chuyển..."
        local targetOverhead = targetPart.Position + Vector3.new(0, flyHeight, 0)
        local dist2 = (targetOverhead - hrp.Position).Magnitude
        local tween2 = TweenService:Create(hrp, TweenInfo.new(dist2 / flySpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetOverhead)})
        tween2:Play()
        tween2.Completed:Wait()
        
        -- Phase 3: Land
        if not F.stopRequested then
            targetPart = getTargetPart(F.selectedPlayer)
            if targetPart then
                ftStatusLabel.Text = "⏬ Đang hạ cánh..."
                local targetLand = targetPart.Position + Vector3.new(0, 3, 0)
                local dist3 = (targetLand - hrp.Position).Magnitude
                local tween3 = TweenService:Create(hrp, TweenInfo.new(dist3 / flySpeed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetLand)})
                tween3:Play()
                tween3.Completed:Wait()
            end
        end
    end

    -- Cleanup
    workspace.Gravity = oldGravity
    if F.noclipConnection then F.noclipConnection:Disconnect(); F.noclipConnection = nil end
    F.isFlying = false
    ftStartBtn.Text = "▶ BẮT ĐẦU BAY"
    ftStartBtn.BackgroundColor3 = C.GREEN
    
    if F.stopRequested then
        ftStatusLabel.Text = "⏹ Đã dừng bay!"
    else
        ftStatusLabel.Text = "✅ Đã đến nơi!"
    end
end

ftStartBtn.Activated:Connect(function()
