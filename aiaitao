-- Code execution logic
local curThread = nil
local cancelled = false

local function CancelExec()
    cancelled = true
    if curThread then
        task.cancel(curThread)
        curThread = nil
    end
    statusLbl.Text = "⏹ Đã dừng"
end

stopBtn.Activated:Connect(CancelExec)

runBtn.Activated:Connect(function()
    local code = codeIn.Text
    if #code == 0 then
        statusLbl.Text = "⚠️ Vui lòng nhập code!"
        return
    end
    
    CancelExec()
    cancelled = false
    statusLbl.Text = "⏳ Đang chạy..."
    
    curThread = task.spawn(function()
        local ok, err = pcall(function()
            local fn, loadErr = loadstring(code)
            if not fn then error(loadErr) end
            fn()
        end)
        
        if cancelled then
            statusLbl.Text = "⏹ Đã dừng"
        elseif ok then
            statusLbl.Text = "✅ Hoàn thành!"
        else
            statusLbl.Text = "❌ Lỗi: " .. tostring(err)
        end
        curThread = nil
    end)
end)

