-- Render Danh Sách Người Chơi
updatePlayerList = function()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end

    local filterText = string.lower(SearchBox.Text)
    local count = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local nameMatch = string.find(string.lower(plr.Name), filterText, 1, true)
            local displayMatch = string.find(string.lower(plr.DisplayName), filterText, 1, true)

            if filterText == "" or nameMatch or displayMatch then
                count = count + 1
                local isEven = (count % 2 == 0)
                local isDead = isPlayerDeadOrKnocked(plr)
                local isSelected = (selectedPlayer == plr)

                local ItemContainer = Instance.new("Frame")
                ItemContainer.Size = UDim2.new(1, 0, 0, 28)
                ItemContainer.BackgroundColor3 = isSelected and WATER_BLUE or (isEven and COLOR_STRIPE_EVEN or COLOR_STRIPE_ODD)
                ItemContainer.BackgroundTransparency = isSelected and 0.25 or 0.45
                ItemContainer.BorderSizePixel = 0
                ItemContainer.Parent = PlayerList

                local NameBtn = Instance.new("TextButton")
                NameBtn.Size = isSelected and UDim2.new(0.62, 0, 1, 0) or UDim2.new(1, 0, 1, 0)
                NameBtn.BackgroundTransparency = 1
                NameBtn.Font = Enum.Font.SourceSansBold
                NameBtn.TextSize = 12
                NameBtn.TextXAlignment = Enum.TextXAlignment.Left
                NameBtn.Parent = ItemContainer

                if isDead then
                    NameBtn.Text = "  🔴 [GỤC/CỨU] " .. plr.DisplayName
                    NameBtn.TextColor3 = isSelected and TEXT_LIGHT or COLOR_DEAD
                else
                    NameBtn.Text = "  👤 " .. plr.DisplayName
                    NameBtn.TextColor3 = isSelected and TEXT_LIGHT or TEXT_DARK
                end

                NameBtn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    updatePlayerList()
                end)

                if isSelected then
                    local FlyBtn = Instance.new("TextButton")
                    FlyBtn.Size = UDim2.new(0.35, -4, 0.8, 0)
                    FlyBtn.Position = UDim2.new(0.64, 0, 0.1, 0)
                    FlyBtn.Font = Enum.Font.SourceSansBold
                    FlyBtn.TextSize = 11
                    FlyBtn.TextColor3 = TEXT_LIGHT
                    FlyBtn.Parent = ItemContainer

                    local FlyCorner = Instance.new("UICorner")
                    FlyCorner.CornerRadius = UDim.new(0, 4)
                    FlyCorner.Parent = FlyBtn

                    if isFlying and selectedPlayer == plr then
                        FlyBtn.Text = "🛑 Dừng Bay"
                        FlyBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
                    else
                        FlyBtn.Text = "🚀 Bay Tới"
                        FlyBtn.BackgroundColor3 = COLOR_GREEN
                    end

                    FlyBtn.MouseButton1Click:Connect(function()
                        if isFlying then
                            stopFly()
                        else
                            startFly("Player", plr)
                        end
                    end)
                end
            end
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, count * 28)
end

