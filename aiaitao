-- ==================== NOCLIP SYSTEM ====================
local function updateNoclipState()
    if S.antiNoclipActive then
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        if not antiNoclipConnection then
            antiNoclipConnection = RunService.Stepped:Connect(function()
                local char = GetChar()
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.CanCollide = true
                        end
                    end
                end
            end)
        end
        return
    else
        if antiNoclipConnection then
            antiNoclipConnection:Disconnect()
            antiNoclipConnection = nil
        end
    end
    
    local shouldNoclip = S.noClip or S.followPlayerActive or S.flyToPlayerActive or isFlying
    
    if shouldNoclip then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = GetChar()
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        local char = GetChar()
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if part.Name == "HumanoidRootPart" then
                        part.CanCollide = false
                    else
                        part.CanCollide = true
                    end
                end
            end
        end
    end
end

