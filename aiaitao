-- ============================================
-- MODULE: ANIMATION CONTROLLER
-- ============================================
local Animation = {}
local ActiveTweens = {}

function Animation:Play(instance, props, duration, easing, callback)
    local tween = Util:Tween(instance, props, duration, easing)
    if callback then
        tween.Completed:Connect(function()
            callback()
        end)
    end
    return tween
end

function Animation:StopAll()
    for _, tween in pairs(ActiveTweens) do
        if tween.PlaybackState == Enum.PlaybackState.Playing then
            tween:Cancel()
        end
    end
    ActiveTweens = {}
end

function Animation:FadeIn(instance, duration)
    instance.Visible = true
    instance.BackgroundTransparency = 1
    instance.TextTransparency = 1
    return Animation:Play(instance, {
        BackgroundTransparency = instance.BackgroundTransparency == 1 and 0.5 or 0,
        TextTransparency = 0,
    }, duration or 0.3)
end

function Animation:FadeOut(instance, duration, callback)
    return Animation:Play(instance, {
        BackgroundTransparency = 1,
        TextTransparency = 1,
    }, duration or 0.3, nil, function()
        instance.Visible = false
        if callback then callback() end
    end)
end

function Animation:SlideIn(instance, direction, duration)
    local startPos
    if direction == "left" then
        startPos = UDim2.new(-1, 0, 0, 0)
    elseif direction == "right" then
        startPos = UDim2.new(1, 0, 0, 0)
    elseif direction == "up" then
        startPos = UDim2.new(0, 0, -1, 0)
    elseif direction == "down" then
        startPos = UDim2.new(0, 0, 1, 0)
    end
    
    instance.Position = startPos
    return Animation:Play(instance, {
        Position = UDim2.new(0, 0, 0, 0),
    }, duration or 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

