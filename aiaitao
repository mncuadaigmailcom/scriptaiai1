                if isDead then
                    Btn.Text = "🔴 [KO] " .. plr.DisplayName
                    Btn.TextColor3 = C.COLOR_DEAD
                else
                    Btn.Text = plr.DisplayName
                end

                if F.selectedPlayer == plr then
                    Btn.BackgroundColor3 = C.WATER_BLUE
                end

                Btn.MouseButton1Click:Connect(function()
                    F.selectedPlayer = plr
                    ftStatusLabel.Text = "🎯 Đã chọn: " .. plr.DisplayName
                    updatePlayerListFlyTo()
                end)
