local function EnFC()
    local cam=workspace.CurrentCamera
    if not cam then return end
    local r, h = Root(), Hum()
    if r then fcPos=r.Position+Vector3.new(0,5,0); r.Anchored=true end
    if h then h.AutoRotate=false; h.WalkSpeed=0; h.JumpPower=0 end
    cam.CameraType=Enum.CameraType.Scriptable; cam.FieldOfView=90; fcYaw=0; fcPitch=0
    UserInputService.MouseBehavior=Enum.MouseBehavior.LockCenter; UserInputService.MouseIconEnabled=false
    fcHUD.Visible=true; cross.Visible=true
    RunService:BindToRenderStep("FC", Enum.RenderPriority.Camera.Value, function(dt)
        if not S.freeCam then return end
        local d=UserInputService:GetMouseDelta()
        fcYaw=(fcYaw - d.X * 0.3)%360; fcPitch=math.clamp(fcPitch - d.Y * 0.3,-89,89)
        local cf=CFrame.new(fcPos) * CFrame.Angles(0,math.rad(fcYaw),0) * CFrame.Angles(math.rad(fcPitch),0,0)
        local sp=S.freeCamSpeed * dt
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then sp=sp * 3 end
        local m=Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then m+=cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then m-=cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then m-=cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then m+=cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then m+=Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then m-=Vector3.new(0,1,0) end
        fcPos+=m*sp
        cam.CFrame=CFrame.new(fcPos) * CFrame.Angles(0,math.rad(fcYaw),0) * CFrame.Angles(math.rad(fcPitch),0,0)
    end)
end
