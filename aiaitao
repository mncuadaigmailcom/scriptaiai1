RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- ESP Player
    if espAllActive or espSingleActive then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local shouldTrack = false
                if espAllActive then
                    shouldTrack = true
                elseif espSingleActive and selectedPlayer == plr then
                    shouldTrack = true
                end

                if shouldTrack and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    createESP(plr)
                    local data = espStorage[plr]
                    local targetHrp = plr.Character.HumanoidRootPart
                    local head = plr.Character:FindFirstChild("Head") or targetHrp
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")

                    data.Gui.Adornee = head
                    data.Gui.Parent = ScreenGui

                    local dist = myHrp and math.floor((targetHrp.Position - myHrp.Position).Magnitude) or 0
                    local hp = hum and math.floor(hum.Health) or 0
                    local maxHp = hum and math.floor(hum.MaxHealth) or 100

                    local isKnocked = isPlayerDeadOrKnocked(plr)

                    if isKnocked then
                        if not downedTimeTracker[plr] then
                            downedTimeTracker[plr] = tick()
                        end
                        local elapsed = math.floor(tick() - downedTimeTracker[plr])
                        data.Label.TextColor3 = COLOR_DEAD
                        data.Label.Text = string.format("🔴 [%s]\n⚡ BỊ HẠ GỤC (%ds) | HP: %d/%d\n📏 Khoảng cách: %dm", plr.DisplayName, elapsed, hp, maxHp, dist)
                    else
                        downedTimeTracker[plr] = nil
                        data.Label.TextColor3 = Color3.fromRGB(0, 255, 128)
                        data.Label.Text = string.format("👤 [%s]\n💚 HP: %d/%d\n📏 Khoảng cách: %dm", plr.DisplayName, hp, maxHp, dist)
                    end
                else
                    removeESP(plr)
                    downedTimeTracker[plr] = nil
                end
            else
                removeESP(plr)
            end
        end
    else
        if next(espStorage) ~= nil then removeAllESP() end
    end

    -- ESP Location
    if locEspAllActive or locEspSingleActive then
        for _, item in ipairs(savedLocations) do
            local shouldTrackLoc = false
            if locEspAllActive then
                shouldTrackLoc = true
            elseif locEspSingleActive and selectedLocation == item then
                shouldTrackLoc = true
            end

            if shouldTrackLoc then
                createLocESP(item)
                local data = locEspStorage[item]
                if data then
                    data.Attachment.WorldPosition = item.pos
                    local dist = myHrp and math.floor((item.pos - myHrp.Position).Magnitude) or 0
                    data.Label.Text = string.format("📍 [%s]\n📏 Khoảng cách: %dm", item.name, dist)
                end
            else
                removeLocESP(item)
            end
        end
    else
        if next(locEspStorage) ~= nil then removeAllLocESP() end
    end
end)

