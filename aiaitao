-- Populate player list
local function updatePlayerList()
    for _, child in ipairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            count = count + 1
            local btn = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = C.WHITE,
                TextColor3 = C.DARK,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                Text = plr.DisplayName .. " (@" .. plr.Name .. ")",
                BorderSizePixel = 0,
                ZIndex = 7,
            }, playerListFrame)
            Corner(btn, UDim.new(0, 4))
            
            btn.Activated:Connect(function()
                local targetPart = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        myRoot.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 5, 0))
                        print("✅ Đã dịch chuyển tới:", plr.DisplayName)
                    end
                end
            end)
        end
    end
    
    if count == 0 then
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 40),
            Text = "📭 Không có người chơi nào khác",
            BackgroundTransparency = 1,
            TextColor3 = C.GRAY,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 7,
        }, playerListFrame)
    end
    
    playerListFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(count, 1) * 31)
end

