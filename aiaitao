--- Safe Collision & Anti-Stuck System ---
local function resetCharacterPhysics()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local overlapParams = OverlapParams.new()
        overlapParams.FilterDescendantsInstances = {char}
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude

        local stuckParts = workspace:GetPartsInPart(hrp, overlapParams)
        if #stuckParts > 0 then
            for i = 1, 5 do
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                if #workspace:GetPartsInPart(hrp, overlapParams) == 0 then
                    break
                end
            end
        end
    end

    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
                part.CanCollide = true
            end
        end
    end
end

local function setNoclip(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        resetCharacterPhysics()
    end
end

--- Helper Tween Motion ---
local function tweenToTarget(hrp, targetCFrame, flySpeed)
    if stopRequested then return false end

    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed

    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()

    local finished = false
    local connection
    connection = currentTween.Completed:Connect(function()
        finished = true
    end)

    while not finished do
        if stopRequested then
            if currentTween then currentTween:Cancel() end
            if connection then connection:Disconnect() end
            return false
        end
        task.wait()
    end

    if connection then connection:Disconnect() end
    return true
end

--- Flying Logic (Đã hỗ trợ người bị gục/chết) ---
local function startFly()
    if isFlying then return end

    local targetPart = getTargetPart(selectedPlayer)
    if not selectedPlayer or not targetPart then
        StatusLabel.Text = "Lỗi: Không tìm thấy người chơi hoặc xác!"
        return
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local flyHeight = tonumber(HeightBox.Text) or 150
    local flySpeed = tonumber(SpeedBox.Text) or 100

    isFlying = true
    stopRequested = false

    StartBtn.Text = "DỪNG BAY (STOP)"
    StartBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    StartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    setNoclip(true)

    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Phase 1: Fly Up
    StatusLabel.Text = "Đang bay lên..."
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local success1 = tweenToTarget(hrp, CFrame.new(skyPos), flySpeed)

    -- Phase 2: Fly to Target Overhead (Cập nhật vị trí thực tế của xác)
    if success1 and not stopRequested then
        targetPart = getTargetPart(selectedPlayer)
        if targetPart then
            StatusLabel.Text = "Đang di chuyển tới vị trí..."
            local targetOverhead = targetPart.Position + Vector3.new(0, flyHeight, 0)
            local success2 = tweenToTarget(hrp, CFrame.new(targetOverhead), flySpeed)

            -- Phase 3: Land on Target
            if success2 and not stopRequested then
                targetPart = getTargetPart(selectedPlayer)
                if targetPart then
                    StatusLabel.Text = "Đang hạ cánh xuống..."
                    local targetLandPos = targetPart.Position + Vector3.new(0, 3, 0)
                    tweenToTarget(hrp, CFrame.new(targetLandPos), flySpeed)
                end
            end
        end
    end

    -- Khôi phục trạng thái an toàn
    workspace.Gravity = oldGravity
    resetCharacterPhysics()
    isFlying = false

    StartBtn.Text = "BẮT ĐẦU BAY"
    StartBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    StartBtn.TextColor3 = Color3.fromRGB(0, 0, 0)

    if stopRequested then
        StatusLabel.Text = "Đã dừng bay an toàn!"
    else
        StatusLabel.Text = "Đã đến vị trí mục tiêu!"
    end
end

