    for _, b in ipairs(tabs) do b.BackgroundColor3 = C.BG; b.BackgroundTransparency = 0.3 end
    if tabContent[index] and tabs[index] then tabContent[index].Visible = true; tabs[index].BackgroundColor3 = C.BLUE; tabs[index].BackgroundTransparency = 0.2 end
