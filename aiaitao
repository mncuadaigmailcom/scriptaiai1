-- Reset Physics Safe
local function resetCharacterPhysics()
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local overlapParams = OverlapParams.new()
        overlapParams.FilterDescendantsInstances = {char}
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude

        if #workspace:GetPartsInPart(hrp, overlapParams) > 0 then
            for i = 1, 5 do
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                if #workspace:GetPartsInPart(hrp, overlapParams) == 0 then break end
            end
        end
    end

    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
                part.CanCollide = true
            end
        end
    end
end

local function setNoclip(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    else
        resetCharacterPhysics()
    end
end

local function tweenToTarget(hrp, targetCFrame, flySpeed)
    if stopRequested then return false end

    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed

    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()

    local finished = false
    local connection
    connection = currentTween.Completed:Connect(function() finished = true end)

    while not finished do
        if stopRequested then
            if currentTween then currentTween:Cancel() end
            if connection then connection:Disconnect() end
            return false
        end
        task.wait()
    end

    if connection then connection:Disconnect() end
    return true
end

-- Core Flying
startFly = function()
    if isFlying then return end

    local getTargetPos = nil
    local targetName = ""

    if activeTab == "Players" then
        if not selectedPlayer then
            P_StatusLabel.Text = "Lỗi: Vui lòng chọn một người chơi!"
            return
        end
        getTargetPos = function()
            local p = getTargetPart(selectedPlayer)
            return p and p.Position
        end
        targetName = selectedPlayer.DisplayName
    else
        if not selectedLocation then
            L_StatusLabel.Text = "Lỗi: Vui lòng chọn một tọa độ!"
            return
        end
        getTargetPos = function()
            return selectedLocation.pos
        end
        targetName = selectedLocation.name
    end

    if not getTargetPos() then
        if activeTab == "Players" then P_StatusLabel.Text = "Lỗi: Không tìm thấy vị trí target!" else L_StatusLabel.Text = "Lỗi: Không tìm thấy vị trí target!" end
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local flyHeight = tonumber(P_HeightBox.Text) or 150
    local flySpeed = tonumber(P_SpeedBox.Text) or 100

    isFlying = true
    stopRequested = false
    updateMainStartButton()

    setNoclip(true)
    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    local currentStatusLabel = (activeTab == "Players") and P_StatusLabel or L_StatusLabel

    currentStatusLabel.Text = "Đang bay lên cao..."
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local ok1 = tweenToTarget(hrp, CFrame.new(skyPos), flySpeed)

    if ok1 and not stopRequested then
        currentStatusLabel.Text = "Đang di chuyển tới: " .. targetName
        local dest = getTargetPos()
        if dest then
            local overhead = dest + Vector3.new(0, flyHeight, 0)
            local ok2 = tweenToTarget(hrp, CFrame.new(overhead), flySpeed)

            if ok2 and not stopRequested then
                currentStatusLabel.Text = "Đang hạ cánh..."
                dest = getTargetPos()
                if dest then
                    local landPos = dest + Vector3.new(0, 3, 0)
                    tweenToTarget(hrp, CFrame.new(landPos), flySpeed)
                end
            end
        end
    end

    workspace.Gravity = oldGravity
    resetCharacterPhysics()
    isFlying = false
    updateMainStartButton()

    if stopRequested then
        currentStatusLabel.Text = "Đã dừng bay an toàn!"
    else
        currentStatusLabel.Text = "Đã đến nơi: " .. targetName
    end
end

local function handleStartClick()
    if isFlying then
        stopRequested = true
        if currentTween then currentTween:Cancel() end
        resetCharacterPhysics()
    else
        startFly()
    end
end

P_StartBtn.MouseButton1Click:Connect(handleStartClick)
L_StartBtn.MouseButton1Click:Connect(handleStartClick)
