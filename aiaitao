local function updatePlayersLayout()
    local leftRatio = math.clamp(splitRatio, minSplit, maxSplit)
    local rightRatio = 1 - leftRatio - 0.02

    SearchBox.Size = UDim2.new(leftRatio * 0.68, 0, 0, 26)
    SearchBox.Position = UDim2.new(0, 0, 0, 0)

    RefreshBtn.Size = UDim2.new(leftRatio * 0.28, 0, 0, 26)
    RefreshBtn.Position = UDim2.new(leftRatio * 0.70, 0, 0, 0)

