-- Hàm thực thi code một lần, trả về true nếu thành công, false + lỗi nếu thất bại
local function executeOnce(code, name)
	if #name > 0 then
		print("👤 Tên người dùng:", name)
	end

	-- Dùng pcall để bắt lỗi
	local success, result = pcall(function()
		local executor = loadstring or function(c) return loadstring(c) end
		local fn, err = executor(code)
		if not fn then
			error("Lỗi biên dịch: " .. tostring(err))
		end
		fn()
	end)

	if success then
		return true
	else
		return false, result
	end
end

-- Nút chạy code (có lặp)
runButton.MouseButton1Click:Connect(function()
	local code = codeBox.Text
	local name = nameBox.Text
	local loopStr = loopBox.Text

	if #code == 0 then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end

	-- Xác định số lần lặp
	local loopCount = 1
	if #loopStr > 0 then
		loopCount = tonumber(loopStr)
		if not loopCount or loopCount <= 0 then
			statusLabel.Text = "⚠️ Số lần lặp không hợp lệ (phải là số > 0)"
			return
		end
		if loopCount > 1000 then
			statusLabel.Text = "⚠️ Tối đa 1000 lần lặp để tránh lag"
			return
		end
	end

	-- Đếm số lần thành công/thất bại trong lần chạy này
	local successCount = 0
	local failCount = 0

	for i = 1, loopCount do
		local ok, err = executeOnce(code, name)
		if ok then
			successCount = successCount + 1
		else
			failCount = failCount + 1
			warn("Lần chạy thứ " .. i .. " lỗi:", err)
		end
	end

	-- Cập nhật tổng số lần đã chạy
	totalExecutions = totalExecutions + loopCount
	countLabel.Text = "🔄 Tổng số lần đã chạy: " .. totalExecutions

	-- Hiển thị kết quả của lần chạy này
	if failCount == 0 then
		statusLabel.Text = "✅ Đã chạy " .. loopCount .. " lần, tất cả thành công! (Xem Output)"
	else
		statusLabel.Text = "⚠️ Chạy " .. loopCount .. " lần: " .. successCount .. " thành công, " .. failCount .. " thất bại."
	end
end)
