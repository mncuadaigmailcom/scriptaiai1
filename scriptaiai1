-- Hàm thực thi code một lần
local function executeOnce(code, name)
	if #name > 0 then
		print("👤 Tên người dùng:", name)
	end
	local success, result = pcall(function()
		local executor = loadstring or function(c) return loadstring(c) end
		local fn, err = executor(code)
		if not fn then
			error("Lỗi biên dịch: " .. tostring(err))
		end
		fn()
	end)
	if success then
		return true
	else
		return false, result
	end
end

-- Nút chạy code với lặp và delay
runButton.MouseButton1Click:Connect(function()
	local code = codeBox.Text
	local name = nameBox.Text
	local loopStr = loopBox.Text
	local delayStr = delayBox.Text
	local unit = unitButton.Text

	if #code == 0 then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end

	local loopCount = 1
	if #loopStr > 0 then
		loopCount = tonumber(loopStr)
		if not loopCount or loopCount <= 0 then
			statusLabel.Text = "⚠️ Số lần lặp không hợp lệ (phải là số > 0)"
			return
		end
		if loopCount > 1000 then
			statusLabel.Text = "⚠️ Tối đa 1000 lần lặp để tránh lag"
			return
		end
	end

	local delaySeconds = 0
	if #delayStr > 0 then
		delaySeconds = tonumber(delayStr)
		if not delaySeconds or delaySeconds < 0 then
			statusLabel.Text = "⚠️ Thời gian chờ không hợp lệ (phải là số >= 0)"
			return
		end
		if unit == "Phút" then
			delaySeconds = delaySeconds * 60
		end
	end

	statusLabel.Text = "⏳ Đang thực thi..."
	local successCount = 0
	local failCount = 0

	for i = 1, loopCount do
		if i > 1 and delaySeconds > 0 then
			task.wait(delaySeconds)
		end
		local ok, err = executeOnce(code, name)
		if ok then
			successCount = successCount + 1
		else
			failCount = failCount + 1
			warn("Lần chạy thứ " .. i .. " lỗi:", err)
		end
		statusLabel.Text = string.format("⏳ Đang chạy %d/%d...", i, loopCount)
	end

	totalExecutions = totalExecutions + loopCount
	countLabel.Text = "🔄 Tổng số lần đã chạy: " .. totalExecutions

	if failCount == 0 then
		statusLabel.Text = string.format("✅ Hoàn tất %d lần, tất cả thành công!", loopCount)
	else
		statusLabel.Text = string.format("⚠️ Hoàn tất %d lần: %d thành công, %d thất bại.", loopCount, successCount, failCount)
	end
end)
