		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

		local scriptButton = Instance.new("TextButton")
		scriptButton.Size = UDim2.new(1, -30, 1, 0)
		scriptButton.Position = UDim2.new(0, 0, 0, 0)
		scriptButton.Text = scriptData.name
		scriptButton.BackgroundTransparency = 1
		scriptButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		scriptButton.Font = Enum.Font.SourceSans
		scriptButton.TextSize = 13
		scriptButton.TextXAlignment = Enum.TextXAlignment.Left
		scriptButton.BorderSizePixel = 0
		scriptButton.Parent = row

		local deleteButton = Instance.new("TextButton")
		deleteButton.Size = UDim2.new(0, 24, 0, 24)
		deleteButton.Position = UDim2.new(1, -28, 0.5, -12)
		deleteButton.Text = "✕"
		deleteButton.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
		deleteButton.TextColor3 = Color3.fromRGB(255, 255, 255)
		deleteButton.Font = Enum.Font.SourceSansBold
		deleteButton.TextSize = 14
		deleteButton.BorderSizePixel = 0
		deleteButton.Parent = row
		Instance.new("UICorner", deleteButton).CornerRadius = UDim.new(1, 0)

		-- Nhấn vào tên script: điền tên + code, rồi chạy ngay
		scriptButton.MouseButton1Click:Connect(function()
			nameBox.Text = scriptData.name
			codeBox.Text = scriptData.code
			executeCurrentCode()
		end)

		deleteButton.MouseButton1Click:Connect(function()
			table.remove(savedScripts, i)
			rebuildScriptList()
			updateCanvasSize()
		end)
	end
	updateCanvasSize()
end

-- Nút lưu script
saveButton.MouseButton1Click:Connect(function()
	local currentName = nameBox.Text
	local currentCode = codeBox.Text
	if #currentCode == 0 then
		statusLabel.Text = "⚠️ Không có code để lưu!"
		return
	end
	if #currentName == 0 then
		currentName = "Script " .. (#savedScripts + 1)
	end
	-- Tránh trùng tên
	local baseName = currentName
	local counter = 1
	while true do
		local exists = false
		for _, s in ipairs(savedScripts) do
			if s.name == currentName then
				exists = true
				break
			end
		end
		if not exists then break end
		counter = counter + 1
		currentName = baseName .. " (" .. counter .. ")"
	end
	table.insert(savedScripts, {name = currentName, code = currentCode})
	rebuildScriptList()
	statusLabel.Text = "✅ Đã lưu: " .. currentName
	-- Tự động cuộn xuống cuối để thấy script vừa lưu
	scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.CanvasSize.Y.Offset)
end)

