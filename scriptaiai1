local isFogOn = false

local function tweenLighting(properties, duration)
	local tweenInfo = TweenInfo.new(duration or 1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	local goals = {}
	for prop, value in pairs(properties) do
		goals[prop] = value
	end
	local tween = TweenService:Create(lighting, tweenInfo, goals)
	tween:Play()
	return tween
end

local function setDark()
	animateButton(darkButton)
	tweenLighting({ClockTime = 0, Brightness = 0.3, OutdoorAmbient = Color3.fromRGB(20, 20, 40)}, 1.5)
end

local function setLight()
	animateButton(lightButton)
	tweenLighting({ClockTime = 14, Brightness = 1.2, OutdoorAmbient = Color3.fromRGB(180, 180, 180)}, 1.5)
end

local function toggleFog()
	animateButton(fogButton)
	isFogOn = not isFogOn
	fogButton.Text = isFogOn and "🌫️ Sương mù: BẬT" or "🌫️ Sương mù: TẮT"
	fogButton.BackgroundColor3 = isFogOn and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(45, 45, 45)
	if isFogOn then
		tweenLighting({FogStart = 0, FogEnd = 80, FogColor = Color3.fromRGB(180, 180, 180)}, 1)
	else
		tweenLighting({FogStart = 0, FogEnd = 100000, FogColor = Color3.fromRGB(255, 255, 255)}, 1)
	end
end

local function resetEnvironment()
	animateButton(resetEnvButton)
	setLight()
	if isFogOn then toggleFog() end
end

