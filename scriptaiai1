-- Biến đếm toàn cục
local executionCount = 0

-- Logic ẩn/hiện menu
local menuVisible = false
local function setMenuVisible(state)
	menuVisible = state
	mainFrame.Visible = state
	toggleButton.Text = state and "✕" or "⚙"
end

toggleButton.MouseButton1Click:Connect(function()
	setMenuVisible(not menuVisible)
end)
closeButton.MouseButton1Click:Connect(function()
	setMenuVisible(false)
end)

-- Chạy code + đếm số lần
runButton.MouseButton1Click:Connect(function()
	local code = codeBox.Text
	local name = nameBox.Text

	if #code == 0 then
		statusLabel.Text = "⚠️ Vui lòng nhập code!"
		return
	end

	if #name > 0 then
		print("👤 Tên người dùng:", name)
	end

	-- Tăng số lần chạy và cập nhật label
	executionCount = executionCount + 1
	countLabel.Text = "🔄 Số lần chạy: " .. executionCount

	-- Thực thi code (chỉ hoạt động khi có executor)
	local success, result = pcall(function()
		local executor = loadstring or function(c) return loadstring(c) end
		local fn, err = executor(code)
		if not fn then
			error("Lỗi biên dịch: " .. tostring(err))
		end
		fn()
	end)

	if success then
		statusLabel.Text = "✅ Đã thực thi (xem Output)"
		print("✅ [Executor] Hoàn tất.")
	else
		statusLabel.Text = "❌ Lỗi: " .. tostring(result)
		warn("❌ Lỗi thực thi:", result)
	end
end)
