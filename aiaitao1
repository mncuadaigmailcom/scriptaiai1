runBtn.Activated:Connect(function()
    local t = math.clamp(tonumber(repIn.Text) or 1, 1, 1000)
    local d = math.max(tonumber(delIn.Text) or 0, 0)
    if unitBtn.Text:find("Phút") then d = d * 60 end

    local code = codeIn.Text
    local name = nameIn.Text

    if #code == 0 then
        statusLbl.Text = "⚠️ Vui lòng nhập code!"
        return
    end

    cancelled = false
    statusLbl.Text = "⏳ Đang thực thi..."

    spawn(function()
        for i = 1, t do
            if cancelled then break end
            if i > 1 and d > 0 then
                local e = 0
                while e < d do
                    if cancelled then break end
                    wait(0.1)
                    e = e + 0.1
                end
                if cancelled then break end
            end

            local ok, err = pcall(function()
                local fn, loadErr = loadstring(code)
                if not fn then error(loadErr) end
                fn()
            end)

            if not ok then
                warn("❌ Lần", i, err)
            end
        end

        if not cancelled then
            statusLbl.Text = "✅ Hoàn thành!"
        end
        totalRuns = totalRuns + t
        countLbl.Text = "🔄 Tổng số lần đã chạy: " .. totalRuns
    end)
end)

