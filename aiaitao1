                    local fn = loadstring(code)
                    if fn then fn() end
                end)
                
                if success then
                    statusLabel.Text = "✅ Hoàn thành!"
                    statusLabel.TextColor3 = THEME.SUCCESS
                else
                    statusLabel.Text = "❌ Lỗi: " .. tostring(err)
                    statusLabel.TextColor3 = THEME.DANGER
                end
                
                State.totalRuns = State.totalRuns + 1
            end)
        end)
        
        stopBtn.MouseButton1Click:Connect(function()
            statusLabel.Text = "⏹ Đã dừng"
            statusLabel.TextColor3 = THEME.WARNING
        end)
        
        codeTab.CanvasSize = UDim2.new(0, 0, 0, y + 40)
    end
    
    buildCodeTab()
    
    -- ==================== UI EVENTS ====================
    -- Toggle menu
    toggleBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
        toggleBtn.Text = MainFrame.Visible and "✕" or "🍌"
    end)
    
    -- Drag functionality
    local dragging = false
    local dragStart, startPos
    
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, 
                                          startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Resize functionality
    UserInputService.InputChanged:Connect(function(input)
        if resizeState.active and input.UserInputType == Enum.UserInputType.MouseMovement then
            local currentMouse = UserInputService:GetMouseLocation()
            local delta = currentMouse - resizeState.startMouse
            
            local newW = resizeState.startSize.X
            local newH = resizeState.startSize.Y
            local newX = resizeState.startPos.X
            local newY = resizeState.startPos.Y
            
            if resizeState.corner == "BR" then
                newW = math.max(minSize.X, resizeState.startSize.X + delta.X)
                newH = math.max(minSize.Y, resizeState.startSize.Y + delta.Y)
            elseif resizeState.corner == "BL" then
                newW = math.max(minSize.X, resizeState.startSize.X - delta.X)
                newH = math.max(minSize.Y, resizeState.startSize.Y + delta.Y)
                newX = resizeState.startPos.X + (resizeState.startSize.X - newW)
            elseif resizeState.corner == "TR" then
                newW = math.max(minSize.X, resizeState.startSize.X + delta.X)
                newH = math.max(minSize.Y, resizeState.startSize.Y - delta.Y)
                newY = resizeState.startPos.Y + (resizeState.startSize.Y - newH)
            elseif resizeState.corner == "TL" then
                newW = math.max(minSize.X, resizeState.startSize.X - delta.X)
                newH = math.max(minSize.Y, resizeState.startSize.Y - delta.Y)
                newX = resizeState.startPos.X + (resizeState.startSize.X - newW)
                newY = resizeState.startPos.Y + (resizeState.startSize.Y - newH)
            end
            
            MainFrame.Size = UDim2.new(0, newW, 0, newH)
            MainFrame.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizeState.active = false
        end
    end)
    
    -- Close button
    closeBtn.MouseButton1Click:Connect(function()
        Flight.stopFly()
        Flight.stopFollow()
        State.antiNoclipActive = false
        Noclip.update()
        
        for plr in pairs(State.esp.players.cache) do
            ESP.removePlayerESP(plr)
        end
        for item in pairs(State.esp.locations.cache) do
            ESP.removeLocationESP(item)
        end
        for item in pairs(State.esp.walls.cache) do
            ESP.removeWallESP(item)
        end
        
        for _, item in ipairs(State.spawnedWalls) do
            Util.cleanupObject(item.part)
        end
        
        Util.cleanupObject(State.glowLight)
        Util.cleanupObject(State.heightPillar)
        if State.heightConn then State.heightConn:Disconnect() end
        
        ScreenGui:Destroy()
    end)
    
    return {
        updatePlayerList = updatePlayerList,
        updateSavedList = updateSavedList,
        updateWallList = updateWallList,
    }
end

