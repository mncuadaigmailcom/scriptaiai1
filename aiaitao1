local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- Biến cấu hình
local FlySpeed = 100 -- Tốc độ bay (có thể đổi tùy ý)
local isFlying = false -- Trạng thái có đang bay hay không
local targetPlayer = nil -- Người chơi mục tiêu

-- Hàm để tìm người chơi từ con trỏ chuột (Raycast)
local function getPlayerAtMouse()
	local mouse = player:GetMouse()
	if mouse.Target then
		local characterModel = mouse.Target:FindFirstAncestorWhichIsA("Model")
		if characterModel then
			local targetHumanoid = characterModel:FindFirstChildOfClass("Humanoid")
			if targetHumanoid then
				return Players:GetPlayerFromCharacter(characterModel)
			end
		end
	end
	return nil
end

-- Bắt sự kiện click chuột trái để chọn mục tiêu và bắt đầu bay
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end -- Không chạy nếu đang gõ chat
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local clickedPlayer = getPlayerAtMouse()
		
		if clickedPlayer and clickedPlayer ~= player then
			targetPlayer = clickedPlayer
			isFlying = true
			print("Đang bay tới: " .. targetPlayer.Name)
			
			-- (Tùy chọn) Thông báo hoặc hiệu ứng khi bắt đầu bay
			humanoid.PlatformStand = true -- Tắt trọng lực/vật lý thông thường để bay mượt hơn
		else
			-- Nếu click vào không khí hoặc chính mình thì dừng bay
			isFlying = false
			humanoid.PlatformStand = false
		end
	end
end)

-- Vòng lặp chính để xử lý việc di chuyển (Update mỗi frame)
RunService.RenderStepped:Connect(function()
	if isFlying and targetPlayer and targetPlayer.Character then
		local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		
		if targetHRP then
			-- Tính toán hướng bay
			local direction = (targetHRP.Position - humanoidRootPart.Position).Unit
			
			-- Cập nhật vị trí (Bay thẳng tới vị trí của mục tiêu)
			-- CFrame.new(vị trí, LookAt) giúp nhân vật quay mặt tới mục tiêu
			humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position + direction * (FlySpeed/60), targetHRP.Position)
		else
			-- Nếu mục tiêu chết hoặc mất nhân vật thì dừng
			isFlying = false
			humanoid.PlatformStand = false
		end
	end

	-- Cập nhật lại biến character nếu nhân vật bị thay đổi (hồi sinh)
	if not character or not character:IsDescendantOf(workspace) then
		character = player.Character
		if character then
			humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			humanoid = character:FindFirstChild("Humanoid")
		end
	end
end)
