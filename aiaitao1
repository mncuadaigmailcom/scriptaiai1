    SavedList.CanvasSize = UDim2.new(0, 0, 0, #State.savedLocations * 32)
end

function UIUpdate.refreshAll()
    UIUpdate.updatePlayerList()
    UIUpdate.updateSavedList()
end

-- ==================== REAL-TIME ESP UPDATE ====================
RunService.RenderStepped:Connect(function()
    ESP.updatePlayerESP()
    ESP.updateLocationESP()
    ESP.updateWallESP()
end)

-- ==================== EVENT HANDLERS ====================
RefreshBtn.Activated:Connect(UIUpdate.updatePlayerList)
SearchBox:GetPropertyChangedSignal("Text"):Connect(UIUpdate.updatePlayerList)

Players.PlayerAdded:Connect(function(plr)
    UIUpdate.updatePlayerList()
end)

Players.PlayerRemoving:Connect(function(plr)
    if State.selectedPlayer == plr then
        State.selectedPlayer = nil
        Flight.stopFollow()
    end
    ESP.removePlayerESP(plr)
    UIUpdate.updatePlayerList()
end)

LocalPlayer.CharacterAdded:Connect(function()
    State.isFlying = false
    State.isFollowing = false
    task.wait(0.3)
    Util.updateMovement()
    Noclip.update()
    updateGlow()
end)

