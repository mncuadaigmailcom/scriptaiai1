-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Cấu hình
local flySpeed = 0.8 -- Tốc độ bay (Có thể chỉnh tăng/giảm ở đây)
local mode = "OFF"   -- "UP", "DOWN", "FORWARD", "OFF"

local glassPlatform = nil
local noclipConnection = nil
local moveConnection = nil

----------------------------------------------------
-- HÀM LẤY CoreGui HOẶC PlayerGui (CHỐNG LỖI MENU)
----------------------------------------------------
local function getGuiParent()
	local success, result = pcall(function()
		return (gethui and gethui()) or CoreGui
	end)
	if success and result then
		return result
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local TargetParent = getGuiParent()

-- Xóa GUI cũ nếu đã chạy script trước đó
if TargetParent:FindFirstChild("GlassNoclipV2") then
	TargetParent.GlassNoclipV2:Destroy()
end

