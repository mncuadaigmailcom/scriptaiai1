-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Variables
local mode = "OFF" -- "UP", "DOWN", "FORWARD", "OFF"
local flySpeed = 0.8 -- Tốc độ bay (có thể điều chỉnh)
local glassPlatform = nil
local noclipConnection = nil
local moveConnection = nil

-- Cập nhật Character khi bị reset/chết
LocalPlayer.CharacterAdded:Connect(function(newChar)
	Character = newChar
	HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
end)

-- Hàm tạo tấm kính dưới chân
local function createGlass()
	if not glassPlatform or not glassPlatform.Parent then
		glassPlatform = Instance.new("Part")
		glassPlatform.Name = "GlassPlatform_Script"
		glassPlatform.Size = Vector3.new(5, 0.4, 5) -- Kích thước tấm kính
		glassPlatform.Material = Enum.Material.Glass
		glassPlatform.Transparency = 0.4 -- Độ trong suốt của kính
		glassPlatform.Color = Color3.fromRGB(0, 255, 255) -- Màu kính (Xanh lam)
		glassPlatform.Anchored = true
		glassPlatform.CanCollide = true
		glassPlatform.Parent = workspace
	end
end

-- Hàm dừng tất cả tính năng
local function stopAll()
	mode = "OFF"
	
	if moveConnection then moveConnection:Disconnect() moveConnection = nil end
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
	
	if glassPlatform then
		glassPlatform:Destroy()
		glassPlatform = nil
	end
	
	-- Bật lại va chạm cho nhân vật
	if Character then
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

-- Hàm kích hoạt chế độ bay & xuyên tường
local function startAction(newMode)
	stopAll() -- Dọn dẹp trạng thái cũ trước
	mode = newMode
	createGlass()

	-- Vòng lặp tính năng Xuyên Tường (Noclip)
	noclipConnection = RunService.Stepped:Connect(function()
		if Character then
			for _, part in pairs(Character:GetDescendants()) do
				if part:IsA("BasePart") and part ~= glassPlatform then
					part.CanCollide = false
				end
			end
		end
	end)

	-- Vòng lặp Di chuyển & Cập nhật tấm kính
	moveConnection = RunService.Heartbeat:Connect(function()
		if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
		local hrp = Character.HumanoidRootPart

		-- Di chuyển tấm kính luôn nằm dưới chân
		if glassPlatform then
			glassPlatform.CFrame = hrp.CFrame * CFrame.new(0, -3.2, 0)
		end

		-- Xử lý hướng di chuyển xuyên tường
		if mode == "UP" then
			hrp.CFrame = hrp.CFrame + Vector3.new(0, flySpeed, 0)
		elseif mode == "DOWN" then
			hrp.CFrame = hrp.CFrame - Vector3.new(0, flySpeed, 0)
		elseif mode == "FORWARD" then
			hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * flySpeed)
		end
	end)
end

