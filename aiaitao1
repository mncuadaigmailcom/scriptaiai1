-- LOGIC BẬT/TẮT NOCLIP TỰ ĐỘNG (XUYÊN TƯỜNG)
---------------------------------------------------------
local function toggleNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        if LocalPlayer.Character then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end
end

---------------------------------------------------------
-- LOGIC BAY TỚI MỤC TIÊU (TWEEN SMOOTH)
---------------------------------------------------------
local function getTargetHRP(plr)
    if plr and plr.Character then
        return plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
    end
    return nil
end

local function stopFly()
    stopRequested = true
    if currentTween then currentTween:Cancel() end
    isFlying = false
    workspace.Gravity = 196.2
    toggleNoclip(false)
    FlyBtn.Text = "🚀 BAY TỚI TARGET"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 90)
end

local function startFly()
    if isFlying then stopFly() return end
    local targetHRP = getTargetHRP(selectedPlayer)
    local myHRP = getTargetHRP(LocalPlayer)

    if not targetHRP or not myHRP then return end

    isFlying = true
    stopRequested = false
    FlyBtn.Text = "🛑 DỪNG BAY"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)

    toggleNoclip(true)
    workspace.Gravity = 0

    local spd = tonumber(SpeedBox.Text) or 100
    local hgt = tonumber(HeightBox.Text) or 150

    local function tweenTo(cframe)
        if stopRequested then return false end
        local dist = (cframe.Position - myHRP.Position).Magnitude
        local dur = dist / spd
        currentTween = TweenService:Create(myHRP, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = cframe})
        currentTween:Play()
        
        local done = false
        local conn = currentTween.Completed:Connect(function() done = true end)
        while not done do
            if stopRequested then
                if currentTween then currentTween:Cancel() end
                if conn then conn:Disconnect() end
                return false
            end
            task.wait()
        end
        if conn then conn:Disconnect() end
        return true
    end

    task.spawn(function()
        -- 1. Bay thẳng lên trời
        local startPos = myHRP.Position
        local skyPos = Vector3.new(startPos.X, startPos.Y + hgt, startPos.Z)
        if tweenTo(CFrame.new(skyPos)) then
            -- 2. Bay ngang trên không tới đỉnh đầu đối phương
            targetHRP = getTargetHRP(selectedPlayer)
            if targetHRP then
                local targetPos = targetHRP.Position
                local overheadPos = Vector3.new(targetPos.X, skyPos.Y, targetPos.Z)
                if tweenTo(CFrame.new(overheadPos)) then
                    -- 3. Đánh đáp thẳng xuống sau lưng đối phương
                    targetHRP = getTargetHRP(selectedPlayer)
                    if targetHRP then
                        tweenTo(targetHRP.CFrame * CFrame.new(0, 0, 3))
                    end
                end
            end
        end
        stopFly()
    end)
end

---------------------------------------------------------
-- LOGIC BU NGƯỜI CHƠI (FOLLOW MAGNET)
---------------------------------------------------------
local function stopFollow()
    isFollowing = false
    workspace.Gravity = 196.2
    toggleNoclip(false)
    FollowBtn.Text = "🧲 BU NGƯỜI (FOLLOW): OFF"
    FollowBtn.BackgroundColor3 = Color3.fromRGB(60, 65, 80)
end

local function startFollow()
    if isFollowing then stopFollow() return end
    if not selectedPlayer then return end

    if isFlying then stopFly() end

    isFollowing = true
    FollowBtn.Text = "🧲 BU NGƯỜI (FOLLOW): ON"
    FollowBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    toggleNoclip(true)

    task.spawn(function()
        workspace.Gravity = 0
        while isFollowing and selectedPlayer do
            local myHRP = getTargetHRP(LocalPlayer)
            local targetHRP = getTargetHRP(selectedPlayer)

            if myHRP and targetHRP then
                local targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, 2)
                local dist = (myHRP.Position - targetCFrame.Position).Magnitude

                if dist > 2 then
                    local spd = tonumber(SpeedBox.Text) or 100
                    local dur = dist / spd
                    currentTween = TweenService:Create(myHRP, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                    currentTween:Play()
                    task.wait(dur)
                end
            else
                break
            end
            task.wait(0.1)
        end
        stopFollow()
    end)
end

