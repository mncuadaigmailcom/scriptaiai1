---------------------------------------------------------
local function stopFollow()
    followPlayerActive = false
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end

    updateNoclipState()

    if FollowPlayerBtn then
        FollowPlayerBtn.Text = "🧲 Bu Người Chơi: OFF"
        FollowPlayerBtn.BackgroundColor3 = Color3.fromRGB(220, 225, 235)
    end
end

local function startFollow()
    if not selectedPlayer or not selectedPlayer.Character then
        stopFollow()
        return
    end

    if isFlying then stopFly() end

    followPlayerActive = true
    FollowPlayerBtn.Text = "🧲 Bu Người Chơi: ON"
    FollowPlayerBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

    if followConnection then followConnection:Disconnect() end

    updateNoclipState()

    followConnection = RunService.Heartbeat:Connect(function(dt)
        if not followPlayerActive or not selectedPlayer or not selectedPlayer.Character then
            stopFollow()
            return
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local targetHrp = getTargetPart(selectedPlayer)

        if myHrp and targetHrp then
            myHrp.AssemblyLinearVelocity = Vector3.zero
            myHrp.AssemblyAngularVelocity = Vector3.zero

            local speed = tonumber(P_SpeedBox.Text) or 100
            local targetCFrame = targetHrp.CFrame * CFrame.new(0, 0, 2)
            local currentPos = myHrp.Position
            local targetPos = targetCFrame.Position

            local distance = (targetPos - currentPos).Magnitude

            if distance > 0.5 then
                local moveStep = math.min(distance, speed * dt)
                local newPos = currentPos + (targetPos - currentPos).Unit * moveStep
                myHrp.CFrame = CFrame.new(newPos, targetCFrame.Position + targetCFrame.LookVector * 10)
            else
                myHrp.CFrame = targetCFrame
            end
        else
            stopFollow()
        end
    end)
end

FollowPlayerBtn.MouseButton1Click:Connect(function()
    if followPlayerActive then
        stopFollow()
    else
        startFollow()
    end
end)

