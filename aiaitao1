-- TÍNH NĂNG 4 GÓC KÉO CO GIÃN
---------------------------------------------------------
local minSize = Vector2.new(480, 280)
local maxSize = Vector2.new(950, 650)

local activeResizeCorner = nil 
local resizeStartMousePos, resizeStartSize, resizeStartPos

local cornersInfo = {
    {Name = "TL", Icon = "◤", Pos = UDim2.new(0, 0, 0, 0)},
    {Name = "TR", Icon = "◥", Pos = UDim2.new(1, -20, 0, 0)},
    {Name = "BL", Icon = "◣", Pos = UDim2.new(0, 0, 1, -20)},
    {Name = "BR", Icon = "◢", Pos = UDim2.new(1, -20, 1, -20)}
}

for _, info in ipairs(cornersInfo) do
    local handle = Instance.new("TextButton")
    handle.Name = "ResizeCorner_" .. info.Name
    handle.Size = UDim2.new(0, 20, 0, 20) 
    handle.Position = info.Pos
    handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    handle.BackgroundTransparency = 0.4
    handle.Text = info.Icon
    handle.TextColor3 = TEXT_DARK
    handle.Font = Enum.Font.SourceSansBold
    handle.TextSize = 13 
    handle.ZIndex = 12
    handle.Parent = MainFrame

    local cornerShape = Instance.new("UICorner")
    cornerShape.CornerRadius = UDim.new(0, 4)
    cornerShape.Parent = handle

    handle.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and activeResizeCorner == nil then
            activeResizeCorner = info.Name
            resizeStartMousePos = UserInputService:GetMouseLocation()
            resizeStartSize = MainFrame.AbsoluteSize
            resizeStartPos = MainFrame.AbsolutePosition
        end
    end)
end

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        activeResizeCorner = nil
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if activeResizeCorner and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local currentMousePos = UserInputService:GetMouseLocation()
        local delta = currentMousePos - resizeStartMousePos

        local rawW = resizeStartSize.X
        local rawH = resizeStartSize.Y

        if activeResizeCorner == "BR" then
            rawW = resizeStartSize.X + delta.X
            rawH = resizeStartSize.Y + delta.Y
        elseif activeResizeCorner == "BL" then
            rawW = resizeStartSize.X - delta.X
            rawH = resizeStartSize.Y + delta.Y
        elseif activeResizeCorner == "TR" then
            rawW = resizeStartSize.X + delta.X
            rawH = resizeStartSize.Y - delta.Y
        elseif activeResizeCorner == "TL" then
            rawW = resizeStartSize.X - delta.X
            rawH = resizeStartSize.Y - delta.Y
        end

        local actualW = math.clamp(rawW, minSize.X, maxSize.X)
        local actualH = math.clamp(rawH, minSize.Y, maxSize.Y)

        local deltaW = actualW - resizeStartSize.X
        local deltaH = actualH - resizeStartSize.Y

        local newX = resizeStartPos.X
        local newY = resizeStartPos.Y

        if activeResizeCorner == "BL" or activeResizeCorner == "TL" then
            newX = resizeStartPos.X - deltaW
        end
        if activeResizeCorner == "TR" or activeResizeCorner == "TL" then
            newY = resizeStartPos.Y - deltaH
        end

        MainFrame.Size = UDim2.new(0, actualW, 0, actualH)
        MainFrame.Position = UDim2.new(0, newX, 0, newY)
    end
end)

