-- PLAYER LIST
-------------------------------------------------
local function updateList()
    for _, c in ipairs(List:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end

    local filter = string.lower(Search.Text or "")
    local rows = 0

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local dn = plr.DisplayName or plr.Name
            local nm = plr.Name
            if filter == "" or string.find(string.lower(dn), filter, 1, true) or string.find(string.lower(nm), filter, 1, true) then
                rows += 1
                local active = (selectedPlayer == plr)
                local my = safeHRP(LocalPlayer)
                local hrp = safeHRP(plr)
                local dist = (my and hrp) and math.floor((hrp.Position - my.Position).Magnitude) or -1
                local distTxt = dist >= 0 and (tostring(dist) .. "m") or "..."

                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 30)
                btn.BackgroundColor3 = active and Color3.fromRGB(0, 120, 220) or Color3.fromRGB(32, 36, 48)
                btn.Text = string.format("  %s  ·  %s", dn, distTxt)
                btn.Font = Enum.Font.GothamBold
                btn.TextSize = 12
                btn.TextColor3 = Color3.fromRGB(245, 245, 255)
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = List
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

                btn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    TargetLbl.Text = "Target: " .. dn
                    updateList()
                    toast("Chon: " .. dn, Color3.fromRGB(255, 220, 80))
                end)
            end
        end
    end
end

