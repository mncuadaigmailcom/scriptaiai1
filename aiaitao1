-- ==================== CODE EXECUTION ====================
local function executeCode(code, name)
    if #code == 0 then return false, "⚠️ Vui lòng nhập code!" end
    
    log("▶️ Đang chạy:", name)
    
    local success, err = pcall(function()
        local fn, loadErr = loadstring(code)
        if not fn then error(loadErr) end
        fn()
    end)
    
    if success then
        log("✅ Hoàn thành:", name)
    else
        log("❌ Lỗi:", err)
    end
    
    return success, err
end

