-- ==================== UTILITY FUNCTIONS ====================
local Util = {}

function Util.getChar()
    return LocalPlayer.Character
end

function Util.getHumanoid()
    local char = Util.getChar()
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.getRoot()
    local char = Util.getChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char.PrimaryPart
end

function Util.isPlayerDown(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    return plr.Character:FindFirstChild("Knocked") ~= nil
        or plr.Character:FindFirstChild("Downed") ~= nil
        or plr.Character:FindFirstChild("Dead") ~= nil
end

function Util.cleanup(obj)
    if typeof(obj) == "Instance" and obj.Parent then
        obj:Destroy()
    end
end

function Util.debounce(key)
    local now = tick()
    if State.lastClick[key] and now - State.lastClick[key] < CONSTANTS.DEBOUNCE_TIME then
        return false
    end
    State.lastClick[key] = now
    return true
end

function Util.safeTween(part, targetCFrame, speed)
    if State.stopRequested then return false end
    
    local distance = (targetCFrame.Position - part.Position).Magnitude
    local duration = math.max(0.1, distance / speed)
    
    if State.currentTween then
        State.currentTween:Cancel()
        State.currentTween = nil
    end
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
    State.currentTween = tween
    tween:Play()
    
    local finished = false
    local conn = tween.Completed:Connect(function()
        finished = true
        conn:Disconnect()
    end)
    
    while not finished and not State.stopRequested do
        task.wait()
    end
    
    if State.stopRequested then
        tween:Cancel()
        return false
    end
    return true
end

function Util.updateMovement()
    local hum = Util.getHumanoid()
    if hum then
        hum.WalkSpeed = State.walkSpeed
        hum.JumpPower = State.jumpPower
    end
end

-- ==================== NOCLIP SYSTEM ====================
local Noclip = {}

function Noclip.enable()
    if State.noclipConnection then return end
    State.noclipActive = true
    State.noclipConnection = RunService.Stepped:Connect(function()
        local char = Util.getChar()
        if char and State.noclipActive then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
    log("Noclip: ON")
end

function Noclip.disable()
    if State.noclipConnection then
        State.noclipConnection:Disconnect()
        State.noclipConnection = nil
    end
    State.noclipActive = false
    
    local char = Util.getChar()
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = (part.Name ~= "HumanoidRootPart")
            end
        end
    end
    log("Noclip: OFF")
end

function Noclip.update()
    -- Ưu tiên Anti-Noclip
    if State.antiNoclipActive then
        Noclip.disable()
        if not State.antiNoclipConnection then
            State.antiNoclipConnection = RunService.Stepped:Connect(function()
                local char = Util.getChar()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.CanCollide = true
                        end
                    end
                end
            end)
        end
        return
    end
    
    if State.antiNoclipConnection then
        State.antiNoclipConnection:Disconnect()
        State.antiNoclipConnection = nil
    end
    
    -- Noclip khi bay hoặc follow
    if State.isFlying or State.isFollowing then
        Noclip.enable()
    else
        Noclip.disable()
    end
end

-- ==================== FLIGHT SYSTEM ====================
local Flight = {}

function Flight.startFly(mode, target)
    if State.isFlying or State.isFollowing then
        Flight.stopFly()
        task.wait(0.1)
    end
    
    if not Util.debounce("startFly") then return end
    
    local getTargetCFrame
    if mode == "Player" then
        if not target then return end
        State.selectedPlayer = target
        getTargetCFrame = function()
            local part = Util.getTargetPart(target)
            return part and part.CFrame
        end
    elseif mode == "Location" then
        if not target then return end
        State.selectedLocation = target
        getTargetCFrame = function() return CFrame.new(target.pos) end
    elseif mode == "Wall" then
        if not target or not target.part or not target.part.Parent then return end
        State.selectedWall = target
        getTargetCFrame = function()
            if target.part and target.part.Parent then
                local pos = target.part.Position + Vector3.new(0, target.part.Size.Y/2 + 2.5, 0)
                return CFrame.new(pos)
            end
        end
    end
    
    local initialCFrame = getTargetCFrame and getTargetCFrame()
    if not initialCFrame then return end
    
    local hrp = Util.getRoot()
    if not hrp then return end
    
    local flyHeight = tonumber(P_HeightBox.Text) or CONSTANTS.FLY_HEIGHT_DEFAULT
    local flySpeed = tonumber(P_SpeedBox.Text) or CONSTANTS.FLY_SPEED_DEFAULT
    
    State.isFlying = true
    State.stopRequested = false
    workspace.Gravity = 0
    Noclip.update()
    
    log("🚀 Bắt đầu bay tới", mode)
    
    task.spawn(function()
        -- BƯỚC 1: Bay lên trời
        local startPos = hrp.Position
        local skyPos = startPos + Vector3.new(0, flyHeight, 0)
        local ok = Util.safeTween(hrp, CFrame.new(skyPos, skyPos + hrp.CFrame.LookVector), flySpeed)
        
        -- BƯỚC 2: Bay ngang tới đích
        if ok then
            local targetCFrame = getTargetCFrame()
            if targetCFrame then
                local dest = targetCFrame.Position
                local overhead = Vector3.new(dest.X, skyPos.Y, dest.Z)
                local dir = (overhead - skyPos).Magnitude > 0.1 and (overhead - skyPos).Unit or hrp.CFrame.LookVector
                ok = Util.safeTween(hrp, CFrame.new(overhead, overhead + dir), flySpeed)
                
                -- BƯỚC 3: Hạ cánh
                if ok then
                    targetCFrame = getTargetCFrame()
                    if targetCFrame then
                        local finalCFrame = mode == "Player" and targetCFrame * CFrame.new(0, 0, 2) or targetCFrame
                        Util.safeTween(hrp, finalCFrame, flySpeed)
                        log("✅ Đã đến đích!")
                    end
                end
            end
        end
        
        -- Reset
        workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
        State.isFlying = false
        Noclip.update()
        UIUpdate.refreshAll()
    end)
end

function Flight.stopFly()
    State.stopRequested = true
    if State.currentTween then
        State.currentTween:Cancel()
        State.currentTween = nil
    end
    State.isFlying = false
    workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
    Noclip.update()
    log("🛑 Đã dừng bay")
end

function Flight.startFollow()
    if State.isFlying then Flight.stopFly() end
    if not State.selectedPlayer or not Util.debounce("startFollow") then return end
    
    State.isFollowing = true
    State.stopRequested = false
    workspace.Gravity = 0
    Noclip.update()
    
    log("🧲 Bắt đầu bu người chơi:", State.selectedPlayer.Name)
    
    task.spawn(function()
        local hasArrived = false
        
        while State.isFollowing and not State.stopRequested do
            local targetPart = Util.getTargetPart(State.selectedPlayer)
            local hrp = Util.getRoot()
            
            if not targetPart or not hrp then break end
            
            local flyHeight = tonumber(P_HeightBox.Text) or CONSTANTS.FLY_HEIGHT_DEFAULT
            local flySpeed = tonumber(P_SpeedBox.Text) or CONSTANTS.FLY_SPEED_DEFAULT
            
            if not hasArrived then
                -- Bay lên trời
                local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
                if not Util.safeTween(hrp, CFrame.new(skyPos, skyPos + hrp.CFrame.LookVector), flySpeed) then break end
                
                targetPart = Util.getTargetPart(State.selectedPlayer)
                if not targetPart then break end
                
                -- Bay ngang
                local overhead = Vector3.new(targetPart.Position.X, skyPos.Y, targetPart.Position.Z)
                if not Util.safeTween(hrp, CFrame.new(overhead, overhead + (targetPart.Position - hrp.Position).Unit), flySpeed) then break end
                
                targetPart = Util.getTargetPart(State.selectedPlayer)
                if not targetPart then break end
                
                -- Hạ cánh
                if not Util.safeTween(hrp, targetPart.CFrame * CFrame.new(0, 0, 2), flySpeed) then break end
                hasArrived = true
            else
                -- Theo dõi
                local dist = (hrp.Position - targetPart.Position).Magnitude
                if dist > 1.5 then
                    if not Util.safeTween(hrp, targetPart.CFrame * CFrame.new(0, 0, 2), flySpeed) then break end
                end
            end
            
            task.wait(0.05)
        end
        
        -- Reset
        workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
        State.isFollowing = false
        Noclip.update()
        UIUpdate.refreshAll()
    end)
end

function Flight.stopFollow()
    State.isFollowing = false
    State.stopRequested = true
    if State.currentTween then
        State.currentTween:Cancel()
        State.currentTween = nil
    end
    workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
    Noclip.update()
    log("🧲 Đã dừng bu người chơi")
end

