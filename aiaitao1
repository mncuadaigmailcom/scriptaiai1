                    BackgroundColor3=C.BLUE, BackgroundTransparency=0.1,
                    TextColor3=C.WHITE, Font=Enum.Font.GothamBold,
                    TextSize=10, BorderSizePixel=0, ZIndex=8,
                }, card)
                Corner(copyBtn2, UDim.new(0,5))

                copyBtn2.Activated:Connect(function()
                    local copied = false
                    if setclipboard then
                        pcall(function() setclipboard(d.code); copied=true end)
                    elseif toclipboard then
                        pcall(function() toclipboard(d.code); copied=true end)
                    end
                    if copied then
                        copyBtn2.Text = "✅ Đã Sao Chép!"
                    else
                        pcall(function()
                            codeLbl2:CaptureFocus()
                            codeLbl2.SelectionStart = 1
                            codeLbl2.CursorPosition = #d.code + 1
                        end)
                        copyBtn2.Text = "⚠️ Đã Bôi Đen Code"
                    end
                    task.delay(1.5, function()
                        if copyBtn2 and copyBtn2.Parent then
                            copyBtn2.Text = "📋 Sao Chép Code"
                        end
                    end)
                end)
            end

            -- Connections
            arrowBtn.Activated:Connect(function()
                d.expanded = not d.expanded
                RebuildSavedScripts()
            end)

            local capturedD = d
            local capturedI = i
            runBtn2.Activated:Connect(function()
                RunCode(capturedD.code, capturedD.name, 1, 0, function(ok, fail)
                    runBtn2.Text = ok > 0 and "✅ Xong" or "❌ Lỗi"
                    task.delay(1.5, function()
                        if runBtn2 and runBtn2.Parent then
                            runBtn2.Text = "▶ Chạy"
                        end
                    end)
                end)
            end)

            delBtn.Activated:Connect(function()
                for idx, s in ipairs(scripts) do
                    if s == capturedD then
                        table.remove(scripts, idx)
                        break
                    end
                end
                RebuildSavedScripts()
            end)

            totalH = totalH + rowH + 5
        end

        local listH = math.max(totalH, 60)
        scriptListFrame.Size = UDim2.new(1,-16,0,listH)
        T.CanvasSize = UDim2.new(0,0,0,y + listH + 30)
    end

    searchIn:GetPropertyChangedSignal("Text"):Connect(RebuildSavedScripts)
    RebuildSavedScripts()

    -- Cho Tab Code reference
    _G._BananaRebuildSaved = RebuildSavedScripts
end

