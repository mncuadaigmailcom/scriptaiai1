-- Hàm hỗ trợ tạo nút bấm
local function createButton(text, color, order, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 35)
	btn.Text = text
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 15
	btn.LayoutOrder = order
	btn.BorderSizePixel = 0
	btn.Parent = Frame

	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 6)
	BtnCorner.Parent = btn

	btn.MouseButton1Click:Connect(callback)
	return btn
end

----------------------------------------------------
-- XỬ LÝ LOGIC NHÂN VẬT & TÍNH NĂNG
----------------------------------------------------
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

LocalPlayer.CharacterAdded:Connect(function(newChar)
	Character = newChar
end)

local function getHRP()
	if Character and Character:FindFirstChild("HumanoidRootPart") then
		return Character.HumanoidRootPart
	end
	return nil
end

-- Hàm tạo tấm kính dưới chân
local function createGlass()
	if not glassPlatform or not glassPlatform.Parent then
		glassPlatform = Instance.new("Part")
		glassPlatform.Name = "GlassPlatform_Script"
		glassPlatform.Size = Vector3.new(5, 0.4, 5)
		glassPlatform.Material = Enum.Material.Glass
		glassPlatform.Transparency = 0.4
		glassPlatform.Color = Color3.fromRGB(0, 255, 255)
		glassPlatform.Anchored = true
		glassPlatform.CanCollide = true
		glassPlatform.Parent = workspace
	end
end

-- Hàm dừng tất cả tính năng
local function stopAll()
	mode = "OFF"
	
	if moveConnection then moveConnection:Disconnect() moveConnection = nil end
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
	
	if glassPlatform then
		glassPlatform:Destroy()
		glassPlatform = nil
	end
	
	if Character then
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

-- Hàm kích hoạt chế độ bay & xuyên tường
local function startAction(newMode)
	stopAll()
	mode = newMode
	createGlass()

	-- Vòng lặp Xuyên Tường (Noclip)
	noclipConnection = RunService.Stepped:Connect(function()
		if Character then
			for _, part in pairs(Character:GetDescendants()) do
				if part:IsA("BasePart") and part ~= glassPlatform then
					part.CanCollide = false
				end
			end
		end
	end)

	-- Vòng lặp Di chuyển & Cập nhật tấm kính
	moveConnection = RunService.Heartbeat:Connect(function()
		local hrp = getHRP()
		if not hrp then return end

		-- Di chuyển tấm kính dưới chân
		if glassPlatform then
			glassPlatform.CFrame = hrp.CFrame * CFrame.new(0, -3.2, 0)
		end

		-- Xử lý hướng di chuyển
		if mode == "UP" then
			hrp.CFrame = hrp.CFrame + Vector3.new(0, flySpeed, 0)
		elseif mode == "DOWN" then
			hrp.CFrame = hrp.CFrame - Vector3.new(0, flySpeed, 0)
		elseif mode == "FORWARD" then
			hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * flySpeed)
		end
	end)
end

----------------------------------------------------
-- KẾT NỐI SỰ KIỆN NÚT BẤM
----------------------------------------------------
createButton("Bay Lên", Color3.fromRGB(0, 150, 255), 1, function()
	startAction("UP")
end)

createButton("Bay Xuống", Color3.fromRGB(0, 150, 255), 2, function()
	startAction("DOWN")
end)

createButton("Bay Thẳng", Color3.fromRGB(0, 150, 255), 3, function()
	startAction("FORWARD")
end)

createButton("TẮT", Color3.fromRGB(230, 50, 50), 4, function()
	stopAll()
end)
