local function Toggle(parent, text, x, y, w, h, onColor, offColor)
    local state = false
    local btn = New("TextButton", {
        Size = UDim2.new(0, w or 200, 0, h or 26),
        Position = UDim2.new(0, x or 8, 0, y or 0),
        Text = text .. ": TẮT",
        BackgroundColor3 = offColor or C.GRAY,
        BackgroundTransparency = 0.15,
        TextColor3 = C.WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, parent)
    Corner(btn, UDim.new(0,6))

    local function update()
        btn.Text = text .. (state and ": BẬT" or ": TẮT")
        btn.BackgroundColor3 = state and (onColor or C.GREEN) or (offColor or C.GRAY)
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        update()
    end)

    btn.MouseEnter:Connect(function() Tween(btn, {BackgroundTransparency=0}, 0.15) end)
    btn.MouseLeave:Connect(function() Tween(btn, {BackgroundTransparency=0.15}, 0.15) end)

    return btn, function() return state end, function(v)
        state = v; update()
    end
end

