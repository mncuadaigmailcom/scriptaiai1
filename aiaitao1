local function createESP(plr)
    if espStorage[plr] then return end

    local bbg = Instance.new("BillboardGui")
    bbg.Name = "ESP_BananaTracker"
    bbg.Size = UDim2.new(0, 220, 0, 50)
    bbg.AlwaysOnTop = true
    bbg.ExtentsOffset = Vector3.new(0, 3, 0)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.TextColor3 = Color3.fromRGB(0, 255, 128)
    txt.Parent = bbg

    espStorage[plr] = {Gui = bbg, Label = txt}
end

local function removeESP(plr)
    if espStorage[plr] then
        if espStorage[plr].Gui then espStorage[plr].Gui:Destroy() end
        espStorage[plr] = nil
    end
end

local function removeAllESP()
    for plr, data in pairs(espStorage) do
        removeESP(plr)
    end
    downedTimeTracker = {}
end

