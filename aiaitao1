-- Hàm xử lý Ẩn/Hiện Menu
local isMenuVisible = true
local function toggleMenu()
    isMenuVisible = not isMenuVisible
    MainFrame.Visible = isMenuVisible
end

ToggleMenuBtn.MouseButton1Click:Connect(toggleMenu)

-- Phím tắt клавиатура: Bấm phím 'K' để ẩn/hiện Menu
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.K then
        toggleMenu()
    end
end)

-- Hàm tải và thực thi URL an toàn (không làm gián đoạn game khi gặp lỗi)
local function executeUrlScript(url)
    task.spawn(function()
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success and response then
            local funcSuccess, loadedFunc = pcall(function()
                return loadstring(response)
            end)
            
            if funcSuccess and loadedFunc then
                loadedFunc()
            else
                warn("[Lỗi] Không thể biên dịch script từ URL: " .. url)
            end
        else
            warn("[Lỗi] Không thể tải dữ liệu từ URL: " .. url)
        end
    end)
end

