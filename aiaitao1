    if not State.glowActive or not char then
        Util.cleanupObject(State.glowLight)
        State.glowLight = nil
        return
    end
    
    local targetPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if targetPart then
        if not State.glowLight or State.glowLight.Parent ~= targetPart then
            Util.cleanupObject(State.glowLight)
            State.glowLight = Instance.new("PointLight")
            State.glowLight.Name = "BananaGlow"
            State.glowLight.Color = Color3.fromRGB(255, 245, 200)
            State.glowLight.Brightness = 1.2
            State.glowLight.Shadows = false
            State.glowLight.Parent = targetPart
        end
        
        local rangeVal = tonumber(GlowRangeBox and GlowRangeBox.Text) or CONSTANTS.GLOW_RANGE_DEFAULT
        State.glowLight.Range = math.clamp(rangeVal, 5, 300)
    end
end

local function updateHeightPillar()
    if not State.showHeightPillar then
        Util.cleanupObject(State.heightPillar)
