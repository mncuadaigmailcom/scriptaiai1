local function toggleEsp()
    isEspActive = not isEspActive
    if isEspActive then
        EspBtn.Text = "📡 ESP PLAYERS: ON"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
    else
        EspBtn.Text = "📡 ESP PLAYERS: OFF"
        EspBtn.BackgroundColor3 = Color3.fromRGB(40, 45, 60)
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("Head") and plr.Character.Head:FindFirstChild("BananaESP") then
                plr.Character.Head.BananaESP:Destroy()
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not isEspActive then return end
    local myHRP = getHRP(LocalPlayer)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local head = plr.Character.Head
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local bbg = head:FindFirstChild("BananaESP")

            if not bbg then
                bbg = Instance.new("BillboardGui")
                bbg.Name = "BananaESP"
                bbg.Size = UDim2.new(0, 140, 0, 28)
                bbg.AlwaysOnTop = true
                bbg.ExtentsOffset = Vector3.new(0, 2.2, 0)

                local txt = Instance.new("TextLabel")
                txt.Name = "Label"
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.Font = Enum.Font.GothamBold
                txt.TextSize = 11
                txt.TextStrokeTransparency = 0
                txt.Parent = bbg
                bbg.Parent = head
            end

            local dist = myHRP and math.floor((head.Position - myHRP.Position).Magnitude) or 0
            local hpPercent = hum and (hum.Health / hum.MaxHealth) or 1
            
            -- Đổi màu linh hoạt theo lượng máu
            bbg.Label.TextColor3 = Color3.fromHSV(hpPercent * 0.3, 0.9, 1) 
            bbg.Label.Text = string.format("%s\n[%dm]", plr.DisplayName, dist)
        end
    end
end)

