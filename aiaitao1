-- Hàm hỗ trợ tạo nút bấm
local function createButton(text, color, order, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 35)
	btn.Position = UDim2.new(0.05, 0, 0, 0)
	btn.Text = text
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 16
	btn.LayoutOrder = order
	btn.Parent = Frame
	
	btn.MouseButton1Click:Connect(callback)
	return btn
end

-- Tạo 4 nút bấm theo yêu cầu
createButton("Bay Lên", Color3.fromRGB(0, 170, 255), 1, function()
	startAction("UP")
end)

createButton("Bay Xuống", Color3.fromRGB(0, 170, 255), 2, function()
	startAction("DOWN")
end)

createButton("Bay Thẳng", Color3.fromRGB(0, 170, 255), 3, function()
	startAction("FORWARD")
end)

createButton("TẮT", Color3.fromRGB(255, 50, 50), 4, function()
	stopAll()
end)
