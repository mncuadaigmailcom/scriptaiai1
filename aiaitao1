local bv, bg, fp, cp
local StopFly = function()
	if bv then bv:Destroy(); bv=nil end
	if bg then bg:Destroy(); bg=nil end
	if fp then fp:Destroy(); fp=nil end
	local h = Hum(); if h then h.AutoRotate=true; h.PlatformStand=false end
	RunService:UnbindFromRenderStep("Fly")
end
local StopCarpet = function()
	if cp then cp:Destroy(); cp=nil end
	RunService:UnbindFromRenderStep("Carpet"); S.carpetY=nil
end
local CreateCarpet = function(y)
	local r = Root(); if not r then return end
	if cp then cp:Destroy() end
	S.carpetY = y or (r.Position.Y - 3.0 - (S.carpetThickness / 2))
	cp = New("Part", {Name="Carpet", Size=Vector3.new(S.carpetWidth, S.carpetThickness, S.carpetLength), Transparency=0.9, Color=Color3.fromRGB(200,230,255), Material=Enum.Material.SmoothPlastic, Anchored=true, CanCollide=true, Position=Vector3.new(r.Position.X, S.carpetY, r.Position.Z)}, workspace)
	RunService:BindToRenderStep("Carpet", Enum.RenderPriority.Camera.Value - 1, function()
		local curR = Root()
		if not S.carpet or not cp or not curR then return end
		cp.Size = Vector3.new(S.carpetWidth, S.carpetThickness, S.carpetLength)
		cp.CFrame = CFrame.new(curR.Position.X, S.carpetY, curR.Position.Z)
		if S.noClip and curR.Position.Y < (S.carpetY + (S.carpetThickness / 2) + 3.0) then
			curR.CFrame = CFrame.new(curR.Position.X, S.carpetY + (S.carpetThickness / 2) + 3.0, curR.Position.Z)
		end
	end)
end

