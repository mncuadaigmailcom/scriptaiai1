-- ==================== CHAR HELPERS ====================
local function GetChar() return player.Character end
local function Hum()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function Root()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function UpdChar()
    local h = Hum()
    if h then
        h.WalkSpeed = S.walkSpeed
        h.JumpPower = S.jumpPower
    end
end
local function GetTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local c = plr.Character
    return c:FindFirstChild("HumanoidRootPart")
        or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso")
        or c:FindFirstChild("Head")
        or c.PrimaryPart
        or c:FindFirstChildOfClass("BasePart")
end
local function IsDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local c = plr.Character
    local h = c:FindFirstChildOfClass("Humanoid")
    if not GetTargetPart(plr) then return true end
    if h and h.Health <= 0 then return true end
    if c:FindFirstChild("Knocked") or c:FindFirstChild("Downed")
    or c:FindFirstChild("Ragdoll") or c:FindFirstChild("Dead") then
        return true
    end
    pcall(function()
        if plr.DataFolder.Information.IsKnocked.Value then return true end
    end)
    return false
end

-- ==================== NOCLIP SYSTEM ====================
local function EnableNoclip()
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not S.noClip and not isFlying and not followActive then return end
        local c = GetChar()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
end

local function DisableNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    local c = GetChar()
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = (p.Name ~= "HumanoidRootPart")
            end
        end
    end
end

local function ApplyAntiNoclip()
    if antiNoclipConn then antiNoclipConn:Disconnect(); antiNoclipConn = nil end
    if not S.antiNoclip then return end
    antiNoclipConn = RunService.Stepped:Connect(function()
        local c = GetChar()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.CanCollide = true
                end
            end
        end
    end)
end

local function UpdateNoclipState()
    if S.antiNoclip then
        if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
        ApplyAntiNoclip()
    else
        if antiNoclipConn then antiNoclipConn:Disconnect(); antiNoclipConn = nil end
        if S.noClip or isFlying or followActive then
            EnableNoclip()
        else
            DisableNoclip()
        end
    end
end

-- ==================== TWEEN FLY BASE ====================
local function TweenToTarget(hrp, targetCF, speed)
    if stopRequested then return false end
    local dist = (targetCF.Position - hrp.Position).Magnitude
    local dur  = math.max(dist / math.max(speed, 1), 0.1)
    currentTween = TweenService:Create(hrp,
        TweenInfo.new(dur, Enum.EasingStyle.Linear),
        {CFrame = targetCF})
    currentTween:Play()
    local done = false
    local conn
    conn = currentTween.Completed:Connect(function() done = true end)
    while not done do
        if stopRequested then
            currentTween:Cancel()
            conn:Disconnect()
            return false
        end
        task.wait()
    end
    conn:Disconnect()
    return true
end

-- ==================== TELEPORT FLY (3 BƯỚC) ====================
local function StopTweenFly()
    stopRequested = true
    if currentTween then currentTween:Cancel() end
    isFlying = false
    workspace.Gravity = 196.2
    UpdateNoclipState()
end

local function StartTweenFly(mode, targetObj)
    if isFlying then return end
    if followActive then
        followActive = false
        stopRequested = true
    end

    local getCF = nil
    if mode == "Player" then
        if not targetObj then return end
        selectedPlayer = targetObj
        getCF = function()
            local p = GetTargetPart(targetObj)
            return p and p.CFrame
        end
    elseif mode == "Location" then
        if not targetObj then return end
        selectedLocation = targetObj
        getCF = function() return CFrame.new(targetObj.pos) end
    elseif mode == "Wall" then
        if not targetObj or not targetObj.part or not targetObj.part.Parent then return end
        selectedWall = targetObj
        getCF = function()
            if targetObj.part and targetObj.part.Parent then
                local wp = targetObj.part
                return CFrame.new(wp.Position + Vector3.new(0, wp.Size.Y/2 + 2.5, 0))
            end
        end
    end

    local initCF = getCF and getCF()
    if not initCF then return end

    local char = GetChar()
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local speed  = tonumber(S.flySpeed) or 80
    local height = tonumber(S.flyHeight) or 150

    isFlying = true
    stopRequested = false
    UpdateNoclipState()
    local oldGrav = workspace.Gravity
    workspace.Gravity = 0

    local startPos = hrp.Position
    local skyPos   = Vector3.new(startPos.X, startPos.Y + height, startPos.Z)
    local look     = hrp.CFrame.LookVector

    local ok1 = TweenToTarget(hrp, CFrame.new(skyPos, skyPos + look), speed)
    if ok1 and not stopRequested then
        local liveCF = getCF()
        if liveCF then
            local dest     = liveCF.Position
            local overhead = Vector3.new(dest.X, skyPos.Y, dest.Z)
            local hDir     = (overhead - skyPos).Magnitude > 0.1
                and (overhead - skyPos).Unit or look
            local ok2 = TweenToTarget(hrp, CFrame.new(overhead, overhead + hDir), speed)
            if ok2 and not stopRequested then
                liveCF = getCF()
                if liveCF then
                    local finalCF = (mode == "Player")
                        and (liveCF * CFrame.new(0,0,2))
                        or liveCF
                    TweenToTarget(hrp, finalCF, speed)
                end
            end
        end
    end

    workspace.Gravity = oldGrav
    isFlying = false
    UpdateNoclipState()
end

-- ==================== FOLLOW SYSTEM ====================
local function StopFollow()
    followActive = false
    stopRequested = true
    if currentTween then currentTween:Cancel() end
    workspace.Gravity = 196.2
    UpdateNoclipState()
end

local function StartFollow()
    if not selectedPlayer or not selectedPlayer.Character then return end
    if isFlying then StopTweenFly() end
    followActive = true
    stopRequested = false
    UpdateNoclipState()

    task.spawn(function()
        local oldGrav = workspace.Gravity
        workspace.Gravity = 0
        local arrived = false

        while followActive and not stopRequested
              and selectedPlayer and selectedPlayer.Character do
            local myHRP = Root()
            local tgt   = GetTargetPart(selectedPlayer)
            if not myHRP or not tgt then break end

            local speed  = tonumber(S.flySpeed) or 80
            local height = tonumber(S.flyHeight) or 150
            local tgtCF  = tgt.CFrame * CFrame.new(0,0,2)

            if not arrived then
                local sp     = myHRP.Position
                local skyP   = Vector3.new(sp.X, sp.Y + height, sp.Z)
                local look   = myHRP.CFrame.LookVector
                local ok1 = TweenToTarget(myHRP, CFrame.new(skyP, skyP + look), speed)
                if not ok1 or not followActive then break end
                tgt = GetTargetPart(selectedPlayer)
                if not tgt then break end
                local dest = tgt.Position
                local ov   = Vector3.new(dest.X, skyP.Y, dest.Z)
                local ok2 = TweenToTarget(myHRP, CFrame.new(ov, ov + (dest-sp).Unit), speed)
                if not ok2 or not followActive then break end
                tgt = GetTargetPart(selectedPlayer)
                if not tgt then break end
                local ok3 = TweenToTarget(myHRP, tgt.CFrame * CFrame.new(0,0,2), speed)
                if not ok3 or not followActive then break end
                arrived = true
            else
                if (myHRP.Position - tgtCF.Position).Magnitude > 2 then
                    local ok = TweenToTarget(myHRP, tgtCF, speed)
                    if not ok or not followActive then break end
                end
            end
            task.wait(0.05)
        end

        workspace.Gravity = oldGrav
        followActive = false
        UpdateNoclipState()
    end)
end

