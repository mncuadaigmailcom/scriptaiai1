local function updatePlayersLayout()
    local leftRatio = math.clamp(splitRatio, minSplit, maxSplit)
    local rightRatio = 1 - leftRatio - 0.02

    SearchBox.Size = UDim2.new(leftRatio * 0.68, 0, 0, 26)
    SearchBox.Position = UDim2.new(0, 0, 0, 0)

    RefreshBtn.Size = UDim2.new(leftRatio * 0.28, 0, 0, 26)
    RefreshBtn.Position = UDim2.new(leftRatio * 0.70, 0, 0, 0)

    PlayerList.Size = UDim2.new(leftRatio, 0, 1, -32)
    PlayerList.Position = UDim2.new(0, 0, 0, 32)

    SplitDivider.Size = UDim2.new(0, 8, 1, -32)
    SplitDivider.Position = UDim2.new(leftRatio + 0.003, 0, 0, 32)

    P_RightPanel.Position = UDim2.new(leftRatio + 0.02, 0, 0, 32)
    P_RightPanel.Size = UDim2.new(rightRatio, 0, 1, -32)
end

local isDraggingSplit = false

SplitDivider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSplit = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSplit = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSplit and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local pageAbsPos = PlayersPage.AbsolutePosition.X
        local pageAbsSize = PlayersPage.AbsoluteSize.X
        if pageAbsSize > 0 then
            local mouseX = UserInputService:GetMouseLocation().X
            local newRatio = (mouseX - pageAbsPos) / pageAbsSize
            splitRatio = math.clamp(newRatio, minSplit, maxSplit)
            updatePlayersLayout()
        end
    end
end)

MainFrame:GetPropertyChangedSignal("Size"):Connect(updatePlayersLayout)
updatePlayersLayout()

