-- 5. BỘ MÁY BAY TỚI MỤC TIÊU (ULTRA SMOOTH MOVEMENT)
---------------------------------------------------------
local function getHRP(plr)
    if plr and plr.Character then
        return plr.Character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function stopFly()
    isFlying = false
    stopRequested = true
    if flyLoopConn then flyLoopConn:Disconnect() flyLoopConn = nil end
    
    workspace.Gravity = 196.2
    setNoclip(false)
    
    FlyBtn.Text = "🚀 BAY TỚI MỤC TIÊU"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
end

local function startFly()
    if isFlying then stopFly() return end
    if not selectedPlayer then return end

    local myHRP = getHRP(LocalPlayer)
    local targetHRP = getHRP(selectedPlayer)

    if not myHRP or not targetHRP then return end

    if isFollowing then stopFollow() end

    isFlying = true
    stopRequested = false
    
    FlyBtn.Text = "🛑 DỪNG BAY"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(230, 40, 40)

    setNoclip(true)
    workspace.Gravity = 0

    local spd = tonumber(SpeedBox.Text) or 150
    local hgt = tonumber(HeightBox.Text) or 120

    task.spawn(function()
        local phase = 1 -- 1: Bay lên, 2: Bay ngang, 3: Đáp xuống
        local targetSkyY = myHRP.Position.Y + hgt

        flyLoopConn = RunService.Heartbeat:Connect(function(dt)
            if stopRequested or not isFlying or not selectedPlayer or not selectedPlayer.Character then
                stopFly()
                return
            end

            myHRP = getHRP(LocalPlayer)
            targetHRP = getHRP(selectedPlayer)
            if not myHRP or not targetHRP then stopFly() return end

            myHRP.AssemblyLinearVelocity = Vector3.zero

            local currentPos = myHRP.Position
            local targetPos = targetHRP.Position

            if phase == 1 then
                -- BƯỚC 1: BAY BỔ THẲNG LÊN TRỜI
                local destPos = Vector3.new(currentPos.X, targetSkyY, currentPos.Z)
                local dist = (destPos - currentPos).Magnitude
                
                if dist < 3 then
                    phase = 2
                else
                    local moveDir = (destPos - currentPos).Unit
                    myHRP.CFrame = CFrame.new(currentPos + moveDir * math.min(dist, spd * dt), currentPos + moveDir)
                end

            elseif phase == 2 then
                -- BƯỚC 2: BAY NGANG ĐỒNG BỘ THEO VỊ TRÍ ĐỐI PHƯƠNG
                local destPos = Vector3.new(targetPos.X, targetSkyY, targetPos.Z)
                local dist = (destPos - currentPos).Magnitude

                if dist < 4 then
                    phase = 3
                else
                    local moveDir = (destPos - currentPos).Unit
                    myHRP.CFrame = CFrame.new(currentPos + moveDir * math.min(dist, spd * dt), targetPos)
                end

            elseif phase == 3 then
                -- BƯỚC 3: HẠ CÁNH CHUẨN XÁC SAU LƯNG ĐỐI PHƯƠNG
                local destCFrame = targetHRP.CFrame * CFrame.new(0, 0, 2.5)
                local dist = (destCFrame.Position - currentPos).Magnitude

                if dist < 2 then
                    stopFly()
                else
                    local moveDir = (destCFrame.Position - currentPos).Unit
                    myHRP.CFrame = CFrame.new(currentPos + moveDir * math.min(dist, spd * dt), destCFrame.Position)
                end
            end
        end)
    end)
end

