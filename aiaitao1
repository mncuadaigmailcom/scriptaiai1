-- Khoá và tải thư viện Orion UI
local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Orion/main/source'))()

local Window = OrionLib:MakeWindow({
    Name = "✈️ Menu Bay Tới Người Chơi", 
    HidePremium = false, 
    SaveConfig = false, 
    ConfigFolder = "FlyToPlayerConfig",
    IntroText = "Đang tải Menu..."
})

-- Các biến dịch vụ Roblox
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Các biến điều khiển
local SelectedPlayer = nil
local FlySpeed = 100
local IsFlying = false

-- Hàm lấy danh sách tên người chơi (Trừ bản thân)
local function GetPlayerList()
    local playerNames = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerNames, player.Name)
        end
    end
    return playerNames
end

-- Tab chính
local MainTab = Window:MakeTab({
    Name = "Bay Tới Người Chơi",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- 1. Chức năng Chọn Người Chơi
local PlayerDropdown = MainTab:AddDropdown({
    Name = "Chọn Người Chơi Target",
    Default = "",
    Options = GetPlayerList(),
    Callback = function(Value)
        SelectedPlayer = Players:FindFirstChild(Value)
    end
})

-- Nút Làm Mới Danh Sách Người Chơi
MainTab:AddButton({
    Name = "🔄 Làm mới danh sách người chơi",
    Callback = function()
        PlayerDropdown:Refresh(GetPlayerList(), true)
    end
})

-- 2. Chức năng Điều Chỉnh Tốc Độ Bay
MainTab:AddSlider({
    Name = "Tốc độ bay",
    Min = 10,
    Max = 500,
    Default = 100,
    Color = Color3.fromRGB(0, 255, 127),
    Increment = 5,
    ValueName = "Speed",
    Callback = function(Value)
        FlySpeed = Value
    end
})

-- 3. Bật / Tắt Bay Tới Người Chơi
MainTab:AddToggle({
    Name = "🚀 Bật / Tắt Bay Tới",
    Default = false,
    Callback = function(Value)
        IsFlying = Value
    end
})

-- Vòng lặp chính xử lý Bay và Noclip (Xuyên tường)
RunService.Stepped:Connect(function(time, deltaTime)
    if IsFlying and SelectedPlayer and SelectedPlayer.Character and SelectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            
            -- Tắt va chạm (Noclip) để tránh kẹt tường khi bay
            for _, part in pairs(myChar:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local myHRP = myChar.HumanoidRootPart
            local targetHRP = SelectedPlayer.Character.HumanoidRootPart
            
            -- Tính toán khoảng cách
            local distance = (targetHRP.Position - myHRP.Position).Magnitude

            -- Nếu khoảng cách > 3 studs thì tiếp tục bay tới
            if distance > 3 then
                local direction = (targetHRP.Position - myHRP.Position).Unit
                myHRP.CFrame = CFrame.new(myHRP.Position + direction * (FlySpeed * deltaTime), targetHRP.Position)
                myHRP.AssemblyLinearVelocity = Vector3.zero -- Triệt tiêu trọng lực để không bị rơi
            end
        end
    end
end)

-- Thông báo khởi chạy thành công
OrionLib:MakeNotification({
    Name = "Thành công!",
    Content = "Menu bay đã sẵn sàng sử dụng.",
    Image = "rbxassetid://4483345998",
    Time = 5
})

OrionLib:Init()
