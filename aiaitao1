    local hrp = Util.getRoot()
    if not hrp then return end
    
    local sizeX = math.clamp(tonumber(WallLenBox.Text) or 15, CONSTANTS.WALL_SIZE_MIN, CONSTANTS.WALL_SIZE_MAX)
    local sizeY = math.clamp(tonumber(WallHeightBox.Text) or 10, CONSTANTS.WALL_SIZE_MIN, CONSTANTS.WALL_SIZE_MAX)
    local sizeZ = math.clamp(tonumber(WallThickBox.Text) or 1, 0.1, 100)
    local trans = math.clamp(tonumber(WallTransBox.Text) or 0.5, 0, 1)
    
    State.wallCounter = State.wallCounter + 1
    local name = WallNameBox.Text
    if name == "" or string.match(name, "^%s*$") then
        name = "Tường #" .. State.wallCounter
    end
    
    local wall = Instance.new("Part")
    wall.Name = "Wall_" .. State.wallCounter
    wall.Size = Vector3.new(sizeX, sizeY, sizeZ)
    wall.CFrame = hrp.CFrame * CFrame.new(0, sizeY/2 - 3, -(sizeZ/2 + 4))
    wall.Anchored = true
    wall.CanCollide = wallCanCollide
    wall.Material = Enum.Material.SmoothPlastic
    wall.Transparency = trans
    wall.Color = Color3.fromRGB(0, 170, 255)
