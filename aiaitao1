-- Code Execution
local function ExecCode(code)
    return pcall(function()
        local fn, err = loadstring(code)
        if not fn then error(err) end
        fn()
    end)
end

local function CancelExec()
    cancelled = true
    if curThread then task.cancel(curThread); curThread = nil end
end

local function RunCode(code, name, times, delay, onDone)
    CancelExec()
    if #code == 0 then return false, "⚠️ Vui lòng nhập code!" end
    cancelled = false
    local okC, failC = 0, 0
    curThread = task.spawn(function()
        for i = 1, times do
            if cancelled then break end
            if i > 1 and delay > 0 then
                local e = 0
                while e < delay do
                    if cancelled then break end
                    task.wait(0.1); e += 0.1
                end
                if cancelled then break end
            end
            local ok, err = ExecCode(code)
            if ok then okC += 1 else failC += 1; warn("❌ Lần "..i..": "..tostring(err)) end
        end
        totalRuns += okC + failC
        curThread = nil
        if onDone then onDone(okC, failC) end
    end)
    return true
end

