-- CẬP NHẬT DANH SÁCH PLAYERS
---------------------------------------------------------
local function updatePlayerList()
    for _, child in pairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local filter = string.lower(SearchBox.Text)
    local count = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if filter == "" or string.find(string.lower(plr.Name), filter) or string.find(string.lower(plr.DisplayName), filter) then
                count = count + 1
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, -6, 0, 25)
                Btn.BackgroundColor3 = (selectedPlayer == plr) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(35, 38, 48)
                Btn.Text = " 👤 " .. plr.DisplayName
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                Btn.Font = Enum.Font.SourceSansBold
                Btn.TextSize = 11
                Btn.TextXAlignment = Enum.TextXAlignment.Left
                Btn.Parent = PlayerListScroll
                Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

                Btn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    TargetLabel.Text = "🎯 Đang chọn: " .. plr.DisplayName
                    updatePlayerList()
                end)
            end
        end
    end
    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, count * 27)
end

