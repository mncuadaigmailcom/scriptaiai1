                        local dist = myHRP and math.floor((item.part.Position - myHRP.Position).Magnitude) or 0
                        data.Label.Text = string.format("🧱 [%s]\n📏 %dm", item.name, dist)
                    end
                else
                    RemoveWallESP(item)
                end
            else
                RemoveWallESP(item)
            end
        end
    else
        if next(wallEspStorage) then ClearAllWallESP() end
    end

    -- Glow
    if S.glowActive then UpdateGlow() end
end)

