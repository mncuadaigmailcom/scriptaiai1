local tabList  = {}
local contList = {}
local activeTabIndex = 1

local function SwitchTab(idx)
    for i, t in ipairs(contList) do t.Visible = false end
    for i, b in ipairs(tabList) do
        b.BackgroundColor3 = C.BG
        b.BackgroundTransparency = 0.35
        b.TextColor3 = C.DARK
    end
    if contList[idx] and tabList[idx] then
        contList[idx].Visible = true
        tabList[idx].BackgroundColor3 = C.BLUE
        tabList[idx].BackgroundTransparency = 0.1
        tabList[idx].TextColor3 = C.WHITE
        activeTabIndex = idx
    end
end

local function AddTab(name, icon, order)
    local btn = New("TextButton", {
        Size=UDim2.new(1,-4,0,32),
        Text=icon.."\n"..name,
        BackgroundColor3=C.BG,
        BackgroundTransparency=0.35,
        TextColor3=C.DARK,
        Font=Enum.Font.GothamBold,
        TextSize=8.5,
        BorderSizePixel=0,
        LayoutOrder=order, ZIndex=4,
    }, tabBar)
    Corner(btn, UDim.new(0,6))

    local sf = New("ScrollingFrame", {
        Size=UDim2.new(1,-4,1,-4),
        Position=UDim2.new(0,2,0,2),
        BackgroundTransparency=1,
        BorderSizePixel=0,
        ScrollBarThickness=4,
        ScrollBarImageColor3=Color3.fromRGB(150,155,175),
        CanvasSize=UDim2.new(0,0,0,0),
        Visible=false, Active=true,
        ScrollingDirection=Enum.ScrollingDirection.Y,
        ZIndex=4,
    }, contentArea)

    local idx = #tabList + 1
    btn.Activated:Connect(function() SwitchTab(idx) end)
    btn.MouseEnter:Connect(function()
        if activeTabIndex ~= idx then
            Tween(btn, {BackgroundTransparency=0.2}, 0.15)
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTabIndex ~= idx then
            Tween(btn, {BackgroundTransparency=0.35}, 0.15)
        end
    end)

    table.insert(tabList, btn)
    table.insert(contList, sf)
    tabBar.CanvasSize = UDim2.new(0,0,0,#tabList*36+20)
    return sf
end

