local function StopPhysFly()
    if bv  then bv:Destroy();  bv  = nil end
    if bg  then bg:Destroy();  bg  = nil end
    if fp  then fp:Destroy();  fp  = nil end
    RunService:UnbindFromRenderStep("PhysFly")
    local h = Hum()
    if h then h.AutoRotate = true; h.PlatformStand = false end
end

local function VInput()
    return UserInputService:IsKeyDown(Enum.KeyCode.Space),
           UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
end

local function StartPhysFly()
    local r = Root(); local h = Hum()
    if not r then return end
    bv = New("BodyVelocity", {MaxForce=Vector3.new(4e4,4e4,4e4), Velocity=Vector3.zero}, r)
    bg = New("BodyGyro",     {MaxTorque=Vector3.new(4e4,4e4,4e4), CFrame=r.CFrame}, r)
    fp = New("Part", {
        Name="PhysFloor", Size=Vector3.new(6,0.2,6),
        Transparency=0.8, Color=Color3.fromRGB(200,230,255),
        Material=Enum.Material.Glass, Anchored=true, CanCollide=false,
    }, workspace)
    if h then h.AutoRotate = false; h.PlatformStand = true end

    RunService:BindToRenderStep("PhysFly", 1, function()
        local curR = Root(); local curH = Hum()
        if not S.flying or not curR or not bv then return end
        local d = curH and curH.MoveDirection or Vector3.zero
        local t = curR.CFrame:VectorToWorldSpace(d)
        if t.Magnitude > 0 then t = t.Unit end
        local up, dn = VInput()
        local vv = (up and 1 or 0) - (dn and 1 or 0)
        bv.Velocity = (t + Vector3.new(0, vv, 0)) * S.flySpeed
        bg.CFrame   = CFrame.new(curR.Position,
            curR.Position + workspace.CurrentCamera.CFrame.LookVector)
        if fp then fp.Position = curR.Position - Vector3.new(0,3.5,0) end
    end)
end

-- ==================== CARPET SYSTEM ====================
local function StopCarpet()
    if cp then cp:Destroy(); cp = nil end
    RunService:UnbindFromRenderStep("Carpet")
    S.carpetY = nil
end

local function CreateCarpet(y)
    local r = Root(); if not r then return end
    if cp then cp:Destroy(); cp = nil end
    local w = S.carpetWidth or 1.5
    local t = S.carpetThickness or 0.2
    local l = S.carpetLength or 1.5
    S.carpetY = y or (r.Position.Y - 3.0 - t/2)
    cp = New("Part", {
        Name="BananaCarpet", Size=Vector3.new(w,t,l),
        Transparency=0.85, Color=Color3.fromRGB(150,200,255),
        Material=Enum.Material.SmoothPlastic,
        Anchored=true, CanCollide=true, Friction=1,
        Position=Vector3.new(r.Position.X, S.carpetY, r.Position.Z),
    }, workspace)
    RunService:BindToRenderStep("Carpet", Enum.RenderPriority.Camera.Value-1, function()
        local curR = Root()
        if not S.carpet or not cp or not curR then return end
        local cw = S.carpetWidth or 1.5
        local ct = S.carpetThickness or 0.2
        local cl = S.carpetLength or 1.5
        if cp.Size.X ~= cw or cp.Size.Y ~= ct or cp.Size.Z ~= cl then
            cp.Size = Vector3.new(cw,ct,cl)
        end
        cp.CFrame = CFrame.new(curR.Position.X, S.carpetY, curR.Position.Z)
        if S.noClip then
            local standY = S.carpetY + ct/2 + 3.0
            if curR.Position.Y < standY then
                curR.CFrame = CFrame.new(curR.Position.X, standY, curR.Position.Z)
                if curR.AssemblyLinearVelocity.Y < 0 then
                    curR.AssemblyLinearVelocity = Vector3.new(
                        curR.AssemblyLinearVelocity.X, 0,
                        curR.AssemblyLinearVelocity.Z)
                end
            end
        end
    end)
end

