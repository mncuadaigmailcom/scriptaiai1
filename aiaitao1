------------------------------------------------------------
local ToggleGui = Instance.new("ScreenGui")
ToggleGui.Name = "GraiToggleBtn"
ToggleGui.ResetOnSpawn = false
ToggleGui.Parent = ParentContainer

local ImageButton = Instance.new("ImageButton")
ImageButton.Parent = ToggleGui
ImageButton.BackgroundColor3 = Color3.fromRGB(0,0,0)
ImageButton.BackgroundTransparency = 1
ImageButton.BorderSizePixel = 0
ImageButton.Position = UDim2.new(0.08, 0, 0.15, 0)
ImageButton.Size = UDim2.new(0, 50, 0, 50)
ImageButton.Draggable = true
ImageButton.Image = "rbxassetid://13220409166" -- Logo Chuối Đội Vương Miện

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = ImageButton

-- Xử lý Toggle Menu cực mượt cho Mobile & PC
ImageButton.MouseButton1Click:Connect(function()
    -- Cách 1: Thử gửi phím End
    pcall(function()
        game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.End, false, game)
        game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.End, false, game)
    end)
    
    -- Cách 2: Bật/Tắt trực tiếp ScreenGui của Fluent (Dành cho Mobile)
    for _, gui in pairs(ParentContainer:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "GraiToggleBtn" and gui.Name ~= "GraiIntro" then
            if gui:FindFirstChild("Main") or gui:FindFirstChild("Frame") or gui:FindFirstChild("Container") then
                gui.Enabled = not gui.Enabled
            end
        end
    end
end)

