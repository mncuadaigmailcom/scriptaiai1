---------------------------------------------------------
local function createLocESP(item)
    if locEspStorage[item] then return end

    local att = Instance.new("Attachment")
    att.Name = "ESP_LocAtt_" .. tostring(item.name)
    att.WorldPosition = item.pos
    att.Parent = workspace.Terrain

    local bbg = Instance.new("BillboardGui")
    bbg.Name = "ESP_LocationTracker"
    bbg.Size = UDim2.new(0, 200, 0, 40)
    bbg.AlwaysOnTop = true
    bbg.Adornee = att
    bbg.ExtentsOffset = Vector3.new(0, 2.5, 0)

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.TextColor3 = Color3.fromRGB(255, 215, 0)
    txt.Parent = bbg

    bbg.Parent = ScreenGui

    locEspStorage[item] = {Gui = bbg, Label = txt, Attachment = att}
end

local function removeLocESP(item)
    if locEspStorage[item] then
        if locEspStorage[item].Gui then locEspStorage[item].Gui:Destroy() end
        if locEspStorage[item].Attachment then locEspStorage[item].Attachment:Destroy() end
        locEspStorage[item] = nil
    end
end

local function removeAllLocESP()
    for item, data in pairs(locEspStorage) do
        removeLocESP(item)
    end
end

