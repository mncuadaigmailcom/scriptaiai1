local function EnCC()
    local cam = workspace.CurrentCamera; if not cam then return end
    ccX=0; ccY=10
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = S.fov
    RunService:BindToRenderStep("CC", Enum.RenderPriority.Camera.Value, function()
        if not S.customCam then return end
        local r = Root(); if not r then return end
        local c = GetChar()
        local h = c and c:FindFirstChild("Head")
        local bp = h and h.Position or r.Position
        local cf = CFrame.new(bp)
            * CFrame.Angles(0, math.rad(ccX), 0)
            * CFrame.Angles(math.rad(ccY), 0, 0)
        local off = cf.RightVector*S.camOffX + cf.UpVector*S.camOffY
        local cp2 = bp + cf.LookVector*(-8) + off + Vector3.new(0,1.5,0)
        cam.CFrame = CFrame.new(cp2, bp + Vector3.new(0,1.5,0))
        cam.FieldOfView = S.fov
    end)
end

local function DisFC()
    RunService:UnbindFromRenderStep("FC")
    local cam = workspace.CurrentCamera
    if cam then cam.CameraType=Enum.CameraType.Custom; cam.FieldOfView=70 end
    UserInputService.MouseBehavior   = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    local r = Root(); if r then r.Anchored = false end
    local h = Hum()
    if h then
        h.AutoRotate = true
        h.WalkSpeed  = S.walkSpeed
        h.JumpPower  = S.jumpPower
    end
end

local function EnFC()
    local cam = workspace.CurrentCamera; if not cam then return end
    local r = Root(); local h = Hum()
    if r then fcPos = r.Position + Vector3.new(0,5,0); r.Anchored = true end
    if h then h.AutoRotate = false; h.WalkSpeed = 0; h.JumpPower = 0 end
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = 90
    fcYaw=0; fcPitch=0
    UserInputService.MouseBehavior   = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false
    RunService:BindToRenderStep("FC", Enum.RenderPriority.Camera.Value, function(dt)
        if not S.freeCam then return end
        local d = UserInputService:GetMouseDelta()
        fcYaw   = (fcYaw   - d.X * 0.3) % 360
        fcPitch = math.clamp(fcPitch - d.Y * 0.3, -89, 89)
        local cf = CFrame.new(fcPos)
            * CFrame.Angles(0, math.rad(fcYaw), 0)
            * CFrame.Angles(math.rad(fcPitch), 0, 0)
        local sp = S.freeCamSpeed * dt
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then sp *= 3 end
        local m = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then m += cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then m -= cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then m -= cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then m += cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then m += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then m -= Vector3.new(0,1,0) end
        fcPos += m * sp
        cam.CFrame = CFrame.new(fcPos)
            * CFrame.Angles(0, math.rad(fcYaw), 0)
            * CFrame.Angles(math.rad(fcPitch), 0, 0)
    end)
end

