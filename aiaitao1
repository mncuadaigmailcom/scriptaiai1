-- ==================== UI UPDATE FUNCTIONS ====================
local UIUpdate = {}

function UIUpdate.updatePlayerList()
    for _, c in ipairs(PlayerList:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end
    end
    
    local filter = string.lower(SearchBox.Text)
    local count = 0
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        
        local match = filter == "" or string.find(string.lower(plr.Name), filter, 1, true)
        if not match then continue end
        
        count = count + 1
        local isEven = (count % 2 == 0)
        local isDown = Util.isPlayerDown(plr)
        local isSelected = (State.selectedPlayer == plr)
        
        local item = New("Frame", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = isSelected and T.ACCENT or (isEven and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(215, 220, 230)),
            BackgroundTransparency = isSelected and 0.25 or 0.45,
            BorderSizePixel = 0,
        }, PlayerList)
        Corner(item, UDim.new(0, 4))
        
        local nameBtn = New("TextButton", {
            Size = UDim2.new(isSelected and 0.62 or 1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = (isDown and "🔴 " or "👤 ") .. plr.Name,
            TextColor3 = isSelected and T.TEXT_LIGHT or (isDown and T.DANGER or T.TEXT),
            Font = Enum.Font.SourceSansBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, item)
        
        nameBtn.Activated:Connect(function()
            State.selectedPlayer = plr
            UIUpdate.updatePlayerList()
        end)
        
        if isSelected then
            local flyBtn = New("TextButton", {
                Size = UDim2.new(0.33, 0, 0.8, 0),
                Position = UDim2.new(0.64, 0, 0.1, 0),
                Text = State.isFlying and "🛑 Dừng" or "🚀 Bay",
                BackgroundColor3 = State.isFlying and T.DANGER or T.SUCCESS,
                BackgroundTransparency = 0.2,
                TextColor3 = T.TEXT_LIGHT,
                Font = Enum.Font.SourceSansBold,
                TextSize = 10,
                BorderSizePixel = 0,
            }, item)
            Corner(flyBtn, UDim.new(0, 4))
            
            flyBtn.Activated:Connect(function()
                if State.isFlying then
                    Flight.stopFly()
                else
                    Flight.startFly("Player", plr)
                end
                UIUpdate.updatePlayerList()
            end)
        end
    end
    
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, count * 28)
end

function UIUpdate.updateSavedList()
    for _, c in ipairs(SavedList:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end
    end
    
    for idx, item in ipairs(State.savedLocations) do
        local isEven = (idx % 2 == 0)
        local isSelected = (State.selectedLocation == item)
        
        local container = New("Frame", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = isSelected and T.SUCCESS or (isEven and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(215, 220, 230)),
            BackgroundTransparency = isSelected and 0.25 or 0.45,
            BorderSizePixel = 0,
        }, SavedList)
        Corner(container, UDim.new(0, 4))
        
        New("TextButton", {
            Size = UDim2.new(0.55, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "📍 " .. item.name,
            TextColor3 = isSelected and T.TEXT_LIGHT or T.TEXT,
            Font = Enum.Font.SourceSansBold,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, container).Activated:Connect(function()
            State.selectedLocation = item
            UIUpdate.updateSavedList()
        end)
        
        local flyBtn = New("TextButton", {
            Size = UDim2.new(0.22, 0, 0.8, 0),
            Position = UDim2.new(0.57, 0, 0.1, 0),
            Text = "🚀 Bay",
            BackgroundColor3 = T.SUCCESS,
            BackgroundTransparency = 0.2,
            TextColor3 = T.TEXT_LIGHT,
            Font = Enum.Font.SourceSansBold,
            TextSize = 9,
            BorderSizePixel = 0,
        }, container)
        Corner(flyBtn, UDim.new(0, 4))
        flyBtn.Activated:Connect(function()
            Flight.startFly("Location", item)
        end)
        
        local delBtn = New("TextButton", {
            Size = UDim2.new(0.16, 0, 0.8, 0),
            Position = UDim2.new(0.82, 0, 0.1, 0),
            Text = "Xóa",
            BackgroundColor3 = T.DANGER,
            BackgroundTransparency = 0.2,
            TextColor3 = T.TEXT_LIGHT,
            Font = Enum.Font.SourceSansBold,
            TextSize = 9,
            BorderSizePixel = 0,
