-- [[ BANANA CAT HUB - TỰ THÊM SCRIPT CỦA BẠN ]] --
local HttpService = game:GetService("HttpService")
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

-- Tên file lưu danh sách Script của bạn trên thiết bị
local fileName = "BananaCat_MyScripts.json"

-- Hàm tải danh sách script đã lưu
local function loadMyScripts()
    if isfile and isfile(fileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(fileName))
        end)
        if success then return result end
    end
    return {}
end

-- Hàm lưu danh sách script
local function saveMyScripts(tbl)
    if writefile then
        writefile(fileName, HttpService:JSONEncode(tbl))
    end
end

-- Lấy dữ liệu script đã lưu
local mySavedScripts = loadMyScripts()

-- 1. TẠO CỬA SỔ CHÍNH
local Window = OrionLib:MakeWindow({
    Name = "🍌 BANANA CAT - CUSTOM HUB", 
    HidePremium = false, 
    SaveConfig = false, 
    IntroEnabled = true,
    IntroText = "Banana Cat Custom Hub Loaded!",
    IntroIcon = "rbxassetid://4483345998"
})

-- ==================== TAB 1: DANH SÁCH SCRIPT ĐÃ THÊM ====================
local TabList = Window:MakeTab({
    Name = "📜 Script Của Bạn",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

TabList:AddSection({ Name = "Danh Sách Script Bạn Đã Thêm" })

-- Hàm chạy Script (Tự nhận diện Link http hoặc Code thường)
local function runScript(code)
    local success, err = pcall(function()
        if code:sub(1, 4) == "http" then
            loadstring(game:HttpGet(code))()
        else
            local func = loadstring(code)
            if func then func() end
        end
    end)
    
    if not success then
        OrionLib:MakeNotification({
            Name = "Lỗi Chạy Script!",
            Content = "Code/Link bị lỗi hoặc không chạy được.",
            Time = 3
        })
    end
end

-- Tạo các nút bấm từ danh sách đã lưu
if #mySavedScripts == 0 then
    TabList:AddLabel("Chưa có script nào. Hãy qua Tab 'Thêm Script' để thêm!")
else
    for index, scriptData in ipairs(mySavedScripts) do
        TabList:AddButton({
            Name = "▶ " .. scriptData.Name,
            Callback = function()
                OrionLib:MakeNotification({
                    Name = "Đang chạy...",
                    Content = scriptData.Name,
                    Time = 2
                })
                runScript(scriptData.Code)
            end    
        })
    end
end

-- Nút Xóa Tất Cả Script Đã Lưu
TabList:AddSection({ Name = "Quản Lý" })
TabList:AddButton({
    Name = "🗑️ Xóa Tất Cả Script Đã Lưu",
    Callback = function()
        if isfile and isfile(fileName) then
            delfile(fileName)
            OrionLib:MakeNotification({
                Name = "Thành công",
                Content = "Đã xóa dữ liệu! Hãy mở lại Menu.",
                Time = 3
            })
        end
    end
})


-- ==================== TAB 2: Ô NHẬP ĐỂ THÊM SCRIPT MỚI ====================
local TabAdd = Window:MakeTab({
    Name = "➕ Thêm Script Mới",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

TabAdd:AddSection({ Name = "Nhập Thông Tin Script Mới" })

local inputName = ""
local inputCode = ""

-- Ô 1: Nhập Tên
TabAdd:AddTextbox({
    Name = "1. Nhập Tên Script (Ví dụ: Redz Hub Blox Fruit)",
    Default = "",
    TextDisappear = false,
    Callback = function(Value)
        inputName = Value
    end
})

-- Ô 2: Nhập Link hoặc Code
TabAdd:AddTextbox({
    Name = "2. Dán Link raw (https://...) hoặc Code Lua vào đây",
    Default = "",
    TextDisappear = false,
    Callback = function(Value)
        inputCode = Value
    end
})

-- Nút Lưu Script
TabAdd:AddButton({
    Name = "💾 LƯU SCRIPT NÀY VÀO MENU",
    Callback = function()
        if inputName == "" or inputCode == "" then
            OrionLib:MakeNotification({
                Name = "Thiếu Thông Tin!",
                Content = "Vui lòng nhập cả Tên và Link/Code!",
                Time = 3
            })
            return
        end

        -- Thêm vào danh sách
        table.insert(mySavedScripts, {
            Name = inputName,
            Code = inputCode
        })

        -- Lưu vào File lưu trữ của Executor
        saveMyScripts(mySavedScripts)

        OrionLib:MakeNotification({
            Name = "Thành Công!",
            Content = "Đã lưu script '" .. inputName .. "'. Hãy chạy lại Menu để cập nhật nút!",
            Time = 5
        })
    end    
})

OrionLib:Init()
