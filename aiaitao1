-- CƠ CHẾ BAY TỚI MỤC TIÊU (TWEEN FLY)
---------------------------------------------------------
local function tweenToTarget(hrp, targetCFrame, flySpeed)
    if stopRequested then return false end

    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local duration = distance / flySpeed

    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    currentTween:Play()

    local finished = false
    local connection
    connection = currentTween.Completed:Connect(function() finished = true end)

    while not finished do
        if stopRequested then
            if currentTween then currentTween:Cancel() end
            if connection then connection:Disconnect() end
            return false
        end
        task.wait()
    end

    if connection then connection:Disconnect() end
    return true
end

stopFly = function()
    stopRequested = true
    if currentTween then currentTween:Cancel() end
    isFlying = false
    updateNoclipState()
    updatePlayerList()
    updateSavedList()
    updateWallList()
end

startFly = function(mode, targetObj)
    if isFlying then return end

    if followPlayerActive then stopFollow() end

    local getTargetPos = nil

    if mode == "Player" then
        if not targetObj then return end
        selectedPlayer = targetObj
        getTargetPos = function()
            local p = getTargetPart(targetObj)
            return p and p.Position
        end
    elseif mode == "Location" then
        if not targetObj then return end
        selectedLocation = targetObj
        getTargetPos = function()
            return targetObj.pos
        end
    elseif mode == "Wall" then
        if not targetObj or not targetObj.part or not targetObj.part.Parent then return end
        selectedWall = targetObj
        getTargetPos = function()
            if targetObj and targetObj.part and targetObj.part.Parent then
                local wallPart = targetObj.part
                return wallPart.Position + Vector3.new(0, (wallPart.Size.Y / 2) + 2.5, 0)
            end
            return nil
        end
    end

    if not getTargetPos or not getTargetPos() then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local flyHeight = tonumber(P_HeightBox.Text) or 150
    local flySpeed = tonumber(P_SpeedBox.Text) or 100

    isFlying = true
    stopRequested = false
    
    updatePlayerList()
    updateSavedList()
    updateWallList()

    updateNoclipState()
    local oldGravity = workspace.Gravity
    workspace.Gravity = 0

    -- Bước 1: Bay vọt lên không trung
    local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
    local ok1 = tweenToTarget(hrp, CFrame.new(skyPos), flySpeed)

    -- Bước 2: Bay ngang tới vị trí mục tiêu
    if ok1 and not stopRequested then
        local dest = getTargetPos()
        if dest then
            local overhead = dest + Vector3.new(0, flyHeight, 0)
            local ok2 = tweenToTarget(hrp, CFrame.new(overhead), flySpeed)

            -- Bước 3: Đáp thẳng xuống vị trí đích
            if ok2 and not stopRequested then
                dest = getTargetPos()
                if dest then
                    tweenToTarget(hrp, CFrame.new(dest), flySpeed)
                end
            end
        end
    end

    workspace.Gravity = oldGravity
    isFlying = false
    updateNoclipState()
    
    updatePlayerList()
    updateSavedList()
    updateWallList()
end

