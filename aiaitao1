-- Hàm cập nhật danh sách người chơi
local function RefreshPlayerList()
    for _, child in pairs(ScrollList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(0.95, 0, 0, 30)
            Btn.BackgroundColor3 = (SelectedPlayer == plr) and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(40, 40, 45)
            Btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.TextSize = 13
            Btn.Parent = ScrollList
            
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

            Btn.MouseButton1Click:Connect(function()
                SelectedPlayer = plr
                RefreshPlayerList() -- Reset màu nút được chọn
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, count * 35)
end

-- Tự động làm mới danh sách khi có người vào/ra
Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(RefreshPlayerList)
RefreshPlayerList()

-- Sự kiện thay đổi tốc độ
SpeedInput.FocusLost:Connect(function()
    local num = tonumber(SpeedInput.Text)
    if num then
        FlySpeed = num
        SpeedLabel.Text = "Tốc độ bay (Hiện tại: " .. tostring(FlySpeed) .. "):"
    else
        SpeedInput.Text = tostring(FlySpeed)
    end
end)

-- Sự kiện Bật/Tắt Bay
ToggleBtn.MouseButton1Click:Connect(function()
    IsFlying = not IsFlying
    if IsFlying then
        ToggleBtn.Text = "Trạng Thái: ĐANG BAY 🚀"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "Trạng Thái: TẮT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Logic Bay & Noclip
RunService.Stepped:Connect(function(time, deltaTime)
    if IsFlying and SelectedPlayer and SelectedPlayer.Character and SelectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            
            -- Xuyên tường (Noclip)
            for _, part in pairs(myChar:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local myHRP = myChar.HumanoidRootPart
            local targetHRP = SelectedPlayer.Character.HumanoidRootPart
            
            local distance = (targetHRP.Position - myHRP.Position).Magnitude

            if distance > 3 then
                local direction = (targetHRP.Position - myHRP.Position).Unit
                myHRP.CFrame = CFrame.new(myHRP.Position + direction * (FlySpeed * deltaTime), targetHRP.Position)
                myHRP.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end
end)
