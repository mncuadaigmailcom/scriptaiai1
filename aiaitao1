-- LOGIC ESP HIỆN TÊN & KHOẢNG CÁCH (TỐI ƯU SIÊU NHẸ)
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not isEspActive then return end
    local myHRP = getTargetHRP(LocalPlayer)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local head = plr.Character.Head
            local bbg = head:FindFirstChild("BananaESP")
            
            if not bbg then
                bbg = Instance.new("BillboardGui")
                bbg.Name = "BananaESP"
                bbg.Size = UDim2.new(0, 150, 0, 30)
                bbg.AlwaysOnTop = true
                bbg.ExtentsOffset = Vector3.new(0, 2, 0)
                
                local txt = Instance.new("TextLabel")
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.TextColor3 = Color3.fromRGB(0, 255, 150)
                txt.Font = Enum.Font.SourceSansBold
                txt.TextSize = 12
                txt.TextStrokeTransparency = 0
                txt.Parent = bbg
                bbg.Parent = head
            end

            local dist = myHRP and math.floor((head.Position - myHRP.Position).Magnitude) or 0
            bbg.TextLabel.Text = string.format("%s\n[%dm]", plr.DisplayName, dist)
        end
    end
end)

local function toggleEsp()
    isEspActive = not isEspActive
    if isEspActive then
        EspBtn.Text = "📡 ESP ALL PLAYERS: ON"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    else
        EspBtn.Text = "📡 ESP ALL PLAYERS: OFF"
        EspBtn.BackgroundColor3 = Color3.fromRGB(60, 65, 80)
        -- Xóa ESP
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("Head") and plr.Character.Head:FindFirstChild("BananaESP") then
                plr.Character.Head.BananaESP:Destroy()
            end
        end
    end
end

