local function setNoclip(on)
    if on then
        if noclipConn then return end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                -- HRP luôn false; phần còn lại bật lại
                p.CanCollide = (p.Name ~= "HumanoidRootPart")
            end
        end
        local hrp = safeHRP(LocalPlayer)
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function refreshMovementLock()
    local need = isFlying or isFollowing
    setNoclip(need)
    workspace.Gravity = need and 0 or 196.2
end

-------------------------------------------------
-- SMOOTH MOVE (hybrid tween, cancel-safe)
-------------------------------------------------
local function cancelTween()
    stopFlag = true
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
end

local function moveTo(hrp, goalCF, speed)
    if stopFlag or not hrp then return false end
    local dist = (goalCF.Position - hrp.Position).Magnitude
    if dist < 0.5 then
        hrp.CFrame = goalCF
        return true
    end
    local dur = math.clamp(dist / math.max(speed, 1), 0.05, 15)
    local ti = TweenInfo.new(dur, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, ti, {CFrame = goalCF})
    currentTween:Play()

    local finished = false
    local conn
    conn = currentTween.Completed:Connect(function()
        finished = true
    end)

    while not finished do
        if stopFlag then
            pcall(function() currentTween:Cancel() end)
            if conn then conn:Disconnect() end
            return false
        end
        -- khóa vật lý mỗi frame để không bị anti-cheat kéo / rơi
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
    if conn then conn:Disconnect() end
    return not stopFlag
end

-------------------------------------------------
-- STOP / FLY / FOLLOW
-------------------------------------------------
local function stopAll()
    cancelTween()
    isFlying = false
    isFollowing = false
    if followConn then followConn:Disconnect() followConn = nil end
    refreshMovementLock()
    FlyBtn.Text = "BAY TOI TARGET"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(35, 175, 95)
    FollowBtn.Text = "BU NGUOI (FOLLOW): OFF"
    FollowBtn.BackgroundColor3 = Color3.fromRGB(50, 56, 72)
end

local function readSpeedHeight()
    flySpeed  = math.clamp(tonumber(SpeedBox.Text) or 120, 10, 2000)
    flyHeight = math.clamp(tonumber(HeightBox.Text) or 140, 0, 2000)
    SpeedBox.Text  = tostring(flySpeed)
    HeightBox.Text = tostring(flyHeight)
end

local function startFly()
    if isFlying then
        stopAll()
        toast("Da dung bay", Color3.fromRGB(255, 120, 80))
        return
    end
    if not selectedPlayer then
        toast("Chua chon nguoi choi!", Color3.fromRGB(255, 80, 80))
        return
    end
    local my = safeHRP(LocalPlayer)
    local tg = safeHRP(selectedPlayer)
    if not my or not tg then
        toast("Khong tim thay nhan vat", Color3.fromRGB(255, 80, 80))
        return
    end

    if isFollowing then stopAll() end

    isFlying = true
    stopFlag = false
    readSpeedHeight()
    refreshMovementLock()
    FlyBtn.Text = "DANG BAY... (bam de dung)"
    FlyBtn.BackgroundColor3 = Color3.fromRGB(220, 70, 70)
    toast("Dang bay toi " .. selectedPlayer.DisplayName, Color3.fromRGB(80, 200, 255))

    task.spawn(function()
        local look = my.CFrame.LookVector
        local start = my.Position
        local sky = Vector3.new(start.X, start.Y + flyHeight, start.Z)

        -- Phase 1: lên trời
        if not moveTo(my, CFrame.new(sky, sky + look), flySpeed) then stopAll() return end

        -- Phase 2: ngang tới trên đầu target (update live)
        tg = safeHRP(selectedPlayer)
        if not tg then stopAll() return end
        local overhead = Vector3.new(tg.Position.X, sky.Y, tg.Position.Z)
        local dir = overhead - sky
        local look2 = dir.Magnitude > 0.1 and dir.Unit or look
        if not moveTo(my, CFrame.new(overhead, overhead + look2), flySpeed) then stopAll() return end

        -- Phase 3: đáp sau lưng
        tg = safeHRP(selectedPlayer)
        if not tg then stopAll() return end
        moveTo(my, tg.CFrame * CFrame.new(0, 0, 3), flySpeed)

        stopAll()
        toast("Da den noi!", Color3.fromRGB(80, 255, 140))
    end)
end

local function startFollow()
    if isFollowing then
        stopAll()
        toast("Follow OFF", Color3.fromRGB(255, 120, 80))
        return
    end
    if not selectedPlayer then
        toast("Chua chon nguoi choi!", Color3.fromRGB(255, 80, 80))
        return
    end

    if isFlying then stopAll() end

    isFollowing = true
    stopFlag = false
    readSpeedHeight()
    refreshMovementLock()
    FollowBtn.Text = "BU NGUOI (FOLLOW): ON"
    FollowBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    toast("Dang bu: " .. selectedPlayer.DisplayName, Color3.fromRGB(80, 180, 255))

    -- Phase tiếp cận nhanh 1 lần (3 pha), sau đó bám realtime
    task.spawn(function()
        local my = safeHRP(LocalPlayer)
        local tg = safeHRP(selectedPlayer)
        if my and tg then
            local start = my.Position
            local sky = Vector3.new(start.X, start.Y + flyHeight, start.Z)
            if not moveTo(my, CFrame.new(sky), flySpeed) then return end
            tg = safeHRP(selectedPlayer)
            if not tg then stopAll() return end
            local overhead = Vector3.new(tg.Position.X, sky.Y, tg.Position.Z)
            if not moveTo(my, CFrame.new(overhead), flySpeed) then return end
            tg = safeHRP(selectedPlayer)
            if not tg then stopAll() return end
            if not moveTo(my, tg.CFrame * CFrame.new(0, 0, 2), flySpeed) then return end
        end

        -- Realtime stick (mượt, không tạo tween liên tục gây giật)
        if followConn then followConn:Disconnect() end
        followConn = RunService.Heartbeat:Connect(function(dt)
            if not isFollowing or stopFlag then return end
            local me = safeHRP(LocalPlayer)
            local target = safeHRP(selectedPlayer)
            if not me or not target then
                stopAll()
                toast("Mat target - follow tat", Color3.fromRGB(255, 80, 80))
                return
            end
            readSpeedHeight()
            local goal = target.CFrame * CFrame.new(0, 0, 2)
            local pos = me.Position
            local dest = goal.Position
            local dist = (dest - pos).Magnitude
            if dist > 0.8 then
                local step = math.min(dist, flySpeed * dt * 1.25)
                local nextPos = pos + (dest - pos).Unit * step
                me.CFrame = CFrame.new(nextPos, nextPos + target.CFrame.LookVector)
            else
                me.CFrame = goal
            end
            me.AssemblyLinearVelocity = Vector3.zero
            me.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
end

