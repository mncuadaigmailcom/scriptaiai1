-- 4. ĐĂNG KÝ NÚT BẤM
----------------------------------------------------
createButton("Bay Lên", Color3.fromRGB(0, 150, 255), 1, function() startAction("UP") end)
createButton("Bay Xuống", Color3.fromRGB(0, 150, 255), 2, function() startAction("DOWN") end)
createButton("Bay Thẳng", Color3.fromRGB(0, 150, 255), 3, function() startAction("FORWARD") end)
createButton("TẮT", Color3.fromRGB(230, 50, 50), 4, function() stopAll() end)

