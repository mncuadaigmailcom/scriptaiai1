-- [[ BANANA CAT HUB - FIX MENU NOT SHOWING ]] --
local HttpService = game:GetService("HttpService")
local fileName = "BananaCat_Data.json"
local mySavedScripts = {}

-- Kiểm tra và tải file an toàn (Không làm lag/văng menu)
pcall(function()
    if isfile and readfile and isfile(fileName) then
        mySavedScripts = HttpService:JSONDecode(readfile(fileName))
    end
end)
if type(mySavedScripts) ~= "table" then mySavedScripts = {} end

-- Hàm lưu file an toàn
local function saveScriptData()
    pcall(function()
        if writefile then
            writefile(fileName, HttpService:JSONEncode(mySavedScripts))
        end
    end)
end

-- Load Thư Viện Rayfield UI (Hoạt động tốt 100% trên mọi Executor)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Tạo Cửa Sổ Menu
local Window = Rayfield:CreateWindow({
   Name = "🍌 BANANA CAT HUB - CUSTOM",
   Icon = 0,
   LoadingTitle = "Banana Cat Hub",
   LoadingSubtitle = "Đang tải danh sách Script...",
   Theme = "Default",
   DisableRayfieldPrompts = false,
   DisableBuildWarnings = true,
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

-- ==================== TAB 1: DANH SÁCH SCRIPT ====================
local TabList = Window:CreateTab("📜 Script Đã Lưu", 4483345998)

TabList:CreateSection("Bấm vào bên dưới để kích hoạt Script")

-- Hàm thực thi script khi bấm nút
local function executeCode(code)
    local success, err = pcall(function()
        if code:sub(1, 4) == "http" then
            loadstring(game:HttpGet(code))()
        else
            local func = loadstring(code)
            if func then func() end
        end
    end)
    
    if success then
        Rayfield:Notify({Title = "Thành công!", Content = "Đã chạy Script thành công.", Duration = 3})
    else
        Rayfield:Notify({Title = "Lỗi Script!", Content = "Code hoặc Link không hợp lệ!", Duration = 4})
    end
end

-- Tải danh sách các nút bấm
if #mySavedScripts == 0 then
    TabList:CreateLabel("Chưa có script! Sang Tab 'Thêm Script' để dán code vào nhé.")
else
    for i, item in ipairs(mySavedScripts) do
        TabList:CreateButton({
           Name = "▶ " .. item.Name,
           Callback = function()
               Rayfield:Notify({Title = "Đang chạy...", Content = item.Name, Duration = 2})
               executeCode(item.Code)
           end,
        })
    end
end

-- Nút Quản Lý
TabList:CreateSection("Quản Lý")
TabList:CreateButton({
   Name = "🗑️ Xóa Tất Cả Script Đã Lưu",
   Callback = function()
       pcall(function()
           if delfile and isfile(fileName) then delfile(fileName) end
       end)
       mySavedScripts = {}
       Rayfield:Notify({Title = "Đã Xóa!", Content = "Hãy chạy lại Script Hub để làm mới Menu.", Duration = 4})
   end,
})


-- ==================== TAB 2: THÊM SCRIPT MỚI ====================
local TabAdd = Window:CreateTab("➕ Thêm Script Mới", 4483345998)

TabAdd:CreateSection("Nhập Script Của Bạn Về Đây")

local inputName = ""
local inputCode = ""

TabAdd:CreateInput({
   Name = "1. Nhập Tên Script",
   PlaceholderText = "Ví dụ: Redz Hub Blox Fruit",
   RemoveTextOnFocus = false,
   Callback = function(Text)
       inputName = Text
   end,
})

TabAdd:CreateInput({
   Name = "2. Dán Link (https://...) hoặc Code Lua",
   PlaceholderText = "Dán link raw hoặc code lua vào đây...",
   RemoveTextOnFocus = false,
   Callback = function(Text)
       inputCode = Text
   end,
})

TabAdd:CreateButton({
   Name = "💾 LƯU SCRIPT VÀO MENU",
   Callback = function()
       if inputName == "" or inputCode == "" then
           Rayfield:Notify({Title = "Thiếu Thông Tin!", Content = "Bạn chưa nhập Tên hoặc Link/Code!", Duration = 3})
           return
       end

       -- Lưu thông tin
       table.insert(mySavedScripts, {Name = inputName, Code = inputCode})
       saveScriptData()

       Rayfield:Notify({
           Title = "Đã Lưu Thành Công!",
           Content = "Hãy bấm Execute lại script Banana Cat để hiện nút mới nhé!",
           Duration = 5
       })
   end,
})
