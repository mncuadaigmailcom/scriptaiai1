-------------------------------------------------
local function ensureEspFolder()
    if espFolder and espFolder.Parent then return end
    espFolder = Instance.new("Folder")
    espFolder.Name = "BananaESP_Folder"
    espFolder.Parent = ScreenGui
end

local function removeEsp(plr)
    local pack = espMap[plr]
    if pack then
        if pack.bbg then pack.bbg:Destroy() end
        espMap[plr] = nil
    end
end

local function clearAllEsp()
    for plr in pairs(espMap) do removeEsp(plr) end
    if espFolder then espFolder:ClearAllChildren() end
end

local function upsertEsp(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    local head = char and char:FindFirstChild("Head")
    if not head then removeEsp(plr) return end

    local pack = espMap[plr]
    if not pack or not pack.bbg or not pack.bbg.Parent then
        ensureEspFolder()
        local bbg = Instance.new("BillboardGui")
        bbg.Name = "ESP_" .. plr.Name
        bbg.Size = UDim2.new(0, 180, 0, 42)
        bbg.AlwaysOnTop = true
        bbg.MaxDistance = 5000
        bbg.ExtentsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
        bbg.Adornee = head
        bbg.Parent = espFolder

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 13
        txt.TextColor3 = Color3.fromRGB(80, 255, 160)
        txt.TextStrokeTransparency = 0.3
        txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        txt.Parent = bbg

        pack = {bbg = bbg, label = txt}
        espMap[plr] = pack
    else
        pack.bbg.Adornee = head
    end

    local my = safeHRP(LocalPlayer)
    local hrp = safeHRP(plr)
    local hum = safeHum(plr)
    local dist = (my and hrp) and math.floor((hrp.Position - my.Position).Magnitude) or 0
    local hp = hum and math.floor(hum.Health) or 0
    local maxHp = hum and math.floor(hum.MaxHealth) or 100
    local dead = hum and hum.Health <= 0
    pack.label.TextColor3 = dead and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(80, 255, 160)
    pack.label.Text = string.format("%s\nHP %d/%d  ·  %dm", plr.DisplayName, hp, maxHp, dist)
end

local lastEspUpdate = 0
RunService.RenderStepped:Connect(function()
    if not isEspOn then return end
    local now = tick()
    if now - lastEspUpdate < 0.12 then return end -- ~8fps update ESP = nhe
    lastEspUpdate = now
    for _, plr in ipairs(Players:GetPlayers()) do
        upsertEsp(plr)
    end
    -- dọn player đã out
    for plr in pairs(espMap) do
        if not plr.Parent then removeEsp(plr) end
    end
end)

local function toggleEsp()
    isEspOn = not isEspOn
    if isEspOn then
        EspBtn.Text = "ESP PLAYERS: ON"
        EspBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        ensureEspFolder()
        toast("ESP ON", Color3.fromRGB(80, 200, 255))
    else
        EspBtn.Text = "ESP PLAYERS: OFF"
        EspBtn.BackgroundColor3 = Color3.fromRGB(50, 56, 72)
        clearAllEsp()
        toast("ESP OFF", Color3.fromRGB(255, 120, 80))
    end
end

