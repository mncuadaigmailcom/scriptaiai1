end

----------------------------------------------------
-- LOGIC TẠO KÍNH & XUYÊN TƯỜNG
----------------------------------------------------
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

LocalPlayer.CharacterAdded:Connect(function(newChar)
	Character = newChar
end)

-- Hàm tạo tấm kính
local function createGlass()
	if not glassPlatform or not glassPlatform.Parent then
		glassPlatform = Instance.new("Part")
		glassPlatform.Name = "GlassPlatform_Unique"
		glassPlatform.Size = Vector3.new(6, 0.5, 6) -- Độ rộng tấm kính
		glassPlatform.Material = Enum.Material.Glass
		glassPlatform.Transparency = 0.3 -- Độ trong suốt kính
		glassPlatform.Color = Color3.fromRGB(0, 255, 255) -- Màu xanh lam kính
		glassPlatform.Anchored = true
		glassPlatform.CanCollide = true -- Luôn giữ va chạm để người đứng lên được
		glassPlatform.Parent = workspace
	end
end

-- Hàm dừng hoàn toàn
local function stopAll()
	mode = "OFF"

	if moveConnection then moveConnection:Disconnect() moveConnection = nil end
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end

	if glassPlatform then
		glassPlatform:Destroy()
		glassPlatform = nil
	end

	-- Trả lại va chạm bình thường cho nhân vật
	if Character then
		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

-- Hàm bắt đầu chức năng
local function startAction(newMode)
	stopAll() -- Xóa trạng thái cũ
	mode = newMode
	createGlass()

	-- 1. Vòng lặp Noclip (Xuyên mọi bức tường nhưng TRỪ tấm kính)
	noclipConnection = RunService.Stepped:Connect(function()
		if Character then
			for _, part in pairs(Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
		-- Giữ cho tấm kính luôn có va chạm
		if glassPlatform then
			glassPlatform.CanCollide = true
		end
	end)

	-- 2. Vòng lặp di chuyển nhân vật & kính
	moveConnection = RunService.Heartbeat:Connect(function()
		if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
		local hrp = Character.HumanoidRootPart

		-- Cập nhật hướng di chuyển nhân vật
		if mode == "UP" then
			hrp.CFrame = hrp.CFrame + Vector3.new(0, flySpeed, 0)
		elseif mode == "DOWN" then
			hrp.CFrame = hrp.CFrame - Vector3.new(0, flySpeed, 0)
		elseif mode == "FORWARD" then
			hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * flySpeed)
		end

		-- Đặt tấm kính luôn ở ngay dưới chân nhân vật
		if glassPlatform then
			glassPlatform.CFrame = hrp.CFrame * CFrame.new(0, -3.2, 0)
		end
	end)
end

----------------------------------------------------
-- KẾT NỐI NÚT BẤM
----------------------------------------------------
createButton("Bay Lên", Color3.fromRGB(0, 150, 255), 1, function()
	startAction("UP")
end)

createButton("Bay Xuống", Color3.fromRGB(0, 150, 255), 2, function()
	startAction("DOWN")
end)

createButton("Bay Thẳng", Color3.fromRGB(0, 150, 255), 3, function()
	startAction("FORWARD")
end)

createButton("TẮT", Color3.fromRGB(230, 50, 50), 4, function()
	stopAll()
end)
