	btn.Size = UDim2.new(0.9, 0, 0, 35)
	btn.Text = text
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 15
	btn.LayoutOrder = order
	btn.BorderSizePixel = 0
	btn.Parent = MainFrame

	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 6)
	BtnCorner.Parent = btn

	btn.MouseButton1Click:Connect(callback)
	return btn
end

----------------------------------------------------
-- 3. LOGIC XUYÊN TƯỜNG KÍNH
----------------------------------------------------
local flySpeed = 0.8
local mode = "OFF"
local glassPlatform = nil
local noclipConnection = nil
local moveConnection = nil

local function getCharacter()
	return LocalPlayer.Character
end

local function createGlass()
	if not glassPlatform or not glassPlatform.Parent then
		glassPlatform = Instance.new("Part")
		glassPlatform.Name = "GlassPlatform_Part"
		glassPlatform.Size = Vector3.new(6, 0.5, 6)
		glassPlatform.Material = Enum.Material.Glass
		glassPlatform.Transparency = 0.3
		glassPlatform.Color = Color3.fromRGB(0, 255, 255)
		glassPlatform.Anchored = true
		glassPlatform.CanCollide = true
		glassPlatform.Parent = workspace
	end
end

local function stopAll()
	mode = "OFF"

	if moveConnection then moveConnection:Disconnect() moveConnection = nil end
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end

	if glassPlatform then
		glassPlatform:Destroy()
		glassPlatform = nil
	end

	local char = getCharacter()
	if char then
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

local function startAction(newMode)
	stopAll()
	mode = newMode
	createGlass()

	-- Vòng lặp Noclip (Xuyên tường)
	noclipConnection = RunService.Stepped:Connect(function()
		local char = getCharacter()
		if char then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
		if glassPlatform then
			glassPlatform.CanCollide = true -- Giữ cho kính luôn đứng được
		end
	end)

	-- Vòng lặp di chuyển
	moveConnection = RunService.Heartbeat:Connect(function()
		local char = getCharacter()
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end
		local hrp = char.HumanoidRootPart

		if mode == "UP" then
			hrp.CFrame = hrp.CFrame + Vector3.new(0, flySpeed, 0)
		elseif mode == "DOWN" then
			hrp.CFrame = hrp.CFrame - Vector3.new(0, flySpeed, 0)
		elseif mode == "FORWARD" then
			hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * flySpeed)
		end

		if glassPlatform then
			glassPlatform.CFrame = hrp.CFrame * CFrame.new(0, -3.2, 0)
		end
	end)
end

