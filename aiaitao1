local function SpawnWall(name, sizeX, sizeY, sizeZ, trans, canCollide)
    local r = Root(); if not r then return end
    wallCounter = wallCounter + 1
    local wname = (name and name ~= "") and name or ("Tường kính #"..wallCounter)
    local w = New("Part", {
        Name = "BananaWall_"..wallCounter,
        Size = Vector3.new(
            math.clamp(sizeX or 15, 0.5, 500),
            math.clamp(sizeY or 10, 0.5, 500),
            math.clamp(sizeZ or  1, 0.1, 100)
        ),
        CFrame = r.CFrame * CFrame.new(0, (sizeY or 10)/2 - 3, -((sizeZ or 1)/2 + 4)),
        Anchored = true,
        CanCollide = (canCollide == nil) and true or canCollide,
