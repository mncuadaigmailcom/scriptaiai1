local function updateGlow()
    local char = Util.getChar()
    
    if not State.glowActive or not char then
        Util.cleanup(State.glowLight)
        return
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if hrp then
        if not State.glowLight or State.glowLight.Parent ~= hrp then
            Util.cleanup(State.glowLight)
            local light = Instance.new("PointLight")
            light.Name = "BananaGlow"
            light.Color = Color3.fromRGB(255, 245, 200)
            light.Brightness = 1.2
            light.Shadows = false
            light.Parent = hrp
            State.glowLight = light
        end
        
        local range = tonumber(GlowRangeBox.Text) or CONSTANTS.GLOW_RANGE_DEFAULT
        State.glowLight.Range = math.clamp(range, CONSTANTS.GLOW_RANGE_MIN, CONSTANTS.GLOW_RANGE_MAX)
    end
end

local function updateHeightPillar()
    if not State.showHeightPillar then
        if State.heightConn then
            State.heightConn:Disconnect()
            State.heightConn = nil
        end
        Util.cleanup(State.heightPillar)
        return
    end
    
    if not State.heightPillar then
        State.heightPillar = Instance.new("Part")
        State.heightPillar.Name = "HeightPillar"
        State.heightPillar.Shape = Enum.PartType.Cylinder
        State.heightPillar.Material = Enum.Material.SmoothPlastic
        State.heightPillar.Color = Color3.fromRGB(220, 225, 235)
        State.heightPillar.Transparency = 0.4
        State.heightPillar.Anchored = true
        State.heightPillar.CanCollide = false
        State.heightPillar.Parent = workspace
    end
    
    if State.heightConn then
        State.heightConn:Disconnect()
    end
    
    State.heightConn = RunService.RenderStepped:Connect(function()
        local hrp = Util.getRoot()
        if hrp and State.heightPillar then
            local flyHeight = tonumber(P_HeightBox.Text) or CONSTANTS.FLY_HEIGHT_DEFAULT
            State.heightPillar.Size = Vector3.new(flyHeight, 2, 2)
            State.heightPillar.CFrame = CFrame.new(hrp.Position + Vector3.new(0, flyHeight/2, 0)) * CFrame.Angles(0, 0, math.rad(90))
        end
    end)
end

