local function getTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("Head")
        or char.PrimaryPart
        or char:FindFirstChildOfClass("BasePart")
end

local function isPlayerDeadOrKnocked(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local targetPart = getTargetPart(plr)
    if not targetPart then return true end
    if hum and hum.Health <= 0 then return true end
    if plr.Character:FindFirstChild("Knocked") or plr.Character:FindFirstChild("Downed") or plr.Character:FindFirstChild("Ragdoll") or plr.Character:FindFirstChild("Dead") then
        return true
    end
    if plr:FindFirstChild("DataFolder") and plr.DataFolder:FindFirstChild("Information") and plr.DataFolder.Information:FindFirstChild("IsKnocked") then
        if plr.DataFolder.Information.IsKnocked.Value == true then return true end
    end
    return false
end

-- KHÔI PHỤC VẬT LÝ CHUẨN ROBLOX
local function resetCharacterPhysics()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    local char = LocalPlayer.Character
    if not char then return end

    -- Khôi phục va chạm chuẩn của Roblox
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" then
                part.CanCollide = false
            else
                part.CanCollide = true
            end
        end
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- TẮT VÀ XÓA THẢM KÍNH
local function removeCarpet()
    if noclipCarpetPart then
        noclipCarpetPart:Destroy()
        noclipCarpetPart = nil
    end
    NoclipHUD.Visible = false
end

-- CẬP NHẬT TRẠNG THÁI NOCLIP TỔNG TỂ
local function updateNoclipState()
    local shouldNoclip = standaloneNoclipActive or followPlayerActive or isFlying

    if shouldNoclip then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part ~= noclipCarpetPart then 
                            part.CanCollide = false 
                        end
                    end
                end
            end)
        end
    else
        removeCarpet()
        resetCharacterPhysics()
    end
end

