function ESP.updateAll()
    -- Chỉ update mỗi 0.1s để tiết kiệm CPU
    local myHrp = Util.getLocalRoot()
    
    -- Update Player ESP
    if State.esp.players.all or State.esp.players.single then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            
            local shouldShow = State.esp.players.all or 
                              (State.esp.players.single and State.selectedPlayer == plr)
            
            if shouldShow and plr.Character then
                ESP.createPlayerESP(plr)
                local data = State.esp.players.cache[plr]
                if data then
                    local target = Util.getPlayerTarget(plr)
                    if target then
                        data.gui.Adornee = target
                        data.gui.Parent = (CoreGui:FindFirstChild("FlyBananaGUI") or 
                                          LocalPlayer:FindFirstChild("PlayerGui"))
                        
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        local dist = myHrp and math.floor((target.Position - myHrp.Position).Magnitude) or 0
                        local hp = hum and math.floor(hum.Health) or 0
                        local maxHp = hum and math.floor(hum.MaxHealth) or 100
                        
                        if Util.isPlayerDown(plr) then
                            if not State.downedTimeTracker[plr] then
                                State.downedTimeTracker[plr] = tick()
                            end
                            local elapsed = math.floor(tick() - State.downedTimeTracker[plr])
                            data.label.TextColor3 = THEME.DANGER
                            data.label.Text = string.format("🔴 %s [DOWN %ds]\n⚡ HP: %d/%d | 📏 %dm", 
                                plr.Name, elapsed, hp, maxHp, dist)
                        else
                            State.downedTimeTracker[plr] = nil
                            data.label.TextColor3 = Color3.fromRGB(0, 255, 128)
                            data.label.Text = string.format("👤 %s\n💚 HP: %d/%d | 📏 %dm", 
                                plr.Name, hp, maxHp, dist)
                        end
                    end
                end
            else
                ESP.removePlayerESP(plr)
            end
        end
    else
        for plr in pairs(State.esp.players.cache) do
            ESP.removePlayerESP(plr)
        end
    end
    
    -- Update Location ESP
    if State.esp.locations.all or State.esp.locations.single then
        for _, item in ipairs(State.savedLocations) do
            local shouldShow = State.esp.locations.all or 
                              (State.esp.locations.single and State.selectedLocation == item)
            
            if shouldShow then
                ESP.createLocationESP(item)
                local data = State.esp.locations.cache[item]
                if data then
                    data.attachment.WorldPosition = item.pos
                    data.gui.Parent = (CoreGui:FindFirstChild("FlyBananaGUI") or 
                                      LocalPlayer:FindFirstChild("PlayerGui"))
                    local dist = myHrp and math.floor((item.pos - myHrp.Position).Magnitude) or 0
                    data.label.Text = string.format("📍 %s\n📏 %dm", item.name, dist)
                end
            else
                ESP.removeLocationESP(item)
            end
        end
    else
        for item in pairs(State.esp.locations.cache) do
            ESP.removeLocationESP(item)
        end
    end
    
    -- Update Wall ESP
    if State.esp.walls.all or State.esp.walls.single then
        for _, item in ipairs(State.spawnedWalls) do
            if item.part and item.part.Parent then
                local shouldShow = State.esp.walls.all or 
                                  (State.esp.walls.single and State.selectedWall == item)
                
                if shouldShow then
                    ESP.createWallESP(item)
                    local data = State.esp.walls.cache[item]
                    if data then
                        data.gui.Parent = (CoreGui:FindFirstChild("FlyBananaGUI") or 
                                          LocalPlayer:FindFirstChild("PlayerGui"))
                        local dist = myHrp and math.floor((item.part.Position - myHrp.Position).Magnitude) or 0
                        data.label.Text = string.format("🧱 %s\n📏 %dm", item.name, dist)
                    end
                else
                    ESP.removeWallESP(item)
                end
            else
                ESP.removeWallESP(item)
            end
        end
    else
        for item in pairs(State.esp.walls.cache) do
            ESP.removeWallESP(item)
        end
    end
end

