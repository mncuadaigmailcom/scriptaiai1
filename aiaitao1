local function TogFly()
	local r=Root(); local h=Hum(); if not r then return end
	if S.flying then
		bv=New("BodyVelocity",{MaxForce=Vector3.new(math.huge,math.huge,math.huge)},r)
		bg=New("BodyGyro",{MaxTorque=Vector3.new(math.huge,math.huge,math.huge),P=100000},r)
		if h then h.PlatformStand=true end
		RunService:BindToRenderStep("Fly",1,function()
			local curR=Root(); local curH=Hum(); if not S.flying or not curR or not bv then return end
			local d=curH.MoveDirection; local t=curR.CFrame:VectorToWorldSpace(d); if t.Magnitude>0 then t=t.Unit else t=curR.CFrame.LookVector end
			local u,dn=VInput(); local vv=(u and 1 or 0)-(dn and 1 or 0)
			bv.Velocity=(t+Vector3.new(0,vv,0))*S.flySpeed
			bg.CFrame=curR.CFrame
		end)
	else StopFly() end
	mobile.Visible=S.flying and UserInputService.TouchEnabled
end
