-- Utility Functions
local Util = {}

function Util.safeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("Error:", result)
    end
    return success, result
end

function Util.getPlayerTarget(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char.PrimaryPart
end

function Util.isPlayerDown(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    return plr.Character:FindFirstChild("Knocked") ~= nil or
           plr.Character:FindFirstChild("Downed") ~= nil or
           plr.Character:FindFirstChild("Dead") ~= nil
end

function Util.cleanupObject(obj)
    if typeof(obj) == "Instance" and obj.Parent then
        obj:Destroy()
    end
end

function Util.tweenTo(part, targetCFrame, speed)
    if State.stopRequested then return false end
    local distance = (targetCFrame.Position - part.Position).Magnitude
    local duration = math.max(0.1, distance / speed)
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
    State.currentTween = tween
    tween:Play()
    
    local finished = false
    local conn
    conn = tween.Completed:Connect(function()
        finished = true
        conn:Disconnect()
    end)
    
    while not finished and not State.stopRequested do
        task.wait()
    end
    
    if State.stopRequested then
        tween:Cancel()
        return false
    end
    return true
end

-- Noclip Management
local NoclipManager = {}

function NoclipManager.enable()
    if State.noclipConnection then return end
    State.noclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

function NoclipManager.disable()
    if State.noclipConnection then
        State.noclipConnection:Disconnect()
        State.noclipConnection = nil
    end
    
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = (part.Name ~= "HumanoidRootPart")
            end
        end
    end
end

function NoclipManager.update()
    if State.antiNoclipActive then
        NoclipManager.disable()
        if not State.antiNoclipConn then
            State.antiNoclipConn = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.CanCollide = true
                        end
                    end
                end
            end)
        end
        return
    end
    
    if State.antiNoclipConn then
        State.antiNoclipConn:Disconnect()
        State.antiNoclipConn = nil
    end
    
    if State.isFlying or State.isFollowing then
        NoclipManager.enable()
    else
        NoclipManager.disable()
    end
end

-- Flight System
local FlightSystem = {}

function FlightSystem.startFly(targetType, target)
    if State.isFlying or State.isFollowing then return end
    
    local getTargetCFrame
    if targetType == "Player" then
        State.selectedPlayer = target
        getTargetCFrame = function()
            local part = Util.getPlayerTarget(target)
            return part and part.CFrame
        end
    elseif targetType == "Location" then
        State.selectedLocation = target
        getTargetCFrame = function() return CFrame.new(target.pos) end
    elseif targetType == "Wall" then
        if not target or not target.part then return end
        State.selectedWall = target
        getTargetCFrame = function()
            if target.part and target.part.Parent then
                local pos = target.part.Position + Vector3.new(0, target.part.Size.Y/2 + 2.5, 0)
                return CFrame.new(pos)
            end
        end
    end
    
    local initialCFrame = getTargetCFrame()
    if not initialCFrame then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local flyHeight = tonumber(P_HeightBox.Text) or CONSTANTS.FLY_HEIGHT_DEFAULT
    local flySpeed = tonumber(P_SpeedBox.Text) or CONSTANTS.FLY_SPEED_DEFAULT
    
    State.isFlying = true
    State.stopRequested = false
    workspace.Gravity = 0
    NoclipManager.update()
    
    task.spawn(function()
        -- Step 1: Fly up
        local startPos = hrp.Position
        local skyPos = startPos + Vector3.new(0, flyHeight, 0)
        local ok = Util.tweenTo(hrp, CFrame.new(skyPos, skyPos + hrp.CFrame.LookVector), flySpeed)
        
        -- Step 2: Fly horizontally
        if ok then
            local targetCFrame = getTargetCFrame()
            if targetCFrame then
                local dest = targetCFrame.Position
                local overhead = Vector3.new(dest.X, skyPos.Y, dest.Z)
                local dir = (overhead - skyPos).Magnitude > 0.1 and (overhead - skyPos).Unit or hrp.CFrame.LookVector
                ok = Util.tweenTo(hrp, CFrame.new(overhead, overhead + dir), flySpeed)
                
                -- Step 3: Land
                if ok then
                    targetCFrame = getTargetCFrame()
                    if targetCFrame then
                        local finalCFrame = targetType == "Player" and targetCFrame * CFrame.new(0, 0, 2) or targetCFrame
                        Util.tweenTo(hrp, finalCFrame, flySpeed)
                    end
                end
            end
        end
        
        -- Reset
        workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
        State.isFlying = false
        NoclipManager.update()
        UIUpdater.updateAll()
    end)
end

function FlightSystem.stopFly()
    State.stopRequested = true
    if State.currentTween then
        State.currentTween:Cancel()
        State.currentTween = nil
    end
    State.isFlying = false
    workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
    NoclipManager.update()
end

function FlightSystem.startFollow()
    if State.isFlying then FlightSystem.stopFly() end
    if not State.selectedPlayer or not State.selectedPlayer.Character then return end
    
    State.isFollowing = true
    State.stopRequested = false
    workspace.Gravity = 0
    NoclipManager.update()
    
    task.spawn(function()
        local hasArrived = false
        
        while State.isFollowing and not State.stopRequested do
            local target = Util.getPlayerTarget(State.selectedPlayer)
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if not target or not hrp then break end
            
            local flyHeight = tonumber(P_HeightBox.Text) or CONSTANTS.FLY_HEIGHT_DEFAULT
            local flySpeed = tonumber(P_SpeedBox.Text) or CONSTANTS.FLY_SPEED_DEFAULT
            
            if not hasArrived then
                -- Initial approach
                local skyPos = hrp.Position + Vector3.new(0, flyHeight, 0)
                if not Util.tweenTo(hrp, CFrame.new(skyPos, skyPos + hrp.CFrame.LookVector), flySpeed) then break end
                
                target = Util.getPlayerTarget(State.selectedPlayer)
                if not target then break end
                
                local overhead = Vector3.new(target.Position.X, skyPos.Y, target.Position.Z)
                if not Util.tweenTo(hrp, CFrame.new(overhead, overhead + (target.Position - hrp.Position).Unit), flySpeed) then break end
                
                target = Util.getPlayerTarget(State.selectedPlayer)
                if not target then break end
                
                if not Util.tweenTo(hrp, target.CFrame * CFrame.new(0, 0, 2), flySpeed) then break end
                hasArrived = true
            else
                -- Maintain follow
                local dist = (hrp.Position - target.Position).Magnitude
                if dist > 1.5 then
                    if not Util.tweenTo(hrp, target.CFrame * CFrame.new(0, 0, 2), flySpeed) then break end
                end
            end
            
            task.wait(0.05)
        end
        
        -- Reset
        workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
        State.isFollowing = false
        NoclipManager.update()
        UIUpdater.updateAll()
    end)
end

function FlightSystem.stopFollow()
    State.isFollowing = false
    State.stopRequested = true
    if State.currentTween then
        State.currentTween:Cancel()
        State.currentTween = nil
    end
    workspace.Gravity = CONSTANTS.GRAVITY_DEFAULT
    NoclipManager.update()
end

-- ESP System
local ESP = {}

function ESP.createPlayerESP(plr)
    if State.esp.players.data[plr] then return end
    
    local bbg = Instance.new("BillboardGui")
    bbg.Name = "ESP_Player"
    bbg.Size = UDim2.new(0, 220, 0, 50)
    bbg.AlwaysOnTop = true
    bbg.ExtentsOffset = Vector3.new(0, 3, 0)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.TextStrokeTransparency = 0.5
    label.TextColor3 = THEME.SUCCESS
    label.Parent = bbg
    
    State.esp.players.data[plr] = {gui = bbg, label = label}
end

function ESP.removePlayerESP(plr)
    local data = State.esp.players.data[plr]
    if data then
        if data.gui then data.gui:Destroy() end
        State.esp.players.data[plr] = nil
    end
end

function ESP.updatePlayerESP()
    if not (State.esp.players.all or State.esp.players.single) then
        for plr in pairs(State.esp.players.data) do
            ESP.removePlayerESP(plr)
        end
        return
    end
    
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        
        local shouldShow = State.esp.players.all or 
                          (State.esp.players.single and State.selectedPlayer == plr)
        
        if shouldShow and plr.Character then
            ESP.createPlayerESP(plr)
            local data = State.esp.players.data[plr]
            if data then
                local target = Util.getPlayerTarget(plr)
                if target then
                    data.gui.Adornee = target
                    data.gui.Parent = game:GetService("CoreGui")
                    
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    local dist = myHrp and math.floor((target.Position - myHrp.Position).Magnitude) or 0
                    local hp = hum and math.floor(hum.Health) or 0
                    
                    if Util.isPlayerDown(plr) then
                        data.label.TextColor3 = THEME.DANGER
                        data.label.Text = string.format("🔴 %s [DOWN]\n⚡ HP: %d | 📏 %dm", plr.Name, hp, dist)
                    else
                        data.label.TextColor3 = THEME.SUCCESS
                        data.label.Text = string.format("👤 %s\n💚 HP: %d | 📏 %dm", plr.Name, hp, dist)
                    end
                end
            end
        else
            ESP.removePlayerESP(plr)
        end
    end
end

-- UI Builder
local UI = {}

function UI.createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

function UI.createButton(parent, text, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.BackgroundColor3 = color or THEME.TAB_INACTIVE
    btn.BackgroundTransparency = 0.3
    btn.Text = text
    btn.TextColor3 = THEME.TEXT_DARK
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 11
    btn.Parent = parent
    
    UI.createCorner(btn, 4)
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundTransparency = 0.1
    end)
    
    btn.MouseLeave:Connect(function()
        btn.BackgroundTransparency = 0.3
    end)
    
    if callback then
        btn.MouseButton1Click:Connect(callback)
    end
    
    return btn
end

function UI.createLabel(parent, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 14)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.TEXT_DARK
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

function UI.createTextBox(parent, placeholder, default)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 22)
    box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundTransparency = 0.3
    box.PlaceholderText = placeholder or ""
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
    box.Text = default or ""
    box.TextColor3 = THEME.TEXT_DARK
    box.Font = Enum.Font.SourceSans
    box.TextSize = 11
    box.Parent = parent
    
    UI.createCorner(box, 4)
    return box
end

