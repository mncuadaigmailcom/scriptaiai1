    toastToken += 1
    local id = toastToken
    Toast.Text = "  " .. msg
    ToastStroke.Color = color or Color3.fromRGB(0, 200, 120)
    Toast.Visible = true
    Toast.BackgroundTransparency = 0.15
    task.delay(2.4, function()
        if id == toastToken then
