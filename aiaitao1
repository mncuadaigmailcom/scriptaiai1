-- Hàm tạo Nút bấm phong cách Banana Cat
local function createBananaButton(text, icon, isOffBtn, order, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 38)
	btn.Text = icon .. "  " .. text
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.LayoutOrder = order
	btn.BorderSizePixel = 0
	
	if isOffBtn then
		btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
	
	btn.Parent = Container

	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 8)
	BtnCorner.Parent = btn

	local BtnStroke = Instance.new("UIStroke")
	BtnStroke.Color = isOffBtn and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 215, 0)
	BtnStroke.Thickness = 1
	BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	BtnStroke.Parent = btn

	-- Hiệu ứng bấm nút
	btn.MouseButton1Click:Connect(function()
		callback()
	end)

	return btn
end

