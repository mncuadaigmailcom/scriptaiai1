-- ESP Realtime Update
RunService.RenderStepped:Connect(function()
    local myHRP = Root()

    -- Player ESP
    if S.espAll or S.espSingle then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local track = S.espAll or (S.espSingle and selectedPlayer == plr)
                local pC = plr.Character
                if track and pC and pC:FindFirstChild("HumanoidRootPart") then
                    CreatePlayerESP(plr)
                    local data = espStorage[plr]
                    if data then
                        local tHRP = pC.HumanoidRootPart
                        local head = pC:FindFirstChild("Head") or tHRP
                        local hum  = pC:FindFirstChildOfClass("Humanoid")
                        data.BB.Adornee = head
                        local dist = myHRP and math.floor((tHRP.Position - myHRP.Position).Magnitude) or 0
                        local hp   = hum and math.floor(hum.Health) or 0
                        local mhp  = hum and math.floor(hum.MaxHealth) or 100
                        if IsDeadOrKnocked(plr) then
                            if not downedTime[plr] then downedTime[plr] = tick() end
                            local el = math.floor(tick() - downedTime[plr])
                            data.Label.TextColor3 = C.RED
                            data.Label.Text = string.format(
                                "🔴 [%s]\n⚡ GỤC (%ds) HP:%d/%d\n📏 %dm",
                                plr.DisplayName, el, hp, mhp, dist)
                        else
                            downedTime[plr] = nil
                            data.Label.TextColor3 = Color3.fromRGB(0,255,128)
                            data.Label.Text = string.format(
                                "👤 [%s]\n💚 HP:%d/%d\n📏 %dm",
                                plr.DisplayName, hp, mhp, dist)
                        end
                    end
                else
                    RemovePlayerESP(plr)
                end
            end
        end
    else
        if next(espStorage) then ClearAllPlayerESP() end
    end

    -- Location ESP
    if S.locEspAll or S.locEspSingle then
        for _, item in ipairs(savedLocations) do
            local track = S.locEspAll or (S.locEspSingle and selectedLocation == item)
            if track then
                CreateLocESP(item)
                local data = locEspStorage[item]
                if data then
                    data.Att.WorldPosition = item.pos
                    local dist = myHRP and math.floor((item.pos - myHRP.Position).Magnitude) or 0
                    data.Label.Text = string.format("📍 [%s]\n📏 %dm", item.name, dist)
                end
            else
                RemoveLocESP(item)
            end
        end
    else
        if next(locEspStorage) then ClearAllLocESP() end
    end

    -- Wall ESP
    if S.wallEspAll or S.wallEspSingle then
        for _, item in ipairs(spawnedWalls) do
            if item.part and item.part.Parent then
                local track = S.wallEspAll or (S.wallEspSingle and selectedWall == item)
                if track then
                    CreateWallESP(item)
                    local data = wallEspStorage[item]
