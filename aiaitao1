-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Variables
local mode = "OFF" -- "UP", "DOWN", "FORWARD", "OFF"
local flySpeed = 0.8 -- Tốc độ bay
local glassPlatform = nil
local noclipConnection = nil
local moveConnection = nil

----------------------------------------------------
-- HÀM LẤY CORE GUI / PLAYER GUI AN TOÀN
----------------------------------------------------
local function getGuiParent()
	local success, result = pcall(function()
		return (gethui and gethui()) or CoreGui
	end)
	if success and result then
		return result
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local ParentTarget = getGuiParent()

-- Xóa GUI cũ nếu đã tồn tại (tránh trùng lặp)
if ParentTarget:FindFirstChild("GlassNoclipGUI") then
	ParentTarget.GlassNoclipGUI:Destroy()
end

