local function SendNotify(title, text)
    task.spawn(function()
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 45)
        Card.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        Card.BorderSizePixel = 0
        Card.Parent = NotifyContainer

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 6)
        Corner.Parent = Card

        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Color3.fromRGB(0, 255, 255)
        Stroke.Thickness = 1
        Stroke.Parent = Card

        local TxtTitle = Instance.new("TextLabel")
        TxtTitle.Size = UDim2.new(1, -10, 0, 20)
        TxtTitle.Position = UDim2.new(0, 8, 0, 2)
        TxtTitle.BackgroundTransparency = 1
        TxtTitle.Text = title
        TxtTitle.TextColor3 = Color3.fromRGB(0, 255, 255)
        TxtTitle.Font = Enum.Font.GothamBold
        TxtTitle.TextSize = 12
        TxtTitle.TextXAlignment = Enum.TextXAlignment.Left
        TxtTitle.Parent = Card

        local TxtMsg = Instance.new("TextLabel")
        TxtMsg.Size = UDim2.new(1, -10, 0, 20)
        TxtMsg.Position = UDim2.new(0, 8, 0, 20)
        TxtMsg.BackgroundTransparency = 1
        TxtMsg.Text = text
        TxtMsg.TextColor3 = Color3.fromRGB(220, 220, 220)
        TxtMsg.Font = Enum.Font.Gotham
        TxtMsg.TextSize = 11
        TxtMsg.TextXAlignment = Enum.TextXAlignment.Left
        TxtMsg.Parent = Card

        task.wait(3)
        TweenService:Create(Card, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(TxtTitle, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        TweenService:Create(TxtMsg, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
        task.wait(0.5)
        Card:Destroy()
    end)
end

