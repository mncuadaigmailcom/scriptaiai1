repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer

-- Xác định vị trí lưu GUI an toàn cho mọi Executor (PC & Mobile)
local ParentContainer = (gethui and gethui()) or game:GetService("CoreGui") or player:WaitForChild("PlayerGui")

------------------------------------------------------------
-- 🌌 1. INTRO GUI (Chạy song song, không kẹt Menu)
------------------------------------------------------------
task.spawn(function()
    local introGui = Instance.new("ScreenGui")
    introGui.Name = "GraiIntro"
    introGui.IgnoreGuiInset = true
    introGui.ResetOnSpawn = false
    introGui.Parent = ParentContainer

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
    bg.BackgroundTransparency = 0.3
    bg.Parent = introGui

    local logo = Instance.new("ImageLabel")
    logo.Parent = introGui
    logo.AnchorPoint = Vector2.new(0.5,0.5)
    logo.Position = UDim2.new(0.5,0,0.5,0)
    logo.Size = UDim2.new(0,0,0,0)
    logo.BackgroundTransparency = 1
    logo.Image = "http://www.roblox.com/asset/?id=77111304194141"
    logo.ImageTransparency = 1

    -- Phóng to Logo
    TweenService:Create(logo, TweenInfo.new(1.2, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 180, 0, 180),
        ImageTransparency = 0
    }):Play()

    -- Xoay Logo
    task.spawn(function()
        while logo and logo.Parent do
            logo.Rotation = logo.Rotation + 1
            task.wait(0.01)
        end
    end)

    -- Chữ Tiêu Đề
    local msg = Instance.new("TextLabel")
    msg.Parent = introGui
    msg.AnchorPoint = Vector2.new(0.5, 0)
    msg.Position = UDim2.new(0.5, 0, 0.72, 0)
    msg.Size = UDim2.new(0, 500, 0, 60)
    msg.BackgroundTransparency = 1
    msg.Text = "Grai Hub"
    msg.TextColor3 = Color3.fromRGB(0, 255, 255)
    msg.Font = Enum.Font.GothamBlack
    msg.TextScaled = true
    msg.TextStrokeTransparency = 0
    msg.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    msg.TextTransparency = 1

    TweenService:Create(msg, TweenInfo.new(1), {TextTransparency = 0}):Play()

    task.wait(2.5)

    -- Biến mất Intro
    TweenService:Create(logo, TweenInfo.new(0.8), {ImageTransparency = 1}):Play()
    TweenService:Create(msg, TweenInfo.new(0.8), {TextTransparency = 1}):Play()
    TweenService:Create(bg, TweenInfo.new(0.8), {BackgroundTransparency = 1}):Play()
    task.wait(0.8)

    introGui:Destroy()
end)

