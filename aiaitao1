-- 3. HỆ THỐNG THÔNG BÁO (NOTIFICATION)
local function SendNotify(title, text)
    task.spawn(function()
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(0, 220, 0, 45)
        Card.Position = UDim2.new(1, -230, 0.85, 0)
        Card.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        Card.BorderSizePixel = 0
        Card.Parent = MainGui

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 8)
        Corner.Parent = Card

        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Color3.fromRGB(255, 215, 0)
        Stroke.Thickness = 1
        Stroke.Parent = Card

        local TxtTitle = Instance.new("TextLabel")
        TxtTitle.Size = UDim2.new(1, -10, 0, 20)
        TxtTitle.Position = UDim2.new(0, 8, 0, 3)
        TxtTitle.BackgroundTransparency = 1
        TxtTitle.Text = title
        TxtTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
        TxtTitle.Font = Enum.Font.GothamBold
        TxtTitle.TextSize = 12
        TxtTitle.TextXAlignment = Enum.TextXAlignment.Left
        TxtTitle.Parent = Card

        local TxtMsg = Instance.new("TextLabel")
        TxtMsg.Size = UDim2.new(1, -10, 0, 20)
        TxtMsg.Position = UDim2.new(0, 8, 0, 20)
        TxtMsg.BackgroundTransparency = 1
        TxtMsg.Text = text
        TxtMsg.TextColor3 = Color3.fromRGB(220, 220, 220)
        TxtMsg.Font = Enum.Font.Gotham
        TxtMsg.TextSize = 11
        TxtMsg.TextXAlignment = Enum.TextXAlignment.Left
        TxtMsg.Parent = Card

        task.wait(3)
        Card:Destroy()
    end)
end

