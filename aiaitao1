local ESP = {}

function ESP.createPlayerESP(plr)
    if State.espPlayers.cache[plr] then return end
    
    local bbg = Instance.new("BillboardGui")
    bbg.Name = "ESP_Player_" .. plr.Name
    bbg.Size = UDim2.new(0, 220, 0, 50)
    bbg.AlwaysOnTop = true
    bbg.ExtentsOffset = Vector3.new(0, 3, 0)
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.TextStrokeTransparency = 0.5
    label.TextColor3 = Color3.fromRGB(0, 255, 128)
    label.Parent = bbg
    
    State.espPlayers.cache[plr] = {gui = bbg, label = label}
end

function ESP.removePlayerESP(plr)
    local data = State.espPlayers.cache[plr]
    if data then
        if data.gui then data.gui:Destroy() end
        State.espPlayers.cache[plr] = nil
    end
end

function ESP.removeAllPlayerESP()
    for plr in pairs(State.espPlayers.cache) do
        ESP.removePlayerESP(plr)
    end
    State.espPlayers.cache = {}
end

function ESP.updatePlayerESP()
    local showAll = State.espPlayers.all
    local showSingle = State.espPlayers.single
    
    if not showAll and not showSingle then
        if next(State.espPlayers.cache) ~= nil then
            ESP.removeAllPlayerESP()
        end
        return
    end
    
    local myHrp = Util.getRoot()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        
        local shouldShow = showAll or (showSingle and State.selectedPlayer == plr)
        
        if shouldShow and plr.Character then
            ESP.createPlayerESP(plr)
            local data = State.espPlayers.cache[plr]
            if data then
                local target = Util.getTargetPart(plr)
                if target then
                    data.gui.Adornee = target
                    data.gui.Parent = CoreGui
                    
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    local dist = myHrp and math.floor((target.Position - myHrp.Position).Magnitude) or 0
                    local hp = hum and math.floor(hum.Health) or 0
                    
                    if Util.isPlayerDown(plr) then
                        data.label.TextColor3 = Color3.fromRGB(230, 30, 30)
                        data.label.Text = string.format("🔴 %s [DOWN]\n❤️ %d | 📏 %dm", plr.Name, hp, dist)
                    else
                        data.label.TextColor3 = Color3.fromRGB(0, 255, 128)
                        data.label.Text = string.format("👤 %s\n💚 %d | 📏 %dm", plr.Name, hp, dist)
                    end
                end
            end
        else
            ESP.removePlayerESP(plr)
        end
    end
end

