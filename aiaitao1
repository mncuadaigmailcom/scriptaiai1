-- Hàm tạo Nút Script
local function AddScriptButton(name, desc, scriptUrl)
    local BtnFrame = Instance.new("Frame")
    BtnFrame.Size = UDim2.new(1, 0, 0, 55)
    BtnFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    BtnFrame.BorderSizePixel = 0
    BtnFrame.Parent = Container

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = BtnFrame

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(45, 45, 58)
    BtnStroke.Thickness = 1
    BtnStroke.Parent = BtnFrame

    local TxtName = Instance.new("TextLabel")
    TxtName.Size = UDim2.new(1, -110, 0, 25)
    TxtName.Position = UDim2.new(0, 12, 0, 5)
    TxtName.BackgroundTransparency = 1
    TxtName.Text = "⚡ " .. name
    TxtName.TextColor3 = Color3.fromRGB(255, 255, 255)
    TxtName.Font = Enum.Font.GothamBold
    TxtName.TextSize = 13
    TxtName.TextXAlignment = Enum.TextXAlignment.Left
    TxtName.Parent = BtnFrame

    local TxtDesc = Instance.new("TextLabel")
    TxtDesc.Size = UDim2.new(1, -110, 0, 20)
    TxtDesc.Position = UDim2.new(0, 12, 0, 28)
    TxtDesc.BackgroundTransparency = 1
    TxtDesc.Text = desc
    TxtDesc.TextColor3 = Color3.fromRGB(150, 150, 160)
    TxtDesc.Font = Enum.Font.Gotham
    TxtDesc.TextSize = 10
    TxtDesc.TextXAlignment = Enum.TextXAlignment.Left
    TxtDesc.Parent = BtnFrame

    local RunBtn = Instance.new("TextButton")
    RunBtn.Size = UDim2.new(0, 85, 0, 35)
    RunBtn.Position = UDim2.new(1, -95, 0.5, -17)
    RunBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    RunBtn.Text = "CHẠY"
    RunBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    RunBtn.Font = Enum.Font.GothamBold
    RunBtn.TextSize = 12
    RunBtn.Parent = BtnFrame

    local RunCorner = Instance.new("UICorner")
    RunCorner.CornerRadius = UDim.new(0, 6)
    RunCorner.Parent = RunBtn

    RunBtn.MouseButton1Click:Connect(function()
        SendNotify("Grai Hub", "Đang nạp " .. name .. "...")
        pcall(function()
            loadstring(game:HttpGet(scriptUrl))()
        end)
    end)
end

