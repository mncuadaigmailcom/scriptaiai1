-- ==================== UTILITY FUNCTIONS ====================
local Util = {}

function Util.debounce(key)
    local now = tick()
    if State.lastClick[key] and now - State.lastClick[key] < CONSTANTS.DEBOUNCE_TIME then
        return false
    end
    State.lastClick[key] = now
    return true
end

function Util.getPlayerTarget(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("HumanoidRootPart") or 
           char:FindFirstChild("Head") or 
           char.PrimaryPart
end

function Util.getLocalRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.getLocalHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.isPlayerDown(plr)
    if not plr or not plr.Character then return true end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    return plr.Character:FindFirstChild("Knocked") ~= nil or
           plr.Character:FindFirstChild("Downed") ~= nil or
           plr.Character:FindFirstChild("Dead") ~= nil
end

function Util.cleanupObject(obj)
    if obj and obj.Parent then
        pcall(function() obj:Destroy() end)
    end
end

function Util.tweenTo(part, targetCFrame, speed)
    if State.stopRequested then return false end
    
    -- Hủy tween cũ
    if State.currentTween then
        pcall(function() State.currentTween:Cancel() end)
        State.currentTween = nil
    end
    
    local distance = (targetCFrame.Position - part.Position).Magnitude
    if distance < 0.1 then return true end
    
    local duration = math.max(0.1, distance / speed)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    
    State.currentTween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
    State.currentTween:Play()
    
    local finished = false
    local conn
    conn = State.currentTween.Completed:Connect(function()
        finished = true
        conn:Disconnect()
    end)
    
    while not finished and not State.stopRequested do
        task.wait()
    end
    
    if State.stopRequested then
        pcall(function() State.currentTween:Cancel() end)
        State.currentTween = nil
        return false
    end
    
    State.currentTween = nil
    return true
end

function Util.updateChar()
    local h = Util.getLocalHumanoid()
    if h then
        h.WalkSpeed = State.walkSpeed
        h.JumpPower = State.jumpPower
    end
end

