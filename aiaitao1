-- 6. HỆ THỐNG BU NGƯỜI (DYNAMIC MAGNET LOCK)
---------------------------------------------------------
local function stopFollow()
    isFollowing = false
    if followLoopConn then followLoopConn:Disconnect() followLoopConn = nil end
    
    workspace.Gravity = 196.2
    setNoclip(false)
    
    FollowBtn.Text = "🧲 BU NGƯỜI (MAGNET): OFF"
    FollowBtn.BackgroundColor3 = Color3.fromRGB(40, 45, 60)
end

local function startFollow()
    if isFollowing then stopFollow() return end
    if not selectedPlayer then return end

    if isFlying then stopFly() end

    isFollowing = true
    FollowBtn.Text = "🧲 BU NGƯỜI (MAGNET): ON"
    FollowBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)

    setNoclip(true)
    workspace.Gravity = 0

    followLoopConn = RunService.Heartbeat:Connect(function(dt)
        if not isFollowing or not selectedPlayer or not selectedPlayer.Character then
            stopFollow()
            return
        end

        local myHRP = getHRP(LocalPlayer)
        local targetHRP = getHRP(selectedPlayer)

        if myHRP and targetHRP then
            myHRP.AssemblyLinearVelocity = Vector3.zero
            local spd = tonumber(SpeedBox.Text) or 150
            local targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, 2)
            
            local currentPos = myHRP.Position
            local destPos = targetCFrame.Position
            local dist = (destPos - currentPos).Magnitude

            if dist > 1.5 then
                local moveDir = (destPos - currentPos).Unit
                myHRP.CFrame = CFrame.new(currentPos + moveDir * math.min(dist, spd * dt), targetHRP.Position)
            else
                myHRP.CFrame = targetCFrame
            end
        else
            stopFollow()
        end
    end)
end

