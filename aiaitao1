    main.BackgroundTransparency = 0.08
    main.BorderSizePixel = 0
    main.Parent = gui
    UI.createCorner(main, 10)
    
    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -120, 0, 34)
    title.BackgroundColor3 = THEME.TITLE_BG
    title.BackgroundTransparency = 0.4
    title.Text = "🍌 BANANA FLY"
    title.TextColor3 = THEME.TEXT_DARK
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main
    UI.createCorner(title, 10)
    
    -- Close button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 24)
    closeBtn.Position = UDim2.new(1, -32, 0, 5)
    closeBtn.BackgroundColor3 = THEME.DANGER
    closeBtn.BackgroundTransparency = 0.2
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = THEME.TEXT_LIGHT
    closeBtn.Font = Enum.Font.SourceSansBold
    closeBtn.TextSize = 14
    closeBtn.Parent = main
    UI.createCorner(closeBtn, 4)
    
    closeBtn.MouseButton1Click:Connect(function()
        -- Cleanup
        FlightSystem.stopFly()
        FlightSystem.stopFollow()
        State.antiNoclipActive = false
        NoclipManager.update()
        
        -- Remove all ESP
        for plr in pairs(State.esp.players.data) do
            ESP.removePlayerESP(plr)
        end
        
        -- Remove all walls
        for _, wall in ipairs(State.spawnedWalls) do
            if wall.part then wall.part:Destroy() end
        end
        
        Util.cleanupObject(State.glowLight)
        Util.cleanupObject(State.heightPillar)
        Util.cleanupObject(gui)
    end)
    
    return gui, main
end

